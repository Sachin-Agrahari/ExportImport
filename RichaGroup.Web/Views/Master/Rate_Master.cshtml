@{
    ViewData["Title"] = "Customs Currency Master";
    ViewData["Heading"] = "Customs Currency Master";
}
 
<div class="bd_mainContainer">
    <div class="page">
 
        <section class="card">
            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">
                        Customs Currency Master
                    </h2>
                </div>

               
                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                    <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button>
                     
                </div>
            </div>
            <div class="card-body  d-flex justify-content-between align-items-center">
                <div class="grid cols-6">
                    <div class="field">
                        <label>Currency</label>
                        <select id="ddlCurrRate_Master" class="select2-field">
                            <option value="FOB" selected>FOB</option>
                            <option value="Euro">Euro</option>
                            <option value="US$">US$</option>
                            <option value="UKoe">UKoe</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>From Date</label>
                        <input type="text" id="txtfrom_RateMaster" placeholder="Select date..." />
                    </div>               
                    <div class="field">
                        <label>To Date</label>
                        <input type="text" class="num" id="txtTo_RateMaster" placeholder="Select date..." />
                    </div>
                     
                   
                </div>
                
            </div>
        </section>


        <section class="card">
            <!-- HEADER -->
            <div class="card-head">

                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Customs Currency Master</h2>
                </div>

                <div class="d-flex gap-2">
                    <div class="d-flex gap-2">
                        @await Html.PartialAsync("Components/_UploadAndViewButtons")
                        <button class="btn btn-primary btn-sm"
                                id="btnAdd">
                            ＋ Add
                        </button>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="table-wrap">
                    <table id="tblRateMaster" class="display" style="width:100%">
                        <thead>
                            <tr>
                                <th class="c">Currency</th>
                               
                                <th>From Date</th>
                                <th>To Date</th>
                                <th>Rate</th>
                            </tr>
                        </thead>
                        <tbody id="tblbodyRT_Master"></tbody>
                    </table>
                </div>
            </div>
        </section>

    </div>
</div>

<script src="~/js/pages/mastersjs/rate_master.js" asp-append-version="true"></script>
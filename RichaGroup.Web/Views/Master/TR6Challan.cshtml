@{
	ViewData["Title"] = "TR6 Challan";
}
<div class="bd_mainContainer">
    <div class="page">

        <section class="card">

            <!-- HEADER -->
            <div class="card-head">

                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">List of TR6 Challans</h2>
                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
					<div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm"
                                id="btnAdd">
                            ＋ Add
                        </button>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="table-wrap" style="max-height:790px;">

                    <table id="tblTR6Challan"
                           class="display"
                           style="width:100%">

                        <thead>
                            <tr>
                                <th style="width:50px !important;">Action</th>
                                <th style="width:50px !important; text-align:right !important;">S.No</th>
                                <th>TR6 Challan No.</th>
                                <th>Date</th>
                                <th>Surrender Type</th>
                                <th style="text-align:right !important;">TR6 Challan Amount</th>
                                <th style="text-align:right !important;">Interest Amount</th>
                                <th>Port</th>
                                <th>ROSCTL License No</th>
                                <th>Licence Date</th>
                           
                            </tr>
                        </thead>

                        <tbody id="tblbodyTR6Challan"
                               class="text-truncate">
                        </tbody>

                    </table>

                </div>

            </div>

        </section>
    </div>
</div>



<!-- ================================
     Add Menu Modal
================================ -->

<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        List of TR6 Challans
                    </div>
                </div>

                <div class="app-modal-header-actions">

                    <button type="button"
                            style="    margin-top: 12px;"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
             @await Html.PartialAsync("_viewTR6Challan")
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

            </div>
        </div>
    </div>
</div>




<script src="~/js/pages/mastersjs/tr6challan.js" asp-append-version="true"></script>

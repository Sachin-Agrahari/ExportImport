@{
    ViewData["Title"] = "Rosctl Master";
    ViewData["Heading"] = "Rosctl Detail Master";
}
<div class="bd_mainContainer">
    <div class="page">
     
        <!-- Bond entries -->
        <section class="card">


            <!-- HEADER -->
            <div class="card-head">
                 <div>
                     <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Rosctl Master</h2>
                 </div>

                <div class="d-flex gap-2">
                    <div class="d-flex gap-2">
                        @await Html.PartialAsync("Components/_CheckBoxComponent")
                        @await Html.PartialAsync("Components/_UploadAndViewButtons")
                        <button class="btn btn-primary btn-sm"
                                id="btnAdd">
                            ＋ Add
                        </button>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="table-wrap">
                    <table id="tblRosctlMaster" class="display" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:50px !important; text-align:right !important;">Action</th>
                                <th>ROSCTL_CODE</th>
                                <th>ROSCTLSERIAL_NO</th>
                                <th>ROSCTL_FROM_DATE</th>
                                <th>ROSCTL_TO_DATE</th>
                                <th>DRAWBACK_ITEM_DESCRIPTION</th>
                                <th>STATE_UNIT_OF_MEASURMENT</th>
                                <th>STATE_PERCENTAGE</th>
                                <th>STATE_PER_PIECE_CAPPING</th>
                                <th>STATE_UNIT_OF_MEASURMENT_SPL_ADV_LIC</th>
                                <th>STATE_PERCENTAGE_SPL_ADV_LIC</th>
                                <th>CENTER_UNIT_OF_MEASURMENT</th>
                                <th>CENTER_PERCENTAGE</th>
                                <th>CENTER_PER_PIECE_CAPPING</th>
                                <th>CENTER_UNIT_OF_MEASURMENT_SPL_ADV_LIC</th>
                                <th>CENTER_PERCENTAGE_SPL_ADV_LIC</th>

                                @* <th>Unit_S</th>
                                <th style="text-align:right !important;">Rt_Pc_C</th>
                                <th style="text-align:right !important;">Capunit_S</th>
                                <th>Unit_C</th>
                                <th style="text-align:right !important;">Rt_Pc_S</th>
                                <th style="text-align:right !important;">Capunit_C</th>
                                <th>Unit_Ac</th>
                                <th style="text-align:right !important;">Rt_Pc_Ac</th>
                                <th>Unit_As</th>
                                <th style="text-align:right !important;">Rt_Pc_As</th>
                                <th>Rsctl_Fm</th>
                                <th>Rsctl_To</th> *@
                               
                            </tr>
                        </thead>
                        <tbody id="tblbodyRosctlMaster"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>






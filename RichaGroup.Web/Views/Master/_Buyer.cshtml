 
<div class="grid cols-4 p-2">

    <!-- Left Column -->

    <div class="field">
        <label for="txtBuyerName" class="form-label">
          
            Buyer Name
            <span class="text-danger">*</span>
        </label>
        <input type="text"
               id="txtBuyerName"
               class="form-control"
               placeholder="Enter Buyer Name" />
    </div>

    <div class="field">
        <label for="ddlBuyingHouse" class="form-label">
            Buying House Name
        </label>
        <select class="form-select" id="ddlBuyingHouse">
            <option value="">Select Buying House</option>
        </select>
    </div>

    <div class="field">
        <label for="txtAliasName" class="form-label">
           
            Alias Name
            <span class="text-danger">*</span>
        </label>
        <input type="text"
               id="txtAliasName"
               class="form-control"
               placeholder="Enter Alias Name" />
    </div>

    <div class="field">
        <label for="txtAddress2" class="form-label">
            Address 2
        </label>
        <input type="text"
               id="txtAddress2"
               class="form-control"
               placeholder="Enter Address 2" />
    </div>

    <div class="field">
        <label for="txtAddress1" class="form-label">
       
            Address 1
            <span class="text-danger">*</span>
        </label>
        <input type="text"
               id="txtAddress1"
               class="form-control"
               placeholder="Enter Address 1" />
    </div>

    <div class="field">
        <label for="txtAddress4" class="form-label">
            Address 4
        </label>
        <input type="text"
               id="txtAddress4"
               class="form-control"
               placeholder="Enter Address 4" />
    </div>

    <div class="field">
        <label for="txtAddress3" class="form-label">
            Address 3
        </label>
        <input type="text"
               id="txtAddress3"
               class="form-control"
               placeholder="Enter Address 3" />
    </div>

    <div class="field">
        <label for="txtState" class="form-label">
          
            State
            <span class="text-danger">*</span>
        </label>
        <input type="text"
               id="txtState"
               class="form-control"
               placeholder="Enter State" />
    </div>

    <div class="field">
        <label for="txtCity" class="form-label">
            
            City

            <span class="text-danger">*</span>
        </label>
        <input type="text"
               id="txtCity"
               class="form-control"
               placeholder="Enter City" />
    </div>

    <div class="field">
        <label for="txtPinCode" class="form-label">
            Pin Code
        </label>
        <input type="text"
               id="txtPinCode"
               class="form-control"
               placeholder="Enter Pin Code" />
    </div>

    <div class="field">
        <label for="ddlCountry" class="form-label">
          
            Country
            <span class="text-danger">*</span>
        </label>
        <select class="form-select" id="ddlCountry">
            <option value="">Select Country</option>
            <option value="AUSTRALIA">AUSTRALIA</option>
            <option value="INDIA">INDIA</option>
        </select>
    </div>

    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>
        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>
        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>
        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>
        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>
     
    <div class="field">
        <label for="txtEmail" class="form-label">
         
            Email
            <span class="text-danger">*</span>
        </label>
        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <div class="field">
        <label for="txtPaymentDays" class="form-label">
            Payment Days
        </label>
        <input type="number"
               id="txtPaymentDays"
               class="form-control"
               value="0.00"
               step="0.01" />
    </div>

    <div class="field">
        <label for="txtBOEPaymentDays" class="form-label">
            BOE Payment Days
        </label>
        <input type="number"
               id="txtBOEPaymentDays"
               class="form-control"
               value="0.00"
               step="0.01" />
    </div>

    <div class="field" style="width:207%">
        <label for="txtOtherInformation" class="form-label">
            Other Information
        </label>
        <textarea id="txtOtherInformation"
                  class="form-control textAria"
                  placeholder="Enter Other Information"></textarea>
    </div>

</div>
 

<script src="~/js/pages/MastersJs/Buyer_Master.js" asp-append-version="true"></script>
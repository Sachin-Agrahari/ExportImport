 <div class="grid cols-4 p-2">

    <!-- Buyer Name -->
    <div class="field">
        <label for="ddlBuyerName" class="form-label">
           
            Buyer Name
            <span class="text-danger">*</span>
        </label>

        <select id="ddlBuyerName"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="Akshay">Akshay</option>
            <option value="Anil">Anil</option>
            <option value="Anil Thakur">Anil Thakur</option>
            <option value="Manoj Rawat">Manoj Rawat</option>
            <option value="Vaibhav Rana">Vaibhav Rana</option>
        </select>
    </div>

    <!-- Payment Days -->
    <div class="field">
        <label for="txtPaymentDays" class="form-label">
            Payment Days
        </label>

        <input type="number"
               id="txtPaymentDays"
               class="form-control"
               value="0.00"
               step="0.01" />
    </div>

    <!-- Consignee Name -->
    <div class="field">
        <label for="txtConsigneeName" class="form-label">
          
            Consignee Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtConsigneeName"
               class="form-control"
               placeholder="Enter Consignee Name" />
    </div>

    <!-- Currency -->
    <div class="field">
        <label for="ddlCurrency" class="form-label">
           
            Currency
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCurrency"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="USD">USD</option>
            <option value="EUR">EUR</option>
            <option value="INR">INR</option>
            <option value="GBP">GBP</option>
        </select>
    </div>

    <!-- Address 1 -->
    <div class="field">
        <label for="txtAddress1" class="form-label">
            Address 1
        </label>

        <input type="text"
               id="txtAddress1"
               class="form-control"
               placeholder="Enter Address 1" />
    </div>

    <!-- Buying House Name -->
    <div class="field">
        <label for="ddlBuyingHouse" class="form-label">
            Buying House Name
        </label>

        <select id="ddlBuyingHouse"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="Richa">Richa</option>
            <option value="Arvind">Arvind</option>
            <option value="Shahi">Shahi</option>
            <option value="Pearl">Pearl</option>
        </select>
    </div>

    <!-- Address 3 -->
    <div class="field">
        <label for="txtAddress3" class="form-label">
            Address 3
        </label>

        <input type="text"
               id="txtAddress3"
               class="form-control"
               placeholder="Enter Address 3" />
    </div>

    <!-- Address 2 -->
    <div class="field">
        <label for="txtAddress2" class="form-label">
            Address 2
        </label>

        <input type="text"
               id="txtAddress2"
               class="form-control"
               placeholder="Enter Address 2" />
    </div>

    <!-- City -->
    <div class="field">
        <label for="txtCity" class="form-label">
            City
        </label>

        <input type="text"
               id="txtCity"
               class="form-control"
               placeholder="Enter City" />
    </div>

    <!-- Address 4 -->
    <div class="field">
        <label for="txtAddress4" class="form-label">
            Address 4
        </label>

        <input type="text"
               id="txtAddress4"
               class="form-control"
               placeholder="Enter Address 4" />
    </div>

    <!-- Country -->
    <div class="field">
        <label for="ddlCountry" class="form-label">
           
            Country
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountry"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="INDIA">INDIA</option>
            <option value="BANGLADESH">BANGLADESH</option>
            <option value="AUSTRALIA">AUSTRALIA</option>
        </select>
    </div>

    <!-- State -->
    <div class="field">
        <label for="txtState" class="form-label">
            State
        </label>

        <input type="text"
               id="txtState"
               class="form-control"
               placeholder="Enter State" />
    </div>

    <!-- GST No -->
    <div class="field">
        <label for="txtGSTNo" class="form-label">
            GST NO
        </label>

        <input type="text"
               id="txtGSTNo"
               class="form-control"
               placeholder="Enter GST No" />
    </div>

    <!-- Pin Code -->
    <div class="field">
        <label for="txtPinCode" class="form-label">
            Pin Code
        </label>

        <input type="text"
               id="txtPinCode"
               class="form-control"
               placeholder="Enter Pin Code" />
    </div>

    <!-- Contact 1 -->
    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>

        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <!-- Contact 2 -->
    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>

        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <!-- Telephone -->
    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>

        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>

    <!-- Fax -->
    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>

        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

    <!-- Email -->
    <div class="field">
        <label for="txtEmail" class="form-label">
        
            Email
            <span class="text-danger">*</span>
        </label>

        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <!-- Port of Destination -->
    <div class="field">
        <label for="ddlPortOfDestination" class="form-label">
        
            Port Of Destination
            <span class="text-danger">*</span>
        </label>

        <select id="ddlPortOfDestination"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="Ber">Ber</option>
            <option value="Delhi Port">Delhi Port</option>
            <option value="Mumbai Port">Mumbai Port</option>
            <option value="Chennai Port">Chennai Port</option>
        </select>
    </div>

    <!-- Other Information -->
    <div class="field">
        <label for="txtOtherInformation" class="form-label">
            Other Information
        </label>

        <textarea id="txtOtherInformation"
                  class="form-control textAria"
                  placeholder="Enter Other Information"></textarea>
    </div>

    <!-- Display Status -->
    <div class="field">
        <div class="form-check mt-4">
            <input type="checkbox"
                   class="form-check-input"
                   id="chkDisplayStatus"
                   checked />

            <label class="form-check-label"
                   for="chkDisplayStatus">
                Display Status
            </label>
        </div>
    </div>

</div>
 
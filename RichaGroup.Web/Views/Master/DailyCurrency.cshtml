@{
	ViewData["Title"] = "Currency Rate Master";
	ViewData["Heading"] = "Currency Rate Master";
}

<link href="~/css/pages/masternew/dailycurrency.css" rel="stylesheet" asp-append-version="true" />

<div class="bd_mainContainer">
	<div class="page">
		<section class="card daily-currency-card">

			<div class="card-head">

				<div class="currency-header-content">

					<div class="currency-title">
						<span class="tick"></span>

						<h2 class="mt-2" id="txtHeaderMain">
							 Currency Rate Master
						</h2>
					</div>

					<div class="screen-switch" role="tablist">

						<button type="button"
								class="on parent-tab"
								data-view="customs">
							Customs
						</button>

						<button type="button"
								class="parent-tab"
								data-view="exports">
							Exports
						</button>

						<button type="button"
								class="parent-tab"
								data-view="imports">
							Imports
						</button>

					</div>

				</div>

				<div class="d-flex gap-2">
					@await Html.PartialAsync("Components/_CheckBoxComponent")
					@await Html.PartialAsync("Components/_UploadAndViewButtons")

					<button type="button"
							class="btn btn-primary btn-sm"
							id="btnSave">

						Save

					</button>

					<button type="button"
							class="btn btn-cancel-custom"
							id="btnCancel">

						✕ Cancel

					</button>

				</div>

			</div>


			<div class="card-body">
				
				<!-- SUB TABS -->
				<div class="currency-sub-tabs">

					<button type="button"
							class="currency-sub-tab active"
							data-period="daily">
						<span class="tab-icon">📅</span>
						Daily
					</button>

					<button type="button"
							class="currency-sub-tab"
							data-period="weekly">
						<span class="tab-icon">▦</span>
						Weekly
					</button>

					<button type="button"
							class="currency-sub-tab"
							data-period="fortnightly">
						<span class="tab-icon">↔</span>
						Fortnightly
					</button>

					<button type="button"
							class="currency-sub-tab"
							data-period="monthly">
						<span class="tab-icon">▤</span>
						Monthly
					</button>

				</div>


				<!-- FILTER AREA -->

				<div id="currencyFilterArea"
					 class="currency-filter-area">

					<!-- Daily -->
					<div id="dailyFilter"
						 class="period-filter">

						<div class="daily-currency-date">

							<label for="txtDate"
								   class="form-label">

								Date
								<span class="required">*</span>

							</label>

							<input type="text"
								   id="txtDate"
								   class=" form-Flatdate form-control" />

						</div>

					</div>


					<!-- Weekly -->
					<div id="weeklyFilter"
						 class="period-filter d-none">

						<div>

							<label class="form-label">
								Year
							</label>

							<select id="weeklyYear"
									class="form-select">
							</select>

						</div>

					</div>


					<!-- Fortnightly -->
					<div id="fortnightlyFilter"
						 class="period-filter d-none">

						<div>

							<label class="form-label">
								Year
							</label>

							<select id="fortnightlyYear"
									class="form-select">
							</select>

						</div>

						<div>

							<label class="form-label">
								Month
							</label>

							<select id="fortnightlyMonth"
									class="form-select">

								<option value="1">January</option>
								<option value="2">February</option>
								<option value="3">March</option>
								<option value="4">April</option>
								<option value="5">May</option>
								<option value="6">June</option>
								<option value="7">July</option>
								<option value="8">August</option>
								<option value="9">September</option>
								<option value="10">October</option>
								<option value="11">November</option>
								<option value="12">December</option>

							</select>

						</div>

					</div>


					<!-- Monthly -->
					<div id="monthlyFilter"
						 class="period-filter d-none">

						<div>

							<label class="form-label">
								Year
							</label>

							<select id="monthlyYear"
									class="form-select">
							</select>

						</div>

					</div>

				</div>


				<!-- TABLE -->

				<div class="table-responsive daily-currency-table-wrapper">

					<table class="table table-bordered daily-currency-table"
						   id="tblDailyCurrency">

						<thead>
							<tr id="currencyTableHeader">

								<!-- JS will generate -->

							</tr>
						</thead>

						<tbody id="tblDailyCurrencyBody">

							<!-- JS will generate -->

						</tbody>

					</table>

				</div>

			</div>

		</section>

	</div>
</div>

<script src="~/js/pages/MastersJs/DailyCurrency.js" asp-append-version="true"></script>
  
<div class="bd_mainContainer">
    <div class="page"> 
        <section class="" style="margin-top: 8px;"> 
            <div class="" style="padding:3px;"> 
                <div class="grid cols-4"> 
                    <div class="field"> 
                        <label for="ddlSurrenderType" class="form-label">
                            
                            Surrender Type
                            <span class="text-danger">*</span>
                        </label>

                        <select id="ddlSurrenderType"
                                class="form-select">

                            <option value="">--Choose One--</option>
                            <option value="GST">GST</option>
                            <option value="Other">Other</option>

                        </select>

                    </div>


                    <!-- TR6 Challan No -->
                    <div class="field">

                        <label for="txtTR6ChallanNo" class="form-label">
                           
                            TR6 Challan No
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="txtTR6ChallanNo"
                               class="form-control"
                               placeholder="Enter TR6 Challan No" />

                    </div>


                    <!-- Date -->
                    <div class="field">

                        <label for="txtTR6Date" class="form-label">
                         
                            Date
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="txtTR6Date"
                               class="form-control form-Flatdate "
                               placeholder="Select Date" />

                    </div>


                    <!-- Port -->
                    <div class="field">

                        <label for="ddlPort" class="form-label">
                         
                            Port
                            <span class="text-danger">*</span>
                        </label>

                        <select id="ddlPort"
                                class="form-select">

                            <option value="">--Choose One--</option>
                            <option value="China-333">China-333</option>
                            <option value="Delhi">Delhi</option>
                            <option value="Mumbai">Mumbai</option>

                        </select>

                    </div>


                    <!-- TR6 Challan Amount -->
                    <div class="field">

                        <label for="txtTR6ChallanAmount" class="form-label">
                            TR6 Challan Amount
                        </label>

                        <input type="text"
                               id="txtTR6ChallanAmount"
                               class="form-control"
                               placeholder="Enter TR6 Challan Amount" />

                    </div>


                    <!-- Surrender Amount -->
                    <div class="field">

                        <label for="txtSurrenderAmount" class="form-label">
                            Surrender Amount
                        </label>

                        <input type="text"
                               id="txtSurrenderAmount"
                               class="form-control"
                               placeholder="Enter Surrender Amount" />

                    </div>


                    <!-- Interest Amount -->
                    <div class="field">

                        <label for="txtInterestAmount" class="form-label">
                            Interest Amount
                        </label>

                        <input type="text"
                               id="txtInterestAmount"
                               class="form-control"
                               placeholder="Enter Interest Amount" />

                    </div>


                    <!-- Bank -->
                    <div class="field">

                        <label for="ddlBank" class="form-label">
                            Bank
                        </label>

                        <select id="ddlBank"
                                class="form-select">

                            <option value="">--Choose One--</option>
                            <option value="AXIS">AXIS</option>
                            <option value="SBI">SBI</option>
                            <option value="HDFC">HDFC</option>

                        </select>

                    </div>


                    <!-- DD / Cheque No -->
                    <div class="field">

                        <label for="txtDDChequeNo" class="form-label">
                            DD / Cheque No
                        </label>

                        <input type="text"
                               id="txtDDChequeNo"
                               class="form-control"
                               placeholder="Enter DD / Cheque No" />

                    </div>


                    <!-- DD / Cheque Date -->
                    <div class="field">

                        <label for="txtDDChequeDate" class="form-label">
                            DD / Cheque Date
                        </label>

                        <input type="text"
                               id="txtDDChequeDate"
                               class="form-control form-Flatdate"
                               placeholder="Select Date" />

                    </div>


                    <!-- Surrender Year -->
                    <div class="field">

                        <label for="txtSurrenderYear" class="form-label">
                            Surrender Year
                        </label>

                        <input type="text"
                               id="txtSurrenderYear"
                               class="form-control"
                               placeholder="Enter Surrender Year" />

                    </div>


                    <!-- File Upload -->
                    <div class="field">

                        <label for="fileUpload" class="form-label">
                            File Upload
                        </label>

                        <input type="file"
                               id="fileUpload"
                               class="form-control" />

                    </div>


                    <!-- ROSCTL License No -->
                    <div class="field">

                        <label for="ddlROSCTLLicenseNo" class="form-label">
                            ROSCTL License No
                        </label>

                        <select id="ddlROSCTLLicenseNo"
                                class="form-select">

                            <option value="">--Choose One--</option>
                            <option value="LIC001">LIC001</option>
                            <option value="LIC002">LIC002</option>
                            <option value="LIC003">LIC003</option>

                        </select>

                    </div>


                    <!-- Licence Date -->
                    <div class="field">

                        <label for="txtLicenceDate" class="form-label">
                            Licence Date
                        </label>

                        <input type="text"
                               id="txtLicenceDate"
                               class="form-control form-Flatdate"
                               placeholder="Select Date" />

                    </div>

                </div>

            </div>

        </section>
    </div>
</div>




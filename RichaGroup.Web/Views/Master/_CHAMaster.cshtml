 
<div class="grid cols-3 p-2">
    
    <!-- CHA Name -->
    <div class="field">
        <label for="txtCHAName" class="form-label">
          
            CHA Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtCHAName"
               class="form-control"
               placeholder="Enter CHA Name" />
    </div>

    <!-- Alias Name -->
    <div class="field">
        <label for="txtAliasName" class="form-label">
          
            Alias Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtAliasName"
               class="form-control"
               placeholder="Enter Alias Name" />
    </div>

    <!-- Warehouse Address -->
    <div class="field">
        <label for="txtWarehouseAddress" class="form-label">
         
            Warehouse Address
            <span class="text-danger">*</span>
        </label>

        <textarea id="txtWarehouseAddress"
                  class="form-control textAria"
                  placeholder="Enter Warehouse Address"></textarea>
    </div>

    <!-- Address -->
    <div class="field">
        <label for="txtAddress" class="form-label">
            
            Address
            <span class="text-danger">*</span>
        </label>

        <textarea id="txtAddress"
                  class="form-control textAria"
                  placeholder="Enter Address"></textarea>
    </div>

    <!-- Warehouse City -->
    <div class="field">
        <label for="txtWarehouseCity" class="form-label">
            Warehouse City
        </label>

        <input type="text"
               id="txtWarehouseCity"
               class="form-control"
               placeholder="Enter Warehouse City" />
    </div>

    <!-- City -->
    <div class="field">
        <label for="txtCity" class="form-label">
            City
        </label>

        <input type="text"
               id="txtCity"
               class="form-control"
               placeholder="Enter City" />
    </div>

    <!-- Warehouse State -->
    <div class="field">
        <label for="txtWarehouseState" class="form-label">
            Warehouse State
        </label>

        <input type="text"
               id="txtWarehouseState"
               class="form-control"
               placeholder="Enter Warehouse State" />
    </div>

    <!-- State -->
    <div class="field">
        <label for="txtState" class="form-label">
            State
        </label>

        <input type="text"
               id="txtState"
               class="form-control"
               placeholder="Enter State" />
    </div>

    <!-- Warehouse Country -->
    <div class="field">
        <label for="ddlWarehouseCountry" class="form-label">
            Warehouse Country
        </label>

        <select id="ddlWarehouseCountry"
                class="form-select">
            <option value="">Select Warehouse Country</option>
            <option value="INDIA">INDIA</option>
            <option value="BANGLADESH">BANGLADESH</option>
            <option value="AUSTRALIA">AUSTRALIA</option>
        </select>
    </div>

    <!-- Country -->
    <div class="field">
        <label for="ddlCountry" class="form-label">
         
            Country
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountry"
                class="form-select">
            <option value="">Select Country</option>
            <option value="INDIA">INDIA</option>
            <option value="BANGLADESH">BANGLADESH</option>
            <option value="AUSTRALIA">AUSTRALIA</option>
        </select>
    </div>

    <!-- Contact 1 -->
    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>

        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <!-- Contact 2 -->
    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>

        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <!-- Telephone -->
    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>

        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>

    <!-- Fax -->
    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>

        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

    <!-- Email -->
    <div class="field">
        <label for="txtEmail" class="form-label">
         
            Email
            <span class="text-danger">*</span>
        </label>

        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <!-- Pin Code -->
    <div class="field">
        <label for="txtPinCode" class="form-label">
            Pincode
        </label>

        <input type="text"
               id="txtPinCode"
               class="form-control"
               placeholder="Enter Pincode" />
    </div>

    <!-- Other Information -->
    <div class="field">
        <label for="txtOtherInformation" class="form-label">
            Other Information
        </label>

        <textarea id="txtOtherInformation"
                  class="form-control textAria"
                  placeholder="Enter Other Information"></textarea>
    </div>
</div>
 
 
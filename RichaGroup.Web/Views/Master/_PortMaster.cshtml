<div class="grid cols-3 p-2">
     
    <div class="field">
        <label for="txtPortCode" class="form-label">
            Port Code
        </label>

        <input type="text"
               id="txtPortCode"
               
               placeholder="Enter Port Code" />
    </div>

    <div class="field">
        <label for="txtPortName" class="form-label">

            Port Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtPortName"
               
               placeholder="Enter Port Name" />
    </div>

    <div class="field">
        <label for="txtCityName" class="form-label">

            City Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtCityName"
               
               placeholder="Enter City Name" />
    </div>

    <div class="field">
        <label for="ddlCountryName" class="form-label">

            Country Name
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountryName"
                class="form-select">

            <option value="">--Choose One--</option>
            <option value="INDIA">INDIA</option>
            <option value="USA">USA</option>
            <option value="CHINA">CHINA</option>
            <option value="Sri Lanka">Sri Lanka</option>

        </select>
    </div>

    <div class="field">
        <label for="ddlStateName" class="form-label">

            State Name
            <span class="text-danger">*</span>
        </label>

        <select id="ddlStateName"
                class="form-select">

            <option value="">--Choose One--</option>
            <option value="Delhi">Delhi</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Tamil Nadu">Tamil Nadu</option>
            <option value="Gujarat">Gujarat</option>
            <option value="West Bengal">West Bengal</option>
            <option value="California">California</option>

        </select>
    </div>

    <div class="field">
        <label for="txtPincode" class="form-label">
            Pincode
        </label>

        <input type="text"
               id="txtPincode"
               
               placeholder="Enter Pincode" />
    </div> 
</div> 
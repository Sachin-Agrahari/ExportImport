 
<div class="grid cols-3 p-2">
    <div class="field">

        <label for="txtBankName" class="form-label">
            Bank Code
        </label>

        <input type="text" id="txtBankCode"  placeholder="Enter Bank Code" />
    </div>

    <div class="field">

        <label for="txtBankName" class="form-label">
            Bank Name
        </label>

        <input type="text" id="txtBankName"  placeholder="Enter Bank Name" />
    </div>


    <!-- Account No -->
    <div class="field">
        <label for="txtAccountNo" class="form-label">
            Account No.
        </label>

        <input type="text" id="txtAccountNo"  placeholder="Enter Account Number" />

    </div>
    <!-- Country -->
    <div class="field">

        <label for="ddlCountry" class="form-label">

            Country
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountry" class="form-select">
            <option value=""> Select Country </option>
            <option value="INDIA"> INDIA </option>
            <option value="AUSTRALIA"> AUSTRALIA </option>
            <option value="BANGLADESH"> BANGLADESH </option>
            <option value="USA"> USA </option>
        </select>
    </div>
    <div class="field">

        <label for="txtState" class="form-label">
            State
        </label>

        <input type="text" id="txtState"  placeholder="Enter State" />
    </div>

    <div class="field">

        <label for="txtCity" class="form-label">
            City
        </label>

        <input type="text" id="txtCity"  placeholder="Enter City" />
    </div>
    <div class="field">

        <label for="txtEBAC1" class="form-label">
            EBAC1
        </label>

        <input type="text" id="txtEBAC1"  placeholder="Enter EBAC1" />
    </div>
    <div class="field">

        <label for="txtEBAC2" class="form-label">
            EBAC2
        </label>

        <input type="text" id="txtEBAC2"  placeholder="Enter EBAC2" />
    </div>
    <div class="field">

        <label for="txtEBAC3" class="form-label">
            EBAC3
        </label>

        <input type="text" id="txtEBAC3"  placeholder="Enter EBAC3" />
    </div>
    <div class="field">

        <label for="txtIFSC1" class="form-label">
            IFSC1
        </label>

        <input type="text" id="txtIFSC1"  placeholder="Enter IFSC1" />
    </div>

    
    <div class="field">

        <label for="txtIFSC2" class="form-label">
            IFSC2
        </label>

        <input type="text" id="txtIFSC2"  placeholder="Enter IFSC2" />
    </div>
   
    <div class="field">

        <label for="txtIFSC3" class="form-label">
            IFSC3
        </label>

        <input type="text" id="txtIFSC3"  placeholder="Enter IFSC3" />
    </div>
</div>

<div class="grid p-2">
    <div class="field">

        <label for="txtAddress" class="form-label">
            Address

        </label>
        <textarea id="txtAddress" class="form-control bank-address" placeholder="Enter Address"></textarea>
    </div>
</div>
 
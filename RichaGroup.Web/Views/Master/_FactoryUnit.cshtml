    <div class="field">
        <label for="txtFacAdr2" class="form-label">Factory Address 2</label>
        <input type="text" id="txtFacAdr2" name="fac_adr2"
                 placeholder="Enter Factory Address 2" />
    </div>

    <div class="field">
        <label for="txtFacAdr3" class="form-label">Factory Address 3</label>
        <input type="text" id="txtFacAdr3" name="fac_adr3"
                 placeholder="Enter Factory Address 3" />
    </div>

    <div class="field">
        <label for="txtFacAdr4" class="form-label">Factory Address 4</label>
        <input type="text" id="txtFacAdr4" name="fac_adr4"
                 placeholder="Enter Factory Address 4" />
    </div>

    <div class="field">
        <label for="txtGspLogo" class="form-label">GSP Logo</label>
        <input type="text" id="txtGspLogo" name="gsplogo"
                 placeholder="Enter GSP Logo" />
    </div>

    <div class="field">
        <label for="txtGstMinBal" class="form-label">GST Minimum Balance</label>
        <input type="text" id="txtGstMinBal" name="gstminbal"
                 placeholder="Enter GST Minimum Balance" />
    </div>

    <!-- District and Location -->
    <div class="field">
        <label for="txtDistcd" class="form-label">District Code</label>
        <input type="text" id="txtDistcd" name="distcd"
                 placeholder="Enter District Code" />
    </div>

    <div class="field">
        <label for="txtDistname" class="form-label">District Name</label>
        <input type="text" id="txtDistname" name="distname"
                 placeholder="Enter District Name" />
    </div>

    <div class="field">
        <label for="txtLoc" class="form-label">Location</label>
        <input type="text" id="txtLoc" name="loc"
                 placeholder="Enter Location" />
    </div>

    <div class="field">
        <label for="txtPin" class="form-label">PIN Code</label>
        <input type="text" id="txtPin" name="pin"
                 placeholder="Enter PIN Code" />
    </div>

    <div class="field">
        <label for="txtFacPhone" class="form-label">Factory Phone</label>
        <input type="text" id="txtFacPhone" name="fac_phone"
                 placeholder="Enter Factory Phone" />
    </div>
     
    <div class="field">

        <div class="yn-field">

            <label class="yn-field-label">
                Generate E-Invoice
            </label>

            <div class="yn-checkbox" style="height:35px; border-radius:0px">
                <label>
                    <input type="radio" name="GenInv" class="rdoGenInv" value="Y">
                    <span>Yes</span>
                </label>

                <label>
                    <input type="radio" name="GenInv" class="rdoGenInv" value="N">
                    <span>No</span>
                </label>

            </div>

        </div>

    </div>

    <div class="field">
        <label for="txtSapWarehs" class="form-label">SAP Warehouse</label>
        <input type="text" id="txtSapWarehs" name="sap_warehs"
                 placeholder="Enter SAP Warehouse" />

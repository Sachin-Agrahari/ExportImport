
<div class="grid cols-4 px-1">

    <!-- Unit Information -->
    <div class="field">
        <label for="txtFUnit" class="form-label">Unit</label>
        <input type="text" id="txtFUnit" name="f_unit"
                 placeholder="Enter Unit" />
    </div>

    <div class="field">
        <label for="txtFName" class="form-label">Name</label>
        <input type="text" id="txtFName" name="f_name"
                 placeholder="Enter Name" />
    </div>

    <div class="field">
        <label for="txtCmpCode" class="form-label">Company Code</label>
        <input type="text" id="txtCmpCode" name="cmp_code"
                 placeholder="Enter Company Code" />
    </div>

    <!-- Seller Address -->
    <div class="field">
        <label for="txtSlrAddr1" class="form-label">Seller Address 1</label>
        <input type="text" id="txtSlrAddr1" name="slr_addr1"
                 placeholder="Enter Seller Address 1" />
    </div>

    <div class="field">
        <label for="txtSlrAddr2" class="form-label">Seller Address 2</label>
        <input type="text" id="txtSlrAddr2" name="slr_addr2"
                 placeholder="Enter Seller Address 2" />
    </div>

    <div class="field">
        <label for="txtSlrAddr3" class="form-label">Seller Address 3</label>
        <input type="text" id="txtSlrAddr3" name="slr_addr3"
                 placeholder="Enter Seller Address 3" />
    </div>

    <div class="field">
        <label for="txtSlrAddr4" class="form-label">Seller Address 4</label>
        <input type="text" id="txtSlrAddr4" name="slr_addr4"
                 placeholder="Enter Seller Address 4" />
    </div>

    <div class="field">
        <label for="txtSlrLoc" class="form-label">Seller Location</label>
        <input type="text" id="txtSlrLoc" name="slr_loc"
                 placeholder="Enter Seller Location" />
    </div>

    <div class="field">
        <label for="txtSlrPin" class="form-label">Seller PIN Code</label>
        <input type="text" id="txtSlrPin" name="slr_pin"
                 placeholder="Enter Seller PIN Code" />
    </div>

    <div class="field">
        <label for="txtSlrStcd" class="form-label">Seller State Code</label>
        <input type="text" id="txtSlrStcd" name="slr_stcd"
                 placeholder="Enter Seller State Code" />
    </div>

    <div class="field">
        <label for="txtSlrPhone" class="form-label">Seller Phone</label>
        <input type="text" id="txtSlrPhone" name="slr_phone"
                 placeholder="Enter Seller Phone" />
    </div>

    <div class="field">
        <label for="txtSlrEmail" class="form-label">Seller Email</label>
        <input type="email" id="txtSlrEmail" name="slr_email"
                 placeholder="Enter Seller Email" />
    </div>

    <!-- Invoice Information -->
    <div class="field">
        <label for="txtInvUnit" class="form-label">Invoice Unit</label>
        <input type="text" id="txtInvUnit" name="inv_unit"
                 placeholder="Enter Invoice Unit" />
    </div>

    <div class="field">
        <label for="txtWk" class="form-label">WK</label>
        <input type="text" id="txtWk" name="wk"
                 placeholder="Enter WK" />
    </div>

    <div class="field">
        <label for="txtGstNo" class="form-label">GST Number</label>
        <input type="text" id="txtGstNo" name="gst_no"
                 placeholder="Enter GST Number" />
    </div>

    <div class="field">
        <label for="txtLogoFile" class="form-label">Logo File</label>
        <input type="text" id="txtLogoFile" name="logofile"
                 placeholder="Enter Logo File" />
    </div>

    <div class="field">
        <label for="txtInvFooter" class="form-label">Invoice Footer</label>
        <input type="text" id="txtInvFooter" name="invfooter"

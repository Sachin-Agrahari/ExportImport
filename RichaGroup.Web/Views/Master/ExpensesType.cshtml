@{
    ViewData["Title"] = "Expenses Type Master";
    ViewData["Heading"] = "Expenses Type Master";
}
 

<div class="bd_mainContainer">
    <div class="page">


        <!-- Expenses Type Form -->
        <section class="card mt-3">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Expenses Type Master</h2>
                </div> 

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnAdd">
                        ＋ Add
                    </button>
 
                </div> 
            </div>

            <div class="card-body"> 

                 <div class="table-wrap">
                       <table id="blExpensesType" class="display" style="width:100%">

                        <thead>
                            <tr>
                                <th style="width: 80px;">Action</th>
                                <th>Code</th>
                                <th>Expenses Type</th> 
                            </tr>
                        </thead>

                        <tbody id="tblExpensesTypeBody">
                        </tbody>

                    </table>

                    <div id="noRecordsFound_ExpensesType"
                         class="text-center text-muted py-4 d-none">
                        No matching records found.
                    </div>

                </div>

            </div>
        </section>

    </div>
</div>


<!-- ================================
     Add Menu Modal
================================ -->

<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        Expenses Master
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                <div class="grid">
                    <label for="txtExpensesType" class="form-label">

                        Expenses Type
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text"
                           id="txtExpensesType" 
                           placeholder="Enter Expenses Type" />
                </div>
                <div class="grid">
                    <label for="txtExpensesCode" class="form-label">

                        Expenses Code
                        <span class="text-danger">*</span>
                    </label>

                    <input type="text"
                           id="txtExpensesCode" 
                           placeholder="Enter Expenses Code" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<script src="~/js/pages/MastersJs/ExpensesType.js" asp-append-version="true"></script>
@{
	ViewData["Title"] = "Advance Master";
	ViewData["Heading"] = "Advance Master";
}

<div class="bd_mainContainer">
    <div class="page">
        <section class="card">
            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Advance Master</h2>
                </div>

               

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button class="btn btn-primary btn-sm"
                            id="btnAdd">
                        ＋ Add
                    </button>
                </div>
            </div>

                <div class="card-body">

                    <div class="table-wrap">
                        <table id="tblAdvMaster" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th style="width:50px !important;">Action</th>
                                    <th style="width:50px !important; text-align:right !important;">S.No</th>
                                    <th style="width:50px !important; text-align:right !important;">Adavance No</th>
                                    <th>Buyer Number</th>
                                    <th>Amount</th>
                                    <th>Currency Type</th>
                                    <th>Location</th>
                                    <th>Remarks</th>
                                    <th>Adjustment</th>
                                </tr>
                            </thead>
                            <tbody id="tblbodyAdvMaster" class="text-truncate"></tbody>
                        </table>
                    </div>
                </div>
         </section>    
     </div>
</div>
  


<!-- ================================
     Add Menu Modal
================================ -->

<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        Advance Master
                    </div>
                </div>

                <div class="app-modal-header-actions">

                    <button type="button"
                            style="    margin-top: 12px;"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                @await Html.PartialAsync("_viewAdvance")
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

            </div>
        </div>
    </div>
</div>





<script src="~/js/pages/mastersjs/advancemaster.js" asp-append-version="true"></script>


<div class="grid cols-3 p-2">

	<div class="field">
		<label>Country Code</label>
		<select id="ddlCountryCode" class="form-select">
			<option value="">Select Code</option>
		</select>
	</div>

	<div class="field">
		<label>Country Name</label>
		<select id="ddlCountryName" class="form-select">
			<option value="">Select Name</option>
		</select>
	</div>

	<div class="field">
		<label>Currency</label>
		<select id="ddlCurrency" class="form-select">
			<option value="INR">INR</option>
			<option value="Dollar">$Dollar</option>
			<option value="Euro">Euro</option>
		</select>
	</div>



	<div class="field">
		<label>Collection Day</label>
		<input type="text" id="txtCollection" placeholder="Enter Collection" />
	</div>


	<div class="field">
		<label>E Invoice Country Code</label>
		<input type="text" id="txtEInvCountryCode" placeholder="Enter E Inv Country Code.." />
	</div>
	<div class="field">
		<label>E Invoice Country Name</label>
		<input type="text" id="txtEInvCountryName" placeholder="Enter E Inv Country Name.." />
	</div>
</div>

 
<div class="grid cols-4 p-2">

    <!-- Supplier Name -->
    <div class="field">
        <label for="txtSupplierName" class="form-label">
            
            Supplier Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtSupplierName"
               class="form-control"
               placeholder="Enter Supplier Name" />
    </div>

    <!-- Alias Name -->
    <div class="field">
        <label for="txtAliasName" class="form-label">
            
            Alias Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtAliasName"
               class="form-control"
               placeholder="Enter Alias Name" />
    </div>

    <!-- Address 1 -->
    <div class="field">
        <label for="txtAddress1" class="form-label">
         
            Address 1
            <span class="text-danger">*</span>
        </label>

        <textarea id="txtAddress1"
                  class="form-control textAria"
                  rows="2"
                  placeholder="Enter Address 1"></textarea>
    </div>

    <!-- Address 2 -->
    <div class="field">
        <label for="txtAddress2" class="form-label">
            Address 2
        </label>

        <textarea id="txtAddress2"
                  class="form-control textAria"
                  rows="2"
                  placeholder="Enter Address 2"></textarea>
    </div>

    <!-- Address 3 -->
    <div class="field">
        <label for="txtAddress3" class="form-label">
            Address 3
        </label>

        <input type="text"
               id="txtAddress3"
               class="form-control"
               placeholder="Enter Address 3" />
    </div>

    <!-- Address 4 -->
    <div class="field">
        <label for="txtAddress4" class="form-label">
            Address 4
        </label>

        <input type="text"
               id="txtAddress4"
               class="form-control"
               placeholder="Enter Address 4" />
    </div>

    <!-- City -->
    <div class="field">
        <label for="txtCity" class="form-label">
          
            City
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtCity"
               class="form-control"
               placeholder="Enter City" />
    </div>

    <!-- State -->
    <div class="field">
        <label for="txtState" class="form-label">
            
            State
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtState"
               class="form-control"
               placeholder="Enter State" />
    </div>

    <!-- Country -->
    <div class="field">
        <label for="ddlCountry" class="form-label">
          
            Country
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountry"
                class="form-select">

            <option value="">Select Country</option>
            <option value="INDIA">INDIA</option>
            <option value="CHINA">CHINA</option>
            <option value="UAE">UAE</option>
            <option value="USA">USA</option>
            <option value="UK">UK</option>

        </select>
    </div>

    <!-- Pin Code -->
    <div class="field">
        <label for="txtPinCode" class="form-label">
            Pin Code
        </label>

        <input type="text"
               id="txtPinCode"
               class="form-control"
               placeholder="Enter Pin Code" />
    </div>

    <!-- Contact 1 -->
    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>

        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <!-- Contact 2 -->
    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>

        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <!-- Telephone -->
    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>

        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>

    <!-- Fax -->
    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>

        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

    <!-- Email -->
    <div class="field">
        <label for="txtEmail" class="form-label">
            
            Email
            <span class="text-danger">*</span>
        </label>

        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <!-- Other Information -->
    <div class="field">
        <label for="txtOtherInformation" class="form-label">
            Other Information
        </label>

        <textarea id="txtOtherInformation"
                  class="form-control textAria"
                  rows="3"
                  placeholder="Enter Other Information"></textarea>
    </div>

    <!-- Payment Days -->
    <div class="field">
        <label for="txtPaymentDays" class="form-label">
            Payment Days
        </label>

        <input type="number"
               id="txtPaymentDays"
               class="form-control"
               value="0.00"
               step="0.01"
               placeholder="Enter Payment Days" />
    </div>

    <!-- Currency -->
    <div class="field">
        <label for="ddlCurrency" class="form-label">
            Currency
        </label>

        <select id="ddlCurrency"
                class="form-select">

            <option value="">Select Currency</option>
            <option value="DINAR">Dinar</option>
            <option value="EURO">Euro</option>
            <option value="GBP">GBP</option>
            <option value="INR">INR</option>
            <option value="USD">USD</option>

        </select>
    </div>

    <!-- BOE Payment Days -->
    <div class="field">
        <label for="txtBOEPaymentDays" class="form-label">
            BOE Payment Days
        </label>

        <input type="number"
               id="txtBOEPaymentDays"
               class="form-control"
               value="0.00"
               step="0.01"
               placeholder="Enter BOE Payment Days" />
    </div>

    <!-- Bank A/C No -->
    <div class="field">
        <label for="txtBankAccountNo" class="form-label">
            Bank A/C No
        </label>

        <input type="text"
               id="txtBankAccountNo"
               class="form-control"
               placeholder="Enter Bank A/C No" />
    </div>

    <!-- Bank Name -->
    <div class="field">
        <label for="txtBankName" class="form-label">
            Bank Name
        </label>

        <input type="text"
               id="txtBankName"
               class="form-control"
               placeholder="Enter Bank Name" />
    </div>

    <!-- Swift Code -->
    <div class="field">
        <label for="txtSwiftCode" class="form-label">
            Swift Code
        </label>

        <input type="text"
               id="txtSwiftCode"
               class="form-control"
               placeholder="Enter Swift Code" />
    </div>

    <!-- IBAN No -->
    <div class="field">
        <label for="txtIBANNo" class="form-label">
            IBAN No
        </label>

        <input type="text"
               id="txtIBANNo"
               class="form-control"
               placeholder="Enter IBAN No" />
    </div>

    <!-- Bank Address -->
    <div class="field">
        <label for="txtBankAddress" class="form-label">
            Bank Address
        </label>

        <textarea id="txtBankAddress"
                  class="form-control textAria"
                  rows="2"
                  placeholder="Enter Bank Address"></textarea>
    </div>

</div>
 
 
<div class="grid cols-3 p-2"> 
    <div class="field">
        <label for="txtTransportorName" class="form-label">

            Transportor Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtTransportorName"
               class="form-control"
               placeholder="Enter Transportor Name" />
    </div>

    <div class="field">
        <label for="txtAliasName" class="form-label">

            Alias Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtAliasName"
               class="form-control"
               placeholder="Enter Alias Name" />
    </div>

    <div class="field">
        <label for="txtEmail" class="form-label">

            Email
            <span class="text-danger">*</span>
        </label>

        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <div class="field">
        <label for="txtAddress" class="form-label">

            Address
            <span class="text-danger">*</span>
        </label>

        <textarea id="txtAddress"
                  class="form-control"
                  rows="1"
                  placeholder="Enter Address"></textarea>
    </div>

    <div class="field">
        <label for="ddlCountryName" class="form-label">

            Country Name
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountryName"
                class="form-select">
            <option value="">--Choose One--</option>
            <option value="INDIA">INDIA</option>
            <option value="USA">USA</option>
            <option value="CHINA">CHINA</option>
            <option value="Sri Lanka">Sri Lanka</option>
        </select>
    </div>

    <div class="field">
        <label for="ddlState" class="form-label">

            State
            <span class="text-danger">*</span>
        </label>

        <select class="form-select"
                id="ddlState">
            <option value="">--Choose One--</option>
            <option value="Delhi">Delhi</option>
            <option value="Maharashtra">Maharashtra</option>
            <option value="Haryana">Haryana</option>
            <option value="Gujarat">Gujarat</option>
        </select>
    </div>

    <div class="field">
        <label for="ddlCity" class="form-label">

            City
            <span class="text-danger">*</span>
        </label>

        <select class="form-select"
                id="ddlCity">
            <option value="">--Choose One--</option>
            <option value="New Delhi">New Delhi</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Gurgaon">Gurgaon</option>
            <option value="Ahmedabad">Ahmedabad</option>
        </select>
    </div>

    <div class="field">
        <label for="txtPincode" class="form-label">
            Pincode
        </label>

        <input type="text"
               id="txtPincode"
               class="form-control"
               placeholder="Enter Pincode" />
    </div>

    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>

        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>

        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>

        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>

    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>

        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

    <div class="field">
        <label for="txtOtherInfo" class="form-label">
            Other Information
        </label>

        <textarea id="txtOtherInfo"
                  class="form-control"
                  rows="1"
                  placeholder="Enter Other Information"></textarea>
    </div>


</div>

 
 
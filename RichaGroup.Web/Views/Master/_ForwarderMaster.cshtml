  
<div class="grid cols-4 p-2">

    <!-- Forwarder Name -->
    <div class="field">
        <label for="txtForwarderName" class="form-label">

            Forwarder Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtForwarderName"
               class="form-control"
               placeholder="Enter Forwarder Name" />
    </div>

    <!-- Alias Name -->
    <div class="field">
        <label for="txtAliasName" class="form-label">

            Alias Name
            <span class="text-danger">*</span>
        </label>

        <input type="text"
               id="txtAliasName"
               class="form-control"
               placeholder="Enter Alias Name" />
    </div>

    <!-- Email -->
    <div class="field">
        <label for="txtEmail" class="form-label">

            Email
            <span class="text-danger">*</span>
        </label>

        <input type="email"
               id="txtEmail"
               class="form-control"
               placeholder="Enter Email" />
    </div>

    <!-- Country -->
    <div class="field">
        <label for="ddlCountry" class="form-label">

            Country
            <span class="text-danger">*</span>
        </label>

        <select id="ddlCountry"
                class="form-select">
            <option value="">Select Country</option>
            <option value="INDIA">INDIA</option>
            <option value="AUSTRALIA">AUSTRALIA</option>
            <option value="BANGLADESH">BANGLADESH</option>
            <option value="USA">USA</option>
        </select>
    </div>
     
    <div class="field">
        <label for="txtState" class="form-label">

            State
            <span class="text-danger">*</span>
        </label>
        <select class="form-select" id="ddlState">
            <option value="">select State</option>
        </select>
    </div> 

    <div class="field">
        <label for="txtCity" class="form-label">

            City
            <span class="text-danger">*</span>
        </label>

        <select class="form-select" id="ddlCity">
            <option value="">select City</option>
        </select>
    </div>
     
    <!-- Pin Code -->
    <div class="field">
        <label for="txtPinCode" class="form-label">
            Pin Code
        </label>

        <input type="text"
               id="txtPinCode"
               class="form-control"
               placeholder="Enter Pin Code" />
    </div>


    <!-- Address -->
    <div class="field">
        <label for="txtAddress" class="form-label">

            Address
            <span class="text-danger">*</span>
        </label>

        <textarea id="txtAddress"
                  class="form-control textAria"
                  placeholder="Enter Address"></textarea>
    </div>

    <!-- Other Information -->
    <div class="field">
        <label for="txtOtherInformation" class="form-label">
            Other Information
        </label>

        <textarea id="txtOtherInformation"
                  class="form-control textAria"
                  placeholder="Enter Other Information"></textarea>
    </div>


    <!-- Contact 1 -->
    <div class="field">
        <label for="txtContact1" class="form-label">
            Contact 1
        </label>

        <input type="text"
               id="txtContact1"
               class="form-control"
               placeholder="Enter Contact 1" />
    </div>

    <!-- Contact 2 -->
    <div class="field">
        <label for="txtContact2" class="form-label">
            Contact 2
        </label>

        <input type="text"
               id="txtContact2"
               class="form-control"
               placeholder="Enter Contact 2" />
    </div>

    <!-- Telephone -->
    <div class="field">
        <label for="txtTelephone" class="form-label">
            Telephone
        </label>

        <input type="text"
               id="txtTelephone"
               class="form-control"
               placeholder="Enter Telephone" />
    </div>

    <!-- Fax -->
    <div class="field">
        <label for="txtFax" class="form-label">
            Fax
        </label>

        <input type="text"
               id="txtFax"
               class="form-control"
               placeholder="Enter Fax" />
    </div>

</div> 
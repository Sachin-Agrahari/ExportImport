@{
    ViewData["Title"] = "GST Credit Master";
    ViewData["Heading"] = "GST Credit Master";
}

<div class="bd_mainContainer">
    <div class="page">

        <div class="card shadow-sm border-0 mt-2">

            <!-- HEADER -->
            <div class="card-head">

                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">GST Credit Master</h2>
                </div>

                <div class="d-flex gap-2">
                    <div class="d-flex gap-2">
                        @await Html.PartialAsync("Components/_CheckBoxComponent")
                        @await Html.PartialAsync("Components/_UploadAndViewButtons")
                        <button class="btn btn-primary btn-sm"
                                id="btnAdd">
                            ＋ Add
                        </button>
                    </div>

                </div>

            </div>
            <!-- Form -->
            <div class="card-body">

               

                <!-- GST Credit List -->

                <div class="mt-4">
 
                    <div class="table-responsive">

                        <table class="table table-hover align-middle table-bordered mb-0"
                               id="tblGSTCreditMaster">

                            <thead class="table-light">

                                <tr>
                                    <th style="width:80px;">
                                        Action
                                    </th>
                                    <th style="width:80px;">
                                        Code
                                    </th>

                                    <th style="width:110px; text-align:right !important;">
                                        Trx.No.
                                    </th>

                                    <th style="width:140px;">
                                        Date
                                    </th>

                                    <th style="width:150px;text-align:right !important;">
                                        Amount
                                    </th>

                                    <th>
                                        Remarks
                                    </th>

                                    <th style="width:220px;">
                                        Location
                                    </th>

                                   

                                </tr>

                            </thead>

                            <tbody id="tblGSTCreditMasterBody">
                                <!-- Rows injected by JS -->
                            </tbody>

                        </table>


                        <div id="noRecordsFound_GSTCreditMaster"
                             class="text-center text-muted py-4 d-none">

                            No matching records found.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>




<div class="modal fade" id="addGSTCreditMasterModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        GST Credit Master
                    </div>
                </div>
                <div class="d-flex gap-2">



                    <button type="button"
                            style=" "
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="app-modal-header-actions">
                </div>
            </div>

            <div class="modal-body p-2">

                <div class="row g-3">

                    <!-- Trx No -->
                    <div class="col-md-3">

                        <label for="txtTrxNo" class="form-label">
                            Trx.No.
                        </label>

                        <input type="text" id="txtTrxNo" class="form-control" placeholder="Enter Transaction No." />
                    </div>


                    <!-- Date -->
                    <div class="col-md-3">

                        <label for="txtDate" class="form-label">
                            Date
                        </label>

                        <input type="text" id="txtDate" class="form-control" placeholder="DD/MMM/YYYY" />
                    </div>


                    <!-- Amount -->
                    <div class="col-md-3">

                        <label for="txtAmount" class="form-label">
                            Amount
                        </label>

                        <input type="number" id="txtAmount" class="form-control" placeholder="Enter Amount" step="0.01" />
                    </div>


                    <!-- Remarks -->
                    <div class="col-md-3">

                        <label for="txtRemarks" class="form-label">
                            Remarks
                        </label>

                        <input type="text" id="txtRemarks" class="form-control" placeholder="Enter Remarks" />
                    </div>


                    <!-- Location -->
                    <div class="col-md-3">

                        <label for="ddlLocation" class="form-label">
                            Location
                        </label>

                        <select id="ddlLocation" class="form-select">
                            <option value=""> Select Location </option>
                            <option value="ABC Co Pvt Ltd"> ABC Co Pvt Ltd </option>
                            <option value="Richa Global"> Richa Global </option>
                            <option value="Arvind Limited"> Arvind Limited </option>
                        </select>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

            </div>
        </div>
    </div>
</div>




<script src="~/js/pages/MastersJs/GSTCredit.js" asp-append-version="true"></script>
@{
	ViewData["Title"] = "Po Open And Close";
	ViewData["Heading"] = "Po Open And Close";
}
<div class="bd_mainContainer">

    <div class="page">

        <section class="card"> 
            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Po Open And Close</h2>
                </div>


                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    
                </div>
            </div> 

            <div class="card-body p-3">

                 <div class="card border shadow-sm">

                    <div class="card-body py-3">

                        <div class="row align-items-center g-3">

                            <!-- PURCHASE ORDER -->
                            <div class="col-lg-6 col-md-8">

                                <div class="row align-items-center">

                                    <div class="col-sm-4">
                                        <label for="ddlPurchaseOrder"
                                               class="form-label fw-semibold mb-0">
                                            Purchase Order
                                        </label>
                                    </div>

                                    <div class="col-sm-8">

                                        <select id="ddlPurchaseOrder"
                                                class="form-select form-select-sm">
                                            <option value="">Select Purchase Order</option>
                                            <option value="PO-1001">PO-1001</option>
                                            <option value="PO-1002">PO-1002</option>
                                            <option value="PO-1003">PO-1003</option>
                                            <option value="PO-1004">PO-1004</option>
                                            <option value="PO-1005">PO-1005</option>
                                        </select>

                                    </div>

                                </div>

                            </div>


                            <!-- ACTION BUTTONS -->
                            <div class="col-lg-6 col-md-4">

                                <div class="d-flex justify-content-md-end justify-content-start
                                            align-items-center gap-2 flex-wrap">

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm p-2"
                                            id="btnPoClose">

                                        <i class="fa-solid fa-lock me-1"></i>
                                        PO Close

                                    </button>


                                    <button type="button"
                                            class="btn btn-success btn-sm px-4"
                                            id="btnPoOpen">

                                        <i class="fa-solid fa-lock-open me-1"></i>
                                        PO Open

                                    </button>


                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </section>
    </div>
</div>


<script src="~/js/pages/accessory/po_open_close.js" asp-append-version="true"></script>
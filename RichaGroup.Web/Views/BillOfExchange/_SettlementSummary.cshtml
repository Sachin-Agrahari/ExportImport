<table>
    <tbody>
        <tr>
            <!-- Left Side Details Table -->
            <td>
                <table class="details-table">
                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Average Conv Rate:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td></td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Realization Date:</label>
                                <input class="form-Flatdate" disabled>
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label>Full Rcvd:</label>
                                <div class="yn-field">
                                    <div class="yn-checkbox">
                                        <label>
                                            <input type="radio" disabled name="LessCommi" value="Y"> YES
                                        </label>
                                        <label>
                                            <input type="radio" disabled name="LessCommi" value="N"> NO
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Actual Amount Received:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label></label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Commission:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label></label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Discount:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label></label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Other Charges:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label></label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <div class="field-row">
                                <label>Bank Charges:</label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                        <td>
                            <div class="field-row">
                                <label></label>
                                <input class="num" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>
                </table>
            </td>

            <!-- Right Side Table (Write Off & Remarks Expanded) -->
            <td style="width: 60%; padding-left: 20px;">
                <table style="width: 100%; border-right:0px">
                    <tr>
                        <td style="border-right:0px">
                            <div class="field-row">
                                <label style="min-width: 80px;">Net:</label>
                                <input class="num w-full" disabled placeholder="0.00">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="border-right:0px">
                            <div class="field-row">
                                <label style="min-width: 80px;">Write Off:</label>
                                <input type="text" class="form-Flatdate w-full" id="txtWriteoff" placeholder="DD/MMM/YYYY">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="border-right:0px">
                            <div class="field-row" style="margin-top: 10px;">
                                <label style="min-width: 80px;">Remarks:</label>
                                <!-- Using a textarea for better multi-line remarks styling, or keep input type="text" -->
                                <textarea rows="3" class="w-full"></textarea>
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </tbody>
</table>

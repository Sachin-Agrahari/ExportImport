@{
    ViewData["Title"] = "Advances Payment Received";
    ViewData["Heading"] = "Advances Payment Received";
}

<style>

.sum-tile {
    background:linear-gradient(to bottom, var(--teal) 0%, rgba(119, 172, 240, 0.85) 100%) !important;
    border:1px solid var(--teal);
    border-radius: 12px;
    color: #fff;
    padding: 12px 18px;
    min-width: 170px;
}
.sum-tile .lbl {
    font-size: .88rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 4px;
}
.sum-tile.accent b {
    color: #5fd4c4;
}
</style>

<div class="bd_mainContainer">

    <div class="page">  
     <!-- ADVANCE DETAILS -->
        <section class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Adv Payment Recvd</h2>
                </div>


                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                   @*  <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button> *@

                    <button class="btn btn-outline-danger btn-sm" style="padding:0px 10px" id="btnBack">
                        ← Back
                    </button>

                </div>
            </div>

            <div class="card-body">

                <div class="grid cols-5">

                    <div class="field">
                        <label class="form-label">Advance No.</label>
                        <input type="text"
                               id="txtAdvanceNo_AdvPaymentRecvd"
                               class="form-control"
                               placeholder="Enter Advance No..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Date</label>
                        <input type="text" id="txtDate_AdvPaymentRecvd" class="form-control" placeholder="Select Date..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Buyer</label>
                        <select id="ddlBuyer_AdvPaymentRecvd" class="form-select select2-field">
                            <option value="">Select Buyer</option>
                            <option value="AEO">AEO</option>
                            <option value="J.CREW">J. CREW</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="form-label">Amount</label>
                        <input type="text" id="txtAmount_AdvPaymentRecvd" class="form-control" placeholder="Enter Amount..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Currency</label>
                        <select id="ddlCurrency_AdvPaymentRecvd" class="form-select select2-field">
                            <option value="">Select Currency</option>
                            <option value="US$">US$</option>
                            <option value="EURO">EURO</option>
                            <option value="UK£">UK£</option>
                            <option value="INR">INR</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="form-label">Avg. Rate</label>
                        <input type="text" id="txtAvgRate_AdvPaymentRecvd" class="form-control" placeholder="Enter Average Rate..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Amount INR</label>
                        <input type="text" id="txtAmountINR_AdvPaymentRecvd" class="form-control" placeholder="Amount INR..." />
                    </div>

                    <div class="field">
                        <label class="form-label">BOE Adjust.</label>
                        <input type="text" id="txtBOEAdjust_AdvPaymentRecvd" class="form-control" placeholder="BOE Adjustment..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Balance Amt.</label>
                        <input type="text" id="txtBalanceAmt_AdvPaymentRecvd" class="form-control" placeholder="Balance Amount..." />
                    </div>

                    <div class="field">
                        <label class="form-label">IRM Number</label>
                        <input type="text" id="txtIRMNo_AdvPaymentRecvd" class="form-control" placeholder="Enter IRM Number..." />
                    </div>

                    <div class="field">
                        <label class="form-label">IRM Date</label>
                        <input type="text" id="txtIRMDate_AdvPaymentRecvd" class="form-control" placeholder="Select IRM Date..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Credit Advice No.</label>
                        <input type="text" id="txtCreditAdviceNo_AdvPaymentRecvd" class="form-control" placeholder="Credit Advice No..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Advice Date</label>
                        <input type="text" id="txtAdviceDate_AdvPaymentRecvd" class="form-control" placeholder="Select Advice Date..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Payment Against Export</label>
                        <select id="ddlPaymentAgainstExport_AdvPaymentRecvd" class="form-select select2-field">
                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="form-label">Option</label>
                        <input type="text" id="txtOption_AdvPaymentRecvd" class="form-control" value="INVOICE NO" placeholder="Enter Option..." />
                    </div>
 
                    <div class="field">
                        <label class="form-label">Invoice Dtl</label>

                        <div class="d-flex gap-2">
                            <select id="ddlInvoiceDtl_AdvPaymentRecvd" class="form-select select2-field flex-grow-1">
                                <option value="">Select</option>
                                <option value="Y">Y</option>
                                <option value="N">N</option>
                            </select>

                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    id="addInvDtls">
                                Add
                            </button>
                        </div>
                    </div>

                    <!-- MANUAL / EXTRA RADIO -->
                    <div class="field"> 
                        <label class="form-label">Adjustment Type</label> 
                        <div class="d-flex justify-content-start align-item-center mt-3"> 
                            <label class="adjustment-radio me-3">
                                <input type="radio" name="adjustmentType_AdvPaymentRecvd" id="rdoManualAdj_AdvPaymentRecvd" value="Manual" /> 
                                <span>Manual Adjustment</span>
                            </label>

                            <label class="adjustment-radio">
                                <input type="radio" name="adjustmentType_AdvPaymentRecvd" id="rdoExtraAdj_AdvPaymentRecvd" value="Extra" /> 
                                <span>Extra Adjustment</span>
                            </label> 
                        </div> 
                    </div>

                    <div class="field">
                        <label class="form-label">Adjustment Amount</label> 
                        <input type="text" id="txtAdjustmentAmount_AdvPaymentRecvd" class="form-control" value="0.00" placeholder="Adjustment Amount..." />
                    </div>

                    <div class="field">
                        <label class="form-label">Bank</label> 
                        <input type="text" id="txtBank_AdvPaymentRecvd" class="form-control" value="HDFC BANK-BNK05" placeholder="Enter Bank..." />
                    </div>

                    <div class="field d-flex align-items-end">

                        <button type="button"
                                class="btn btn-primary btn-sm"
                                id="btnAdd_AdvPaymentRecvd">
                            Add
                        </button>

                    </div>
                </div>
             
               <div class="table-wrap mt-2">

                    <table id="tbl_AdvPaymentRecvd"
                           class="display table table-sm table-bordered text-nowrap mb-0"
                           style="min-width:1250px; width:100%;">
                
                        <thead>
                
                            <tr class="groups">
                                <th colspan="8"></th>
                
                                <th colspan="2" class="gline">
                                    Received
                                </th>
                
                                <th colspan="2" class="gline">
                                    Manual Adjustment
                                </th>
                
                                <th colspan="2" class="gline">
                                    Extra Adjustment
                                </th>
                            </tr>
                
                            <tr>
                                <th>Action</th>
                                <th>S.No</th>
                                <th class="r">Cnv. Rate</th>
                                <th class="r">Amount</th>
                                <th>TT Number</th>
                                <th class="c">Y</th>
                                <th class="c">FW</th>
                                <th class="r">TRW</th>
                               
                
                                <th class="r">Amount</th>
                                <th>Date</th>
                
                                <th>Date</th>
                                <th class="r">Amount</th>
                
                                <th>Date</th>
                                <th class="r">Amount</th>
                            </tr>
                
                        </thead>
                
                        <tbody id="tblbody_AdvPaymentRecvd"></tbody>
                
                    </table>
                
                </div>

                 <div class="d-flex g-3 justify-content-end flex-wrap mt-3" style="gap: 14px;">
                         <div class="sum-tile"><div class="lbl">Advance Received</div><b>0.00</b></div>
                         <div class="sum-tile"><div class="lbl">Tagged Invoice</div><b>0.00</b></div>
                       
                         <div class="sum-tile accent"><div class="lbl">Extra Amount</div><b>0.00</b></div>
                           <div class="sum-tile"><div class="lbl">Bank Charges</div><b>0.00</b></div>
                 </div>
                @*     <thead>
                        <tr>
                            <th>Conv. Rate</th>
                            <th>Amount</th>
                            <th>TT Number</th>
                            <th>Y</th>
                            <th>F / W. Trx</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Date</th>
                            <th>Amount</th>
                        </tr>
                    </thead>

                    <tbody id="tblbodyAdvPaymentRecvd">
                    </tbody>
                         
                </table> *@
            
            </div>
        </section>
         
        @* <section class="card">
            <div class="card-head">
                Manual Adjustment
            </div>
            <div class="card-body" style="padding: 9px 22px 11px !important;">

                <div class="grid cols-4">

                    <div class="field">
                        <label class="form-label">Date</label>
                        <input type="text" id="txtManualAdjDate1" class="form-control manual-adjustment-date form-Flatdate" placeholder="Select Date..." />
                    </div>

                    <div class="field">

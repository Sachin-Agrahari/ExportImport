    </div>
</div>


<div class="modal fade" id="addInvoiceDtls" tabindex="-1" aria-labelledby="addInvoiceDtls" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addInvoiceDtlsLabel">
                        Add Invoice Details
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                <div class="invoice-details-table-wrap">

                    <table id="tblInvoiceDetails_AdvPaymentRecvd"
                           class="table table-sm table-bordered align-middle mb-0">

                        <thead>
                            <tr>
                                <th style="width:80px;">S. No</th>
                                <th>Inv_No</th>
                                <th class="text-end">Inv Amt</th>
                                <th style="width:80px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="tblbodyInvoiceDetails_AdvPaymentRecvd">
                        </tbody>

                    </table>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade"
     id="editAdvPaymentModal"
     tabindex="-1"
     aria-labelledby="editAdvPaymentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content modal-box">

            <div class="modal-header">

                <div class="modal-header-text">
                    <div class="modal-title"
                         id="editAdvPaymentModalLabel">
                        Edit Advance Payment
                    </div>
                </div>

                <button type="button"
                        class="modal-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">

                    <svg viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>

                </button>

            </div>


            <div class="modal-body p-3">

                <div class="row g-3">

                    <!-- Cnv Rate -->
                    <div class="col-md-3">
                        <label for="txtAdv_CnvRate"
                               class="form-label">
                            Cnv. Rate
                        </label>

                        <input type="text"
                               id="txtAdv_CnvRate"
                               class="form-control">
                    </div>


                    <!-- Amount -->
                    <div class="col-md-3">
                        <label for="txtAdv_Amount"
                               class="form-label">
                            Amount
                        </label>

                        <input type="text"
                               id="txtAdv_Amount"
                               class="form-control">
                    </div>


                    <!-- TT Number -->
                    <div class="col-md-3">
                        <label for="txtAdv_TTNumber"
                               class="form-label">
                            TT Number
                        </label>

                        <input type="text"
                               id="txtAdv_TTNumber"
                               class="form-control">
                    </div>


                    <!-- Y -->
                    <div class="col-md-3">
                        <label for="ddlAdv_Y"
                               class="form-label">
                            Y
                        </label>

                        <select id="ddlAdv_Y"
                                class="form-control">

                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>

                        </select>
                    </div>


                    <!-- FW -->
                    <div class="col-md-3">
                        <label for="ddlAdv_FW"
                               class="form-label">
                            FW
                        </label>

                        <select id="ddlAdv_FW"
                                class="form-control">

                            <option value="">Select</option>
                            <option value="F">F</option>
                            <option value="P">P</option>

                        </select>
                    </div>


                    <!-- TRW -->
                    <div class="col-md-3">
                        <label for="txtAdv_TRW"
                               class="form-label">
                            TRW
                        </label>

                        <input type="text"
                               id="txtAdv_TRW"
                               class="form-control">
                    </div>


                    <!-- Received Amount -->
                    <div class="col-md-3">
                        <label for="txtAdv_ReceivedAmount"
                               class="form-label">
                            Received Amount
                        </label>

                        <input type="text"
                               id="txtAdv_ReceivedAmount"
                               class="form-control">
                    </div>


                    <!-- Received Date -->
                    <div class="col-md-3">
                        <label for="txtAdv_ReceivedDate"
                               class="form-label">
                            Received Date
                        </label>

                        <input type="text"
                               id="txtAdv_ReceivedDate"
                               class="form-control"
                               placeholder="dd-mm-yyyy">
                    </div>


                    <!-- Manual Date -->
                    <div class="col-md-3">
                        <label for="txtAdv_ManualDate"
                               class="form-label">
                            Manual Adjustment Date
                        </label>

                        <input type="text"
                               id="txtAdv_ManualDate"
                               class="form-control"
                               placeholder="dd-mm-yyyy">
                    </div>


                    <!-- Manual Amount -->
                    <div class="col-md-3">
                        <label for="txtAdv_ManualAmount"
                               class="form-label">
                            Manual Adjustment Amount
                        </label>

                        <input type="text"
                               id="txtAdv_ManualAmount"
                               class="form-control">
                    </div>


                    <!-- Extra Date -->
                    <div class="col-md-3">
                        <label for="txtAdv_ExtraDate"
                               class="form-label">
                            Extra Adjustment Date
                        </label>

                        <input type="text"
                               id="txtAdv_ExtraDate"
                               class="form-control"
                               placeholder="dd-mm-yyyy">
                    </div>


                    <!-- Extra Amount -->
                    <div class="col-md-3">
                        <label for="txtAdv_ExtraAmount"
                               class="form-label">
                            Extra Adjustment Amount
                        </label>

                        <input type="text"
                               id="txtAdv_ExtraAmount"
                               class="form-control">
                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSaveAdvPayment">

                    Save

                </button>

            </div>

        </div>

    </div>

</div>

@* open a modal after select a f according to select ok *@
<div class="modal fade"
     id="advanceFModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Advance F Help</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <table class="table table-bordered"
                       id="tblAdvanceF">
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>Transaction No</th>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Rate</th>
                            <th>From Date</th>
                            <th>To Date</th>
                            <th>Balance</th>
                            <th>INR</th>
                            <th>Contract No#</th>
                        </tr>
                    </thead>

                    <tbody id="tblbodyAdvanceF"></tbody>
                </table>

            </div>

        </div>
    </div>
</div>

@* after P then show this modal  *@


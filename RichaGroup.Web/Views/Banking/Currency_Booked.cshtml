@{
	ViewData["Title"] = "Currency Booked";
	ViewData["Heading"] = "Currency Booked";
}

<div class="bd_mainContainer">
    <div class="card">
        <div class="card-head">
            <div>
                <span class="tick"></span>
                <h2 class="mt-2" id="txtHeaderMain">Currency Booked</h2>
            </div>

            <div class="d-flex gap-2">
                @await Html.PartialAsync("Components/_CheckBoxComponent")
                @await Html.PartialAsync("Components/_UploadAndViewButtons")
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnAdd">
                    ＋ Add
                </button>
            </div>
             
        </div>

        <div class="card shadow-sm border-0 mt-2">
            <div class="card-body">
             
                    <div class="d-flex justify-content-end align-items-center gap-3 mb-3">
                    
                       
                    
                        <!-- Status Dropdown -->
                        <div class="d-flex align-items-center gap-2">
                            <label for="ddlBookingStatus" class="form-label mb-0 fw-semibold">
                                Status:
                            </label>
                    
                            <select id="ddlBookingStatus"
                                    class="form-select"
                                    style="width: 100px;">
                                <option value="All">All</option>
                                <option value="Pending">Pending</option>
                                <option value="Complete">Complete</option>
                            </select>
                        </div>

                         <!-- Search Box -->
                        <div class="position-relative" style="width: 220px;">
                            <i class="fa-solid fa-magnifying-glass position-absolute"
                               style="left: 12px; top: 50%; transform: translateY(-50%); color: #6c757d;">
                            </i>
                    
                            <input type="text"
                                   id="txtSearchCurrencyBooked"
                                   class="form-control ps-5"
                                   placeholder="Search records..." />
                        </div>
                    
                    </div>


 
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-bordered mb-0" id="tblCurrencyBooked">
                        <thead class="table-light">
                            <tr> 
                                <th>Action</th>
                                <th>Trx No</th>
                                <th>Date</th>
                                <th>Export/Import</th>
                                <th>Sell/Buy</th>
                                <th>Bank</th>
                                <th>Currency</th>
                                <th>Amount</th>
                                <th>Rate</th>
                                <th>Due Date</th>
                                <th>Inr</th>
                                <th>CCode</th>
                                <th>Contract No</th>
                            </tr>
                        </thead>
                        <tbody id="tblCurrencyBookedBody">
                            <!-- rows injected  -->
                        </tbody>
                    </table>

                    <div id="noRecordsFound_CurrencyBooked" class="text-center text-muted py-4 d-none">
                        No matching records found.
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>


<!-- ================================
     Add Menu Modal
================================ -->

<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">

            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        Currency Booked
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-0">
                @await Html.PartialAsync("_CurrencyBooked")
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<script src="~/js/pages/banking/currency_booked.js" asp-append-version="true"></script>

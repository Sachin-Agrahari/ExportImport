

<div class="bd_mainContainer">
    <div class="page">
        <!-- EBRC Details -->
        @* <section class="card"> *@

            <div class="card-body">

                <div class="grid cols-6">

                    <div class="field">
                        <label>B.O. Exchange # <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtBOExchangeNo_EBRCDetails"
                               placeholder="Enter B.O. Exchange No..." />
                    </div>

                    <div class="field span-2">
                        <label>Bank Ref. # <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtBankRefNo_EBRCDetails"
                               placeholder="Enter Bank Reference..." />
                    </div>

                    <div class="field">
                        <label>Realization Date</label>

                        <input type="text"
                               id="txtRealizationDate_EBRCDetails"
                               placeholder="Select Realization Date..." />
                    </div>

                    <div class="field">
                        <label>Payment Received <span class="text-danger">*</span></label>

                        <select id="ddlPaymentReceived_EBRCDetails"
                                class="select2-field">

                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>

                        </select>
                    </div>

                    <div class="field">
                        <label>Payment Type <span class="text-danger">*</span></label>

                        <select id="ddlPaymentType_EBRCDetails"
                                class="select2-field">

                            <option value="">Select</option>
                            <option value="Partial">Partial Payment</option>
                            <option value="Full">Full Payment</option>

                        </select>
                    </div>

                    <div class="field">
                        <label>B.R.C. Received</label>

                        <select id="ddlBRCReceived_EBRCDetails"
                                class="select2-field">

                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>

                        </select>
                    </div>

                    <div class="field">
                        <label>B.R.C. Rcvd On</label>

                        <input type="text"
                               id="txtBRCRcvdOn_EBRCDetails"
                               placeholder="Select BRC Received Date..." />
                    </div>

                    <div class="field">
                        <label>IFSC <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtIFSC_EBRCDetails"
                               placeholder="Enter IFSC..." />
                    </div>

                    <!-- EBRC SET 1 -->

                    <div class="field">
                        <label>EBRC # 1</label>

                        <input type="text"
                               id="txtEBRCNo1_EBRCDetails"
                               placeholder="Enter EBRC No..." />
                    </div>

                    <div class="field">
                        <label>Dated 1</label>

                        <input type="text"
                               id="txtEBRCDated1_EBRCDetails"
                               placeholder="Select Date..." />
                    </div>

                    <div class="field">
                        <label>Amount 1</label>

                        <input type="text"
                               id="txtEBRCAmount1_EBRCDetails"
                               placeholder="Enter Amount..." />
                    </div>

                    <!-- EBRC SET 2 -->

                    <div class="field">
                        <label>EBRC # 2</label>

                        <input type="text"
                               id="txtEBRCNo2_EBRCDetails"
                               placeholder="Enter EBRC No..." />
                    </div>

                    <div class="field">
                        <label>Dated 2</label>

                        <input type="text"
                               id="txtEBRCDated2_EBRCDetails"
                               placeholder="Select Date..." />
                    </div>

                    <div class="field">
                        <label>Amount 2</label>

                        <input type="text"
                               id="txtEBRCAmount2_EBRCDetails"
                               placeholder="Enter Amount..." />
                    </div>

                    <!-- EBRC SET 3 -->

                    <div class="field">
                        <label>EBRC # 3</label>

                        <input type="text"
                               id="txtEBRCNo3_EBRCDetails"
                               placeholder="Enter EBRC No..." />
                    </div>

                    <div class="field">
                        <label>Dated 3</label>

                        <input type="text"
                               id="txtEBRCDated3_EBRCDetails"
                               placeholder="Select Date..." />
                    </div>

                    <div class="field">
                        <label>Amount 3</label>

                        <input type="text"
                               id="txtEBRCAmount3_EBRCDetails"
                               placeholder="Enter Amount..." />
                    </div>

                    <div class="field">
                        <label>Invoice Amount</label>

                        <input type="text"
                               id="txtInvoiceAmount_EBRCDetails"
                               placeholder="Enter Invoice Amount..." />
                    </div>

                    <div class="field">
                        <label>Currency <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtCurrency_EBRCDetails"
                               placeholder="Enter Currency..." />
                    </div>

                    <div class="field">
                        <label>S.B. Number <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtSBNumber_EBRCDetails"
                               placeholder="Enter SB Number..." />
                    </div>

                    <div class="field">
                        <label>S.B. Dated <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtSBDate_EBRCDetails"
                               placeholder="Select SB Date..." />
                    </div>

                    <div class="field">
                        <label>Commission</label>

                        <input type="text"
                               id="txtCommission_EBRCDetails"
                               placeholder="Enter Commission..." />
                    </div>

                    <div class="field">
                        <label>EP Rate</label>

                        <input type="text"
                               id="txtEPRate_EBRCDetails"
                               placeholder="Enter EP Rate..." />
                    </div>

                    <div class="field">
                        <label>Discount</label>

                        <input type="text"
                               id="txtDiscount_EBRCDetails"
                               placeholder="Enter Discount..." />
                    </div>

                    <div class="field">
                        <label>FOB INR</label>

                        <input type="text"
                               id="txtFOBINR_EBRCDetails"
                               placeholder="Enter FOB INR..." />
                    </div>

                    <div class="field">
                        <label>Other Charges</label>

                        <input type="text"
                               id="txtOtherCharges_EBRCDetails"
                               placeholder="Enter Other Charges..." />
                    </div>

                    <div class="field">
                        <label>Frt. INR</label>

                        <input type="text"
                               id="txtFrtINR_EBRCDetails"
                               placeholder="Enter Frt. INR..." />
                    </div>

                    <div class="field">
                        <label>Bank Charges</label>

                        <input type="text"
                               id="txtBankCharges_EBRCDetails"
                               placeholder="Enter Bank Charges..." />
                    </div>

                    <div class="field">
                        <label>FOB INR</label>

                        <input type="text"
                               id="txtFOBINR2_EBRCDetails"
                               placeholder="Enter FOB INR..." />
                    </div>

                    <div class="field">
                        <label>Port Code <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtPortCode_EBRCDetails"
                               placeholder="Enter Port Code..." />
                    </div>

                    <div class="field">
                        <label>FOB F.Cur</label>

                        <input type="text"
                               id="txtFOBFCur_EBRCDetails"
                               placeholder="Enter FOB Foreign Currency..." />
                    </div>

                    <div class="field span-2">
                        <label>E-BRC Remarks <span class="text-danger">*</span></label>

                        <input type="text"
                               id="txtEBRCRemarks_EBRCDetails"
                               placeholder="Enter E-BRC Remarks..." />
                    </div>

                </div>

            </div>

        @* </section> *@

    </div>
</div>

@{
	ViewData["Title"] = "Belk Payment";
	ViewData["Heading"] = "Belk Payment";
}


<div class="bd_mainContainer">
    <div class="page">   
       <section class="card">

    <!-- Header -->
    <div class="card-head">

        <div>
            <span class="tick"></span>
            <h2 class="mt-2" id="txtHeaderMain">
                Belk Payment
            </h2>
        </div>

        <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
            @await Html.PartialAsync("Components/_UploadAndViewButtons")

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="btnSave"
                    title="Save">

                <svg width="14"
                     height="14"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>

                </svg>

                Save
            </button>
                 <button type="button"
                    class="btn btn-primary btn-sm"
                    id="btnAdd">
                ＋ Add
              </button>

            <button type="button"
                    class="btn btn-cancel-custom"
                    id="btnCancel">
                ✕ Cancel
            </button>

        </div>

    </div>

     <div class="card-body">

        <div class="grid cols-6">

            <div class="field">
                    <label class="form-label">Entry No</label>
                    <input type="text"
                           id="txtEntryNo_DutyBillEntry"
                           class="form-input"
                           placeholder="Enter Entry No">
                </div> 
            <div class="field">
                    <label class="form-label">Date</label>
                    <input type="text"
                           id="txtDate_DutyBillEntry"
                           class="form-Flatdate"
                           placeholder="Enter Date">
                </div> 
                <div class="field">
                    <label class="form-label">Buyer Code</label>
                    <input type="text"
                           id="txtBuyerCode_DutyBillEntry"
                           class="form-input"
                           placeholder="Enter Buyer Code">
                </div> 
                <div class="field">
                    <label class="form-label">Buyer Name</label>
                   <select id="ddlBuyerName" class="form-select">
                        <option value="Belk Internation INC" selected>Belk Internation INC</option>
                        <option value="American Eagle">American Eagle</option>

                    </select>
                </div> 
                </div>
        </div>
            </section>

            <section class="card">
                 <div class="card-body">

                     <div class="table-responsive">
                         <table class="table table-hover align-middle table-bordered mb-0"
                           id="tblBelkPyament">

                        <thead class="table-light">
                            <tr>
                                <th style="width:80px;">Action</th>
                                <th>S No</th>
                                <th>Invoice</th>
                                <th>PO NO</th>
                                <th>Quantity</th>
                                <th>Gross Amount</th>
                                <th>Discount</th>
                                <th>Net Amount</th>
                                <th>FCR Dt</th>
                            </tr>
                        </thead>

                        <tbody id="tblbodyBelkPayment">
                            <!-- Rows injected by JavaScript -->
                        </tbody>

                    </table>
                     </div>
                </div>
            </section>
</div>
</div>

        <!-- Open in edit an d add button modal -->

        <div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-xl">
                <div class="modal-content modal-box">

                    <div class="modal-header">
                        <div class="modal-header-text">
                            <div class="modal-title" id="addMenuModalLabel">
                                Edit and Add Modal 
                            </div>
                        </div>
                        <div class="d-flex gap-2">

                            <button type="button"
                                    class="modal-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                                <svg viewBox="0 0 24 24">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="modal-body px-2">
                        @await Html.PartialAsync("_BelkPaymentAdd")
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                id="btnSave">

                            <svg width="14"
                                 height="14"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>

                            </svg>

                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>

		<script src="~/js/pages/banking/belk_payment.js" asp-append-version="true"></script>

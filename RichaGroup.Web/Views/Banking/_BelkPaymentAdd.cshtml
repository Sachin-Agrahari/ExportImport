    <!-- NET AMOUNT -->
    <div class="col-md-4">
        <div class="field">
            <label for="txtNetAmount_BelkPayment" class="form-label">
                Net Amount
            </label>

            <input type="text"
                   id="txtNetAmount_BelkPayment"
                   class="form-control text-end belk-edit-readonly">
        </div>
    </div>


    <!-- FCR DATE -->
    <div class="col-md-4">
        <div class="field">
            <label for="txtFcrDt_BelkPayment" class="form-label">
                FCR Dt
            </label>

            <input type="text"
                   id="txtFcrDt_BelkPayment"
                   class="form-control belk-edit-readonly">

<div class="row g-3">

    <!-- INVOICE -->
    <div class="col-md-4">
        <div class="field">
            <label for="txtInvoice_BelkPayment" class="form-label">
                Invoice
            </label>

            <input type="text"
                   id="txtInvoice_BelkPayment"
                   class="form-control"
                   placeholder="Enter Invoice">
        </div>
    </div>


    <!-- PO NO -->
    <div class="col-md-4">
        <div class="field">
            <label for="txtPoNo_BelkPayment" class="form-label">
                PO No
            </label>

            <input type="text"
                   id="txtPoNo_BelkPayment"
                   class="form-control belk-edit-readonly">
        </div>
    </div>


    <!-- QUANTITY -->
    <div class="col-md-4">
        <div class="field">
            <label for="txtQuantity_BelkPayment" class="form-label">

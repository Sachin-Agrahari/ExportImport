@{
	ViewData["Title"] = "Entry Letter Credit Local";
	ViewData["Heading"] = "Entry Letter Credit Local";
}

<link href="~/css/pages/banking/entry_letter_credit_local.css" rel="stylesheet" asp-append-version="true"/>


<div class="bd_mainContainer">
    <div class="page">

        <section class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">LC Local</h2>
                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnAdd">
                        ＋ Add
                    </button>

                    <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button>

                </div>
            </div>

            <div class="card-body">

                <div class="grid cols-6">
                    <div class="field">
                        <label>Party</label>

                        <input type="text"
                               id="txtParty_LCLocal"
                               placeholder="Enter Party..." />
                    </div>
                    <div class="field">
                        <label>
                            LC No
                            <button id="btnLCHelp" class="help-link">Help</button>
                        </label>

                        <input type="text"
                               id="txtLC_LCLocal"
                               placeholder="Enter LC No..." />
                    </div>
                    <div class="field">
                        <label>Open Date</label>

                        <input type="text"
                               id="txtOpenDate_LCLocal"
                               placeholder="Select Open Date..." />
                    </div>
                    <div class="field">
                        <label>Ship On Date</label>

                        <input type="text"
                               id="txtShipOnDate_LCLocal"
                               class="form-Flatdate"
                               placeholder="Select Ship On Date..." />
                    </div>
                    <div class="field">
                        <label>Bank Charges</label>

                        <input type="text"
                               id="txtbankCharges_LCLocal"
                               placeholder="Enter Bank Charges..." />
                    </div>
                    <div class="field">
                        <label>Bank Charges Date</label>

                        <input type="text"
                               id="txtbankDt_LCLocal"
                               class="form-Flatdate"
                               placeholder="Select Ship On Date..." />
                    </div>
                    <div class="field">
                        <label>Amount</label>

                        <input type="text"
                               id="txtAmt_LCLocal"
                               placeholder="Enter Amount..." />
                    </div>
                    <div class="field">
                        <label>Expiry On Date</label>

                        <input type="text"
                               id="txtExpiryOnDate_LCLocal"
                               placeholder="Select Expiry On Date..." />
                    </div>
                    <div class="field">
                        <label>P. Terms</label>

                        <input type="text"
                               id="txtPTerms_LCLocal"
                               placeholder="Enter P Terms..." />
                    </div>
                    <div class="field span-2">
                        <label>Remark</label>

                        <input type="text"
                               id="txtRemark_LCLocal"
                               placeholder="Enter Remarks..." />
                    </div>
                    <div class="field span-2">
                        <label>In Favour</label>

                        <input type="text"
                               id="txtfavour_LCLocal"
                               placeholder="Enter In Favour..." />
                    </div>

                    @* <div class="d-flex justify-content-start align-items-end">
            <button type="button"
                    class="btn btn-primary btn-sm fs-6"
                    id="btnAdd_LCLocal">
                Add
            </button>
        </div> *@
                </div>
            </div>

        </section>
        
        <section class="card">
            <div class="card-head">
                <div class="d-flex justify-content-end align-items-center w-100 p-1 me-3">
                    <button type="button"
                            class="btn btn-primary btn-sm me-2"
                            id="btnAddNewRecord">
                        Add Record
                    </button>
                    <button type="button"
                            class="btn btn-primary btn-sm me-2"
                            id="btnCopyRecord">
                        Copy
                    </button>
                    <button type="button"
                            class="btn btn-outline-danger btn px-2"
                            id="btnDeleteRecord">
                        Delete
                    </button>
                  
                </div>
            </div>
            <div class="card-body">

                <div class="table-wrap">
                    <table id="tblLCLocal" class="display" style="width:100%">
                        <thead>
                            <tr>
                                 <th>Action</th>
                                <th>Delivery Date</th>
                                <th>Bank Reference No</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment Status</th>
                                <th>Bank Reference Date</th>
                                <th>Bill Due Date</th>
                                <th>Payment Date</th>
                                <th>Amount</th>
                                <th>Debit Amt</th>
                                <th>Consent Req to Bnk</th>
                                <th>Req Date</th>
                                <th>Remark</th>
                                <th>LC Status</th>
                            
                             

                            </tr>
                        </thead>
                        <tbody id="tblbodyLCLocal"></tbody>
                    </table>
                    <div class="d-flex justify-content-end mt-3">

                        <div class="lc-balance-box">

                            <span class="lc-balance-label">
                                Balance
                            </span>

                            <span class="lc-balance-value"
                                  id="lblBalance_LCLocal">
                                1,625,223.00
                            </span>

                        </div>

                    </div>
                </div>
            </div>
        </section>
    
    </div>
</div>




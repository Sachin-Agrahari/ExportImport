<div class="card-body">

    <div class="grid cols-4">

        <!-- Delivery Date -->
        <div class="field">
            <label class="form-label">
                Delivery Date
            </label>

            <input type="text"
                   id="txtDeliveryDate_EntryLetterLocal"
                   class="form-input"
                   placeholder="Select Delivery Date">
        </div>


        <!-- Bank Reference No -->
        <div class="field">
            <label class="form-label">
                Bank Reference No
            </label>

            <input type="text"
                   id="txtBankReferenceNo_EntryLetterLocal"
                   class="form-input"
                   placeholder="Enter Bank Reference No">
        </div>


        <!-- Amount -->
        <div class="field">
            <label class="form-label">
                Amount
            </label>

            <input type="text"
                   id="txtAmount_EntryLetterLocal"
                   class="form-input"
                   placeholder="Enter Amount">
        </div>


        <!-- Bill Due Date -->
        <div class="field">
            <label class="form-label">
                Bill Due Date
            </label>

            <input type="text"
                   id="txtBillDueDate_EntryLetterLocal"
                   class="form-input"
                   placeholder="Select Bill Due Date">
        </div>


        <!-- Payment Date -->
        <div class="field">
            <label class="form-label">
                Payment Date
            </label>

            <input type="text"
                   id="txtPaymentDate_EntryLetterLocal"
                   class="form-input"
                   placeholder="Select Payment Date">
        </div>


        <!-- Consent Req To Bnk -->
        <div class="field">
            <label class="form-label">
                Consent Req To Bnk
            </label>

            <select id="ddlConsentReqToBnk_EntryLetterLocal"
                    class="form-select">

                <option value="">
                    Select
                </option>

                <option value="Yes">Yes</option>
                <option value="No">No</option>

            </select>
        </div>


        <!-- Debit Amt -->
        <div class="field">
            <label class="form-label">
                Debit Amt
            </label>

            <input type="text"
                   id="txtDebitAmt_EntryLetterLocal"
                   class="form-input"
                   placeholder="Enter Debit Amount">
        </div>


        <!-- Status -->
        <div class="field">
            <label class="form-label">
                Status
            </label>

            <select id="ddlStatus_EntryLetterLocal"
                    class="form-select">

                <option value="">
                    Select Status
                </option>

                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>

            </select>
        </div>


        <!-- Payment Status -->
        <div class="field">
            <label class="form-label">
                Payment Status
            </label>

            <select id="ddlPaymentStatus_EntryLetterLocal"
                    class="form-select">

                <option value="">
                    Select Payment Status
                </option>

                <option value="Pending">Pending</option>
                <option value="Received">Received</option>
                <option value="Adjusted">Adjusted</option>

            </select>
        </div>


        <!-- Bank Reference Date -->
        <div class="field">
            <label class="form-label">
                Bank Reference Date
            </label>

            <input type="text"
                   id="txtBankReferenceDate_EntryLetterLocal"
                   class="form-input"
                   placeholder="Select Bank Reference Date">
        </div>


        <!-- Debit Note -->
        <div class="field">

            <label class="form-label d-flex align-items-center gap-2">

                <span>Debit Note</span>

                <span id="spnDebitNoteHelp"
                      role="button"
                      title="Select Debit Note"
                      class="help-link"
                      style="cursor:pointer;">
                    Help
                </span>

            </label>

            <input type="text"
                   id="txtDebitNote_EntryLetterLocal"
                   class="form-input"
                   placeholder="Select Debit Note"
                   readonly>

        </div>


        <!-- Remark -->
        <div class="field span-2">
            <label class="form-label">
                Remark
            </label>

            <input type="text"
                   id="txtRemark_EntryLetterLocal"
                   class="form-input"
                   placeholder="Enter Remark">
        </div>


        <!-- LC Status -->
        <div class="field">
            <label class="form-label">
                LC Status
            </label>

            <select id="ddlLCStatus_EntryLetterLocal"
                    class="form-select">

                <option value="">
                    Select LC Status
                </option>

                <option value="Open">Open</option>
                <option value="Closed">Closed</option>
                <option value="Pending">Pending</option>

            </select>
        </div>

    </div>

</div>
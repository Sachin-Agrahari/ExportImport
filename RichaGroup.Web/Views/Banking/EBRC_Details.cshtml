@{
    ViewData["Title"] = "EBRC Details";
    ViewData["Heading"] = "EBRC Details";
}

<div class="bd_mainContainer">
    <div class="page">
        <!-- EBRC Details -->
        <section class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">EBRC Details</h2>
                </div>


                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                     
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                    <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnAdd">
                    ＋ Add
                         </button>

                    <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button>
                       
                </div>
            </div>
             <div class="card shadow-sm border-0 mt-2">
              <div class="card-body">
 
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-bordered mb-0" id="tblEBRCDetails">
                        <thead class="table-light">
                            <tr> 
                                <th>Action</th>
                                <th>B.O. Exchange</th>
                                <th>Bank Ref. #</th> 
                                <th>Payment Received</th>
                                <th>Payment Type</th>
                                <th>IFSC</th> 
                                <th>Currency</th>
                                <th>S.B. Number</th> 
                                <th>S.B. Dated</th>
                                <th>Port Code</th>
                                <th>E-BRC Remarks</th>
                               
                            </tr>
                        </thead>
                        <tbody id="tblEBRCDetailsbody">
                            <!-- rows injected  -->
                        </tbody>
                    </table>

                    <div id="noRecordsFound_EBRCDetails" class="text-center text-muted py-4 d-none">
                        No matching records found.
                    </div>
                </div>

            </div>
        </div>
            </div>
        </section>

    </div>
</div>



<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">

            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        EBRC Details
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-0">
                @await Html.PartialAsync("_EBRC_Details")
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>

<script src="~/js/pages/banking/ebrc_details.js" asp-append-version="true"></script>
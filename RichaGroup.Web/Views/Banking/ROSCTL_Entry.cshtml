@{
    ViewData["Title"] = "ROSCTL/MEIS/ROSL Entry";
    ViewData["Heading"] = "ROSCTL/MEIS/ROSL Entry";
}

<style>
    .rosctl-summary-card {
        border-color: var(--teal);
        overflow: hidden;
        background: linear-gradient(to bottom, var(--teal) 0%, rgba(119, 172, 240, 0.85) 100%) !important;
    }

    .rosctl-summary-input {
        max-width: 260px;
        border-color: var(--teal);
        color: var(--teal-dark);
        font-weight: 600;
    }

    .rosctl-count,
    .rosctl-value {
        background: var(--bg-white);
        border-color: var(--teal) !important;
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 600;
    }

    .rosctl-value {
        min-height: 28px;
    }

    .rosctl-row-check {
        cursor: pointer;
        width: 16px;
        height: 16px;
        margin: 0;
    }

    .rosctl-license-body {
        max-height: 420px;
        overflow: auto;
    }

    #tblLicenseModal thead th {
        position: sticky;
        top: 0;
        background: #f1f1f1;
        z-index: 1;
        white-space: nowrap;
        font-size: 13px;
    }

    #tblLicenseModal tbody tr {
        cursor: pointer;
    }

        #tblLicenseModal tbody tr:hover {
            background: #eef5ff;
        }

    #tblLicenseModal td,
    #tblROSCTLEntry td {
        white-space: nowrap;
        font-size: 13px;
    }

    #tblROSCTLEntry th {
        white-space: nowrap;
    }

    .rosctl-license-title {
        font-size: 13px;
        color: #555;
        background: #f7f7f7;
        border: 1px solid #ddd;
        padding: 4px 8px;
        margin-bottom: 6px;
    }
</style>

<div class="bd_mainContainer">
    <div class="page">
        <section class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">ROSCTL Entry</h2>
                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                    <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button>

                </div>
            </div>

            <div class="card-body">

                <div class="grid cols-6">
                    <div class="field">
                        <label>FMS</label>

                        <input type="text"
                               id="txtEntryNo_ROSCTLEntry"
                               placeholder="Enter Fms..." />
                    </div>
                    <div class="field">
                        <label>From Date</label>

                        <input type="text"
                               id="txtFromDate_ROSCTLEntry"
                               placeholder="Select From Date..." />
                    </div>
                    <div class="field">
                        <label>To Date</label>

                        <input type="text"
                               id="txtToDate_ROSCTLEntry"
                               placeholder="Select To Date..." />
                    </div>

                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2">
                    <span class="tick"></span>
                    <h4 class="">
                    </h4>
                </div>
                <div class="d-flex justify-content-end align-items-end">

                    <button type="button" style="display:none;" class="btn btn-primary btn-sm" id="btnAddLicense">

                        <svg class="svg-inline--fa fa-plus" data-prefix="fas" data-icon="plus" role="img" viewBox="0 0 448 512" aria-hidden="true" data-fa-i2svg="" width="12" height="12"><path fill="currentColor" d="M256 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 160-160 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l160 0 0 160c0 17.7 14.3 32 32 32s32-14.3 32-32l0-160 160 0c17.7 0 32-14.3 32-32s-14.3-32-32-32l-160 0 0-160z"></path></svg>
                        Tag File
                    </button>

                </div>
                <div class="table-responsive" style="max-height:400px;" >
                    <table id="tblROSCTLEntry" class="display" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:90px !important;">Action</th>

                                <th>Olsbdt</th>
                                <th>2XH</th>
                                <th>A</th>
                                <th>Invno</th>
                                <th>Ent./FinlAmt</th>
                                <th>Dbk_type</th>
                                <th>Senton</th>
                                <th>SB #</th>
                                <th>SB Date</th>
                                <th>Fob_fac</th>
                                <th>Dbk Apld</th>
                                <th>Tr1_d</th>
                                <th>Usd_rt</th>
                                <th>Inramt</th>
                                <th>Leo Dt</th>
                                <th>Ep_date</th>
                                <th>Portcode</th>
                                <th>Fobcf</th>
                                <th>Desti</th>
                                <th>Cntry</th>
                                <th>Hscd</th>
                                <th>Rmgmup</th>
                                <th>Bnkrefno</th>
                                <th>Actl_rlzdt</th>
                                <th>Tr1_a</th>
                                <th>Tr1_b</th>
                                <th>Tr2</th>
                                <th>Fac</th>
                                <th>Buyer</th>
                                <th>Cha</th>
                                <th>Forwarder</th>
                                <th>Writeoff</th>
                            </tr>
                        </thead>
                        <tbody id="tblbodyROSCTLEntry"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="card rosctl-summary-card border-1 rounded-3">

            <div class="p-3">

                <!-- Port -->
                <div class="d-flex align-items-center gap-2 mb-3">

                    <span class="fw-semibold text-nowrap">
                        Port
                    </span>

                    <input type="text"
                           id="txtPort_ROSCTLEntry"
                           value="NHAVA SHEVA (MUMBAI)"
                           readonly
                           class="form-control form-control-sm rosctl-summary-input">

                </div>

                <!-- Header -->
                <div class="row g-2 align-items-center mb-1">
                    <div class="col-md-2"></div>
                    <div class="col-md-2 r num  fw-semibold">Total INR</div>
                    <div class="col-md-2 r num  fw-semibold">Entitlement</div>
                </div>

                <!-- Y -->
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-2">
                        <div class="d-flex align-items-center gap-2 fw-semibold">
                            <span># of cases-Y</span>
                            <b id="lblTotalCasesY_ROSCTLEntry"
                               class="px-2 py-1 border rounded-2 fw-semibold rosctl-count">0</b>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num  px-2 border rounded-2 rosctl-value"
                             id="lblTotalINRY_ROSCTLEntry">
                            0.00
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num  px-2 border rounded-2 rosctl-value"
                             id="lblEntitlementY_ROSCTLEntry">
                            0.00
                        </div>
                    </div>
                </div>

                <!-- N -->
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-md-2">
                        <div class="d-flex align-items-center gap-2 fw-semibold">
                            <span># of cases-N</span>
                            <b id="lblTotalCasesN_ROSCTLEntry"
                               class="px-2 py-1 border rounded-2 fw-semibold rosctl-count">54</b>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num px-2 border rounded-2 rosctl-value"
                             id="lblTotalINRN_ROSCTLEntry">
                            7,82,16,211.85
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num px-2 border rounded-2 rosctl-value"
                             id="lblEntitlementN_ROSCTLEntry">
                            33,58,074.00
                        </div>
                    </div>
                </div>

                <!-- T -->
                <div class="row g-2 align-items-center">
                    <div class="col-md-2">
                        <div class="d-flex align-items-center gap-2 fw-bold">
                            <span># of cases-T</span>
                            <b id="lblTotalCasesT_ROSCTLEntry"
                               class="px-2 py-1 border rounded-2 fw-bold rosctl-count">54</b>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num px-2 border rounded-2 fw-bold rosctl-value"
                             id="lblTotalINRT_ROSCTLEntry">
                            7,82,16,211.85
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="p-1 r num px-2 border rounded-2 fw-bold rosctl-value"
                             id="lblEntitlementT_ROSCTLEntry">
                            33,58,074.00
                        </div>
                    </div>
                </div>

            </div>

        </section>
    </div>
</div>

<!-- TAG LICENSE MODAL -->
<div class="modal fade" id="modalAddLicense" tabindex="-1" aria-labelledby="modalAddLicenseLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalAddLicenseLabel">Tag File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

             @*    <div class="rosctl-license-title">
                    ROSCTL Details F5-To xls Updt, Ctrl+Enter EDIT Entitlement
                </div> *@

                <div class="rosctl-license-body">
                    <table id="tblLicenseModal" class="table table-bordered table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px;" class="text-center">
                                    <input type="checkbox" id="chkLicenseSelectAll" class="rosctl-row-check" title="Select All" />
                                </th>
                                <th>Invno</th>
                                <th>Shipping BillNo</th>
                                <th class="text-end">Amt</th>
                                <th class="text-end">Finl amt</th>
                                <th class="text-end">Inr amt</th>
                                <th>Sent on</th>
                                <th>Filed on</th>
                                <th>File no.</th>
                                <th>Rcvd on</th>
                                <th>Sold on</th>
                            </tr>
                        </thead>
                        <tbody id="tblbodyLicenseModal"></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <span class="me-auto fw-semibold">Selected: <span id="lblLicenseSelectedCount">0</span></span>
                <button type="button" class="btn btn-cancel-custom" data-bs-dismiss="modal">✕ Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnAddSelectedLicense">Tag File</button>
            </div>

        </div>
    </div>
</div>

<script src="~/js/pages/banking/rosctl_entry.js" asp-append-version="true"></script>

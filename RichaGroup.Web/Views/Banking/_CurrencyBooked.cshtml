 

<div class="bd_mainContainer  p-2">
    <div class="page">
 
        <div class="grid cols-4">

            <div class="field">
                <label>Entry Number</label>
                <input type="text" id="txtEntryNo_Add_Currency_Booked" placeholder="Enter Entry Number... " />
            </div>

            <div class="field">
                <label>Company Code</label>
                <input type="text" id="txtCompanyCode_Add_Currency_Booked" placeholder="Enter Company Code... " />
            </div>

            <div class="field">
                <label>Date</label>
                <input type="text" id="txtDate_Add_Currency_Booked" placeholder="Select date..." />
            </div>

            <div class="field">
                <label>For/Monthly</label>
                <input type="text" class="num" id="txtForMonthly_Add_Currency_Booked" placeholder="Enter For Monthly " />
            </div>

            <div class="field">
                <label>AE/PP/UL</label>
                <select id="ddlAEPPUL_Add_Currency_Booked" class="select2-field">
                    <option value="AE">AE</option>
                    <option value="PP">PP</option>
                    <option value="UL">UL</option>               
                               
                </select>
            </div>

            <div class="field">
                <label>from Due Date</label>
                <input type="text" id="txtfromdueDate_Add_Currency_Booked" placeholder="Select form due date..." />
            </div>

            <div class="field">
                <label>To Due Date</label>
                <input type="text" id="txttodueDate_Add_Currency_Booked" placeholder="Select to due date..." />
            </div>

            <div class="field">
                <label>Currency</label> 
                <select id="ddlCurrency_Add_Currency_Booked" class="select2-field">
                    <option value="Dollar">Dollar</option>
                    <option value="INR">INR</option>
                    <option value="Euro">Euro</option>  
                </select>
            </div>
            <div class="field">
                <label>Export/Import</label>
                <select id="ddlCurrency_Add_ExpImp" class="select2-field">
                    <option value="Export">Export</option>
                    <option value="Import">Import</option>
                </select>
            </div>

            <div class="field">
                <label>Buy/Sell</label>
                <select id="ddlCurrency_Add_buysell" class="select2-field">
                    <option value="Buy">Buy</option>
                    <option value="Sell">Sell</option>
                </select>
            </div>

            <div class="field">
                <label>Amount</label>
                <input type="text" id="txtAmunt_Add_Currency_Booked" placeholder="Enter Amount... " />
            </div>

            <div class="field">
                <label>Spot Rate</label>
                <input type="text" id="txtSpotRate_Add_Currency_Booked" placeholder="Enter Spot Rate... " />
            </div>

            <div class="field">
                <label>Prem</label>
                <input type="text" id="txtPrem_Add_Currency_Booked" placeholder="Enter Prem... " />
            </div>

            <div class="field">
                <label>Converstion Rate</label>
                <input type="text" id="txtConverstionRate_Add_Currency_Booked" placeholder="Enter Converstion Rate... " />
            </div>

            <div class="field">
                <label>INR Amount</label>
                <input type="text" id="txtInrAmount_Add_Currency_Booked" placeholder="Enter INR Amount... " />
            </div>

            <div class="field">
                <label>Bank Name</label>
                <input type="text" id="txtbankName_Add_Currency_Booked" placeholder="Enter Bank Name... " />
            </div>
           
            <div class="field">
                <label>Contract Number</label>
                <input type="text" id="txtContractNo_Add_Currency_Booked" placeholder="Enter Contract Number... " />
            </div>

            <div class="field span-2">
                <label>Remark</label>
                <input type="text" id="txtRemark_Add_Currency_Booked" placeholder="Enter Remark... " />
            </div>
           
        </div>
            
    </div>
</div> 
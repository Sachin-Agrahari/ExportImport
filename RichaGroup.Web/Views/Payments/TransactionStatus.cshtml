<div class="modal fade" id="ChekclistModal" tabindex="-1" aria-labelledby="ChekclistModal" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content checklist-modal">
            <div class="modal-header checklist-modal-header">

                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body">
                <div class="row g-3">

                    <div class="col-lg-4 col-md-4 col-12">
                        <div class="card">
                            <div class="card-header px-3 py-2">
                                <div class="fw-semibold text-primary">
                                    Search Parameters
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="checklist-box" id="Search_ParametrsList"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-12">
                        <div class="card">
                            <div class="card-header px-3 py-2">
                            <div class="fw-semibold text-primary">
                                Search Values
                            </div>
                            </div>

                            <div class="card-body">
                                <div class="checklist-box" id="Search_ValuesList"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-12">
                        <div class="card">
                            <div class="card-header px-3 py-2">
                                <div class="fw-semibold text-primary">
                                Added Search Values
                            </div>
                            </div>

                            <div class="card-body">
                                <div class="checklist-box" id="Added_Search_ValuesList"></div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row mt-3 d-flex justify-content-center align-content-center">
                    <div class="col-1">
                        <button class="btn btn-primary btn-sm" id="btnExecute">
                            Execute
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script type="module" src="~/js/pages/import/transactionstatus.js" asp-append-version="true"></script>


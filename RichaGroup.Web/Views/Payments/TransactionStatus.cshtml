@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* <link href="~/css/pages/Payments/TransactionStatus.css" rel="stylesheet" asp-append-version="true" /> *@

<div class="bd_mainContainer" id="route-transaction-status">

    <div class="page">

        <section class="card">

            <!-- HEADER -->
            <div class="card-head">

                <div class="d-flex flex-row " style="width: auto;">

                    <h2 class="mt-2" id="txtHeaderMain">Advance Licensce</h2>
                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button class="btn btn-primary btn-sm d-flex flex-row align-center justify-content-center" title="Add" id="btnAdd">
                        <span>Add</span>
                    </button>
                    <button class="btn btn-primary btn-sm d-flex flex-row align-center justify-content-center" title="Save" id="btnSave">

                        <img src="~/assets/icon/save.svg" alt="save-icon" class="w-75 h-75 mt-1 me-1 white-icon" />
                        <span>Save</span>
                    </button>
                    <button class="btn-outline-danger d-flex flex-row align-center justify-content-center" title="clr" id="btnDelete">

                        <img src="~/assets/icon/refresh.svg" alt="refresh-icon" class="w-50 h-50 me-1 white-icon" />
                        <span>CLR</span>
                    </button>

                    
                    <button class="btn btn-secondary btn-sm  d-flex flex-row align-center justify-content-center" title="Print" id="btnPrint">

                        <img src="~/assets/icon/print.svg" alt="print-icon" class="w-75 h-75 mt-1 me-1 white-icon" />
                        <span>Print</span>
                    </button>
                   
                </div>
            </div>

            <div class="card-body">
                <div class="grid cols-6">
                    <div class="field">
                        <label class="form-label">Full Use</label>
                        <select id="ddlSearchCategory" class="form-select">
                            <option value="">Select Category</option>
                            <option value="A">ACCESSORY</option>
                            <option value="F">FABRIC</option>
                            <option value="M">MACHINE</option>
                        </select>
                      </div>
                    <div class="field">
                        <label class="form-label">Company</label>
                        <select id="ddlCurrency" class="form-select">
                            <option value="1">All</option>
                            <option value="2">RICHACO EXPORTS PRIVATE LIMOTED (GURUGRAM)</option>
                            <option value="3">RICHACO EXPORTS PRIVATE LIMOTED (GURUGRAM)</option>
                            <option value="4">RICHACO EXPORTS PRIVATE LIMOTED (GURUGRAM)</option>
                        </select>
                      </div>
                    <div class="field">
                        <label class="form-label">Dates Search</label>
                        <select id="ddlDatesSerach" class="form-select">
                            <option value="COPMLETE">COPMLETE</option>
                            <option value="DEPT I">DEPT I</option>
                            <option value="DEPT II">DEPT II</option>
                            <option value="DEPT III">DEPT III</option>
                            <option value="DEPT IV">DEPT IV</option>
                            <option value="DEPT V">DEPT V</option>
                        </select>
                      </div>
                    <div class="field">
                        <label class="form-label">Order Search</label>
                        <select id="ddlOrderSearch" class="form-select">
                            <option value="BOTH">BOTH</option>
                            <option value="CLEARED">CLEARED</option>
                            <option value="UNCLEARED">UNCLEARED</option>

                        </select>
                      </div>
                    <div class="field mt-3">
                        <div class="border border-primary-subtle bg-primary bg-opacity-10 rounded p-2">
                            <div class="form-check d-flex align-items-center gap-2 mb-0">

                                <input type="checkbox"
                                       id="chkAllCompany"
                                       class="form-check-input w-auto m-0 flex-shrink-0">

                                <label for="chkAllCompany"
                                       class="form-check-label mb-0">
                                    All Company
                                </label>

                            </div>
                        </div>
                    </div>

                    <div class="field mt-3">
                        <div class="border border-primary-subtle bg-primary bg-opacity-10 rounded p-2">
                            <div class="form-check d-flex align-items-center gap-2 mb-0">
                                <input type="checkbox" id="chkAllUnit" class="form-check-input w-auto m-0 flex-shrink-0" />
                                <label for="checkbox-Bond" class="form-check-label mb-0">All Unit</label>
                            </div>
                        </div>
                     </div>
                    <div class="field mt-3">
                        <button class="btn btn-primary btn-sm" id="btnSerach">
                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 width="18"
                                 height="18">
                                <circle cx="11" cy="11" r="7"></circle>
                                <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                            </svg>
                            SEARCH
                        </button>
                     </div>


                </div>
            </div>
         </section>

         <section class="card">
            <div class="card-body">
                <div class="table-wrap">
                    <table class="table-component table-component--bordered">
                        <thead>
                            <tr>
                                <th>BLANK</th>
                                <th>SRNO$</th>
                                <th>CHANAME</th>
                                <th>CHADATE</th>
                                <th>FORWARDERNV</th>
                                <th>VENDOR</th>
                                <th>CI NO</th>
                                <th>CI DT. #</th>
                                <th>CIAMOUT$</th>
                                <th>CURRENCY</th>
                                <th>IMPORTDUTY$</th>
                                <th>CTRN$</th>
                                <th>CRTNWEIGHT$</th>
                                <th>SHIPMODE</th>
                                <th>FOB</th>
                                <th>AWB</th>
                                <th>AWBDATE#</th>
                                <th>HAWB</th>
                                <th>HAWBDT#</th>
                                <th>DEPT STATUS</th>
                                <th>DEPTDATE#</th>
                                <th>SNO</th>
                                <th>USERNAME</th>
                                <th>COMPANY</th>
                                <th>UNIT</th>
                            </tr>
                        </thead>

                        <tbody id="tblBody">
                            <tr>
                                <td style="font-size:1rem; font-weight:bold; color:red; text-align:center" colspan="24"> Data Not Found</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
         </section>
    </div>


@section Styles {
    <style>

        /* =========================================================
                   RICHA GROUP DASHBOARD
                   Bootstrap 5 + Minimal Custom CSS
                   ========================================================= */

        :root {
            --rg-blue: #257def;
            --rg-blue-dark: #155fc2;
            --rg-bg: #f4f6fa;
            --rg-text: #16233a;
            --rg-muted: #7c8ba1;
            --rg-border: #e3e9f2;
            --rg-sales: #ff777d;
            --rg-freight: #a767d9;
            --rg-advance: #5c87f5;
            --rg-drawback: #edb253;
            --rg-cl: #55adbd;
            --rg-docs: #7778e9;
            --rg-redemption: #e6a04c;
            --rg-negotiated: #65c0d0;
        }

        /* =========================================================
                   PAGE
                   ========================================================= */

        .dashboard-page {
            width: 100%;
            min-height: 100%;
            padding: 16px;
            background: var(--rg-bg);
            color: var(--rg-text);
            font-family: "Segoe UI", Calibri, Arial, sans-serif;
        }

        /* =========================================================
                   HEADER
                   ========================================================= */

        .dashboard-header {
            background: #fff;
            border: 1px solid var(--rg-border) !important;
            border-radius: 12px !important;
        }

        .dashboard-breadcrumb {
            margin-bottom: 4px;
            color: #8995a8;
            font-size: 11px;
        }

            .dashboard-breadcrumb span {
                margin: 0 6px;
                color: #c0c8d3;
            }

        .dashboard-header{
            margin-left:0px !important;
        }

        .dashboard-title {
            margin: 0;
            color: var(--rg-text);
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -.2px;
        }

        .dashboard-action,
        .dashboard-upload,
        .dashboard-select {
            height: 36px;
            font-size: 12px;
        }

        .dashboard-action {
            border-color: #dce4ee;
            color: #52647d;
            background: #fff;
        }

            .dashboard-action:hover {
                border-color: var(--rg-blue);
                color: var(--rg-blue);
                background: #f7faff;
            }

        .dashboard-upload {
            min-width: 100px;
            background: var(--rg-blue);
            border-color: var(--rg-blue);
        }

            .dashboard-upload:hover {
                background: var(--rg-blue-dark);
                border-color: var(--rg-blue-dark);
            }

        .dashboard-select {
            width: 160px;
            border-color: #dce4ee;
            color: #52647d;
        }

        /* =========================================================
                   DASHBOARD CARD
                   ========================================================= */

        .dashboard-card {
            display: flex;
            width: 100%;
            height: 100%;
            min-width: 0;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--rg-border);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(22, 35, 58, .05);
            transition: box-shadow .2s ease;
        }

            .dashboard-card:hover {
                box-shadow: 0 5px 16px rgba(22, 35, 58, .08);
            }

        /* =========================================================
                   COLORED RAIL
                   ========================================================= */

        .dashboard-card-rail {
            display: flex;
            flex: 0 0 42px;
            width: 42px;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0 10px;
            color: #fff;
            background: var(--rail-color);
        }

        .rail-title {
            display: flex;
            flex: 1;
            align-items: center;
            justify-content: center;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .05em;
            text-align: center;
            white-space: nowrap;
        }

        .rail-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: rgba(255, 255, 255, .28);
            font-size: 13px;
        }

        /* =========================================================
                   CARD BODY
                   ========================================================= */

        .dashboard-card-body {
            display: flex;
            flex: 1;
            min-width: 0;
            flex-direction: column;
        }

        /* =========================================================
                   CARD TITLE
                   ========================================================= */

        .dashboard-card-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            min-height: 40px;
            padding: 0 16px;
            border-bottom: 1px solid var(--rg-border);
            background: #fff;
        }

            .dashboard-card-title h2 {
                margin: 0;
                color: var(--rg-text);
                font-size: 15px;
                font-weight: 700;
                letter-spacing: -.2px;
            }

            .dashboard-card-title small {
                flex-shrink: 0;
                color: var(--rg-muted);
                font-size: 10px;
                white-space: nowrap;
            }

        /* =========================================================
                   TABLE
                   ========================================================= */

        .dashboard-table {
            width: 100%;
            min-width: 0;
            margin-bottom: 0;
            color: #475569;
            font-size: 12px;
            white-space: nowrap;
        }

            .dashboard-table thead th {
                padding: 9px 11px;
                background: var(--rg-blue);
                color: #fff;
                border: 1px solid #d9e4f2;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .03em;
                vertical-align: middle;
            }

            .dashboard-table tbody td {
                padding: 7px 11px;
                color: #2563c7;
                border-color: #e9eef5;
                font-variant-numeric: tabular-nums;
                vertical-align: middle;
            }

                .dashboard-table tbody td:first-child {
                    color: #475569;
                    font-variant-numeric: normal;
                }

            /* Alternating rows */
            .dashboard-table tbody tr:nth-child(even) {
                background: #fafcff;
            }

            /* Hover */
            .dashboard-table.table-hover > tbody > tr:hover > * {
                background-color: #f0f6ff;
            }

            /* Total */
            .dashboard-table .total-row td {
                background: #edf5ff;
                color: #1454a4;
                font-weight: 700;
                border-top: 1px solid #d9e8fb;
            }

            /* Expand column */
            .dashboard-table .expand-col {
                width: 28px;
                min-width: 28px;
                text-align: center;
            }

        /* =========================================================
                   RAIL COLORS
                   ========================================================= */

        .card-sales {
            --rail-color: var(--rg-sales);
        }

        .card-freight {
            --rail-color: var(--rg-freight);
        }

        .card-advance {
            --rail-color: var(--rg-advance);
        }

        .card-drawback {
            --rail-color: var(--rg-drawback);
        }

        .card-cl {
            --rail-color: var(--rg-cl);
        }

        .card-docs {
            --rail-color: var(--rg-docs);
        }

        .card-redemption {
            --rail-color: var(--rg-redemption);
        }

        .card-negotiated {
            --rail-color: var(--rg-negotiated);
        }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 991.98px) {

            .dashboard-page {
                padding: 12px;
            }

            .dashboard-title {
                font-size: 17px;
            }

            .dashboard-card-title h2 {
                font-size: 14px;
            }
        }

        @@media (max-width: 575.98px) {

            .dashboard-page {
                padding: 10px;
            }

            .dashboard-header .col-auto {
                width: 100%;
            }

            .dashboard-header .d-flex {
                flex-wrap: wrap;
            }

            .dashboard-action,
            .dashboard-select,
            .dashboard-upload {
                flex: 1;
            }

            .dashboard-select {
                width: auto;
            }

            .dashboard-card-rail {
                flex-basis: 36px;
                width: 36px;
            }

            .dashboard-card-title {
                min-height: 50px;
                padding: 0 12px;
            }

                .dashboard-card-title h2 {
                    font-size: 13px;
                }

                .dashboard-card-title small {
                    font-size: 9px;
                }

            .dashboard-table {
                font-size: 11px;
            }

                .dashboard-table thead th,
                .dashboard-table tbody td {
                    padding: 8px 9px;
                }
        }

    </style>
}

<!-- =========================================================
     DASHBOARD PAGE
     ========================================================= -->

<div class="dashboard-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="dashboard-header card border-0 shadow-sm mb-3">

        <div class="card-body py-2 px-3">

            <div class="row align-items-center g-2">

                <div class="col">
                     
                    <h1 class="dashboard-title">
                        Dashboard
                    </h1>

                </div>

                <div class="col-auto">

                    <div class="d-flex align-items-center gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm dashboard-action">

                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Reset all values</span>

                        </button>

                        <select class="form-select form-select-sm dashboard-select">

                            <option>Figure in: Actual</option>
                            <option>Figure in: Thousands</option>
                            <option>Figure in: Lakhs</option>

                        </select>

                        <button type="button"
                                class="btn btn-primary btn-sm dashboard-upload">

                            <i class="bi bi-upload"></i>
                            Upload

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         DASHBOARD CARDS
         ===================================================== -->

    <div class="row g-3">


        <!-- =================================================
             SALES
             ================================================= -->

        <div class="col-xl-4 col-lg-6 col-12">

            <section class="dashboard-card card-sales">

                <div class="dashboard-card-rail">

                    <span class="rail-title">
                        SALES
                    </span>

                    <span class="rail-icon">
                        <i class="bi bi-receipt"></i>
                    </span>

                </div>

                <div class="dashboard-card-body">

                    <div class="dashboard-card-title">

                        <h2>Sales</h2>

                        <small>Yearly Overview</small>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-sm table-hover dashboard-table">

                            <thead>

                                <tr>
                                    <th>Sales</th>
                                    <th>RC</th>
                                    <th>Total</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in salesData)
                                {
                                    <tr class="@(item.Label == "Current Year" ? "total-row" : "")">

                                        <td>@item.Label</td>
                                        <td>@item.RC</td>
                                        <td>@item.Total</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </div>


        <!-- =================================================
             FREIGHT
             ================================================= -->

        <div class="col-xl-4 col-lg-6 col-12">

            <section class="dashboard-card card-freight">

                <div class="dashboard-card-rail">

                    <span class="rail-title">
                        FREIGHT
                    </span>

                    <span class="rail-icon">
                        <i class="bi bi-truck"></i>
                    </span>

                </div>

                <div class="dashboard-card-body">

                    <div class="dashboard-card-title">

                        <h2>Freight</h2>

                        <small>Year Wise</small>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-sm table-hover dashboard-table">

                            <thead>

                                <tr>
                                    <th class="expand-col"></th>
                                    <th>Freight</th>
                                    <th>RC</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in freightData)
                                {
                                    <tr>

                                        <td class="expand-col">›</td>
                                        <td>@item.Label</td>
                                        <td>@item.RC</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </div>


        <!-- =================================================
             ADVANCE REALISATION
             ================================================= -->

        <div class="col-xl-4 col-lg-6 col-12">

            <section class="dashboard-card card-advance">

                <div class="dashboard-card-rail">


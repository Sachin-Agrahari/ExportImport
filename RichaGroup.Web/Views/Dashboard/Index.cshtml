                                        <td class="expand-col">
                                            @(item.Label == "Total" ? "" : "›")
                                        </td>

                                        <td>@item.Label</td>
                                        <td>@item.RC</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </div>


        <!-- =================================================
             PENDING FOR REDEMPTION
             ================================================= -->


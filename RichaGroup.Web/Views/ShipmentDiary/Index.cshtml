@{
	ViewData["Title"] = "Shipment Diary";
}
<style>

	.screen {
		display: none
	}

		.screen.on {
			display: block
		}
</style>

<div class="card">
	<div class="card-head">
		<div class="screen-switch" role="tablist" aria-label="Demo screens">

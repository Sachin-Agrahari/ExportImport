<!-- ════════ SCREEN 2 &middot; Shipment diary (tabbed) ════════ -->
<div class="screen" id="screen-diary">

	<!-- Consignment header -->
	<section class="card">

		<div class="card-head">
			<div>
				<span class="tick"></span>
				<h2 class="mt-2">Shipment Diary <span class="chip">Lot 910</span></h2>
			</div>

			<div class="d-flex gap-2">
				<button type="button" class="btn btn-primary btn-sm" id="btnSave_ShipmentDiary" title="Save">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
						 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
						<polyline points="17 21 17 13 7 13 7 21"></polyline>
						<polyline points="7 3 7 8 15 8"></polyline>
					</svg>
					Save
				</button>

				<button id="btnPlanning_ShipmentDiary" class="btn btn-outline btn-sm" onclick="openModal('m-planning')">Shipment Planning &#8599;</button>

				<button type="button" class="btn btn-cancel-custom" id="btnAbort_ShipmentDiary">✕ Abort</button>
			</div>
		</div>

		<div class="card-body">
			<div class="grid cols-8">

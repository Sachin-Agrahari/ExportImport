<!-- Merge Lot Details -->
<div class="grid cols-4">

    <div class="field">
        <label class="form-label">Lot No</label>
        <input type="text"
               id="txtLotNo"
               class="form-input"
               placeholder="Enter Lot No ...">
    </div>

    <div class="field">
        <label class="form-label">Mode</label>
        <select id="ddlMode" class="form-select">
            <option value="Air">Air</option>
            <option value="Ship">Ship</option>
            <option value="Road">Road</option>
        </select>
    </div>

    <div class="field">
        <label class="form-label">Buyer</label>
        <select id="ddlBuyer" class="form-select">
            <option value="ABERCROMBIE & FITCH TRADING" selected>
                ABERCROMBIE & FITCH TRADING
            </option>
            <option value="ABERCROMBIE">ABERCROMBIE</option>
            <option value="American Eagale">American Eagale</option>
        </select>
    </div>

    <div class="field">
        <label class="form-label">Terms</label>
        <input type="text"
               id="txtTerms"
               class="form-input"
               placeholder="Enter Terms ...">
    </div>

    <div class="field">
        <label class="form-label">CHA</label>
        <input type="text"
               id="txtCHA"
               class="form-input"
               placeholder="Enter CHA...">
    </div>

    <div class="field">
        <label class="form-label">Port Of Loading</label>
        <input type="text"
               id="txtportLoading"
               class="form-input"
               placeholder="Enter Port Loading...">
    </div>

    <div class="field">
        <label class="form-label">Forwarder</label>
        <select id="ddlForwader" class="form-select">
            <option value="Expo Freight Pvt Ltd(Delhi)" selected>
                Expo Freight Pvt Ltd(Delhi)
            </option>
            <option value="ABERCROMBIE">ABERCROMBIE</option>
            <option value="American Eagale">American Eagale</option>
        </select>
    </div>

    <div class="field">
        <label class="form-label">Port Of Discharge</label>
        <select id="ddlportdischarge" class="form-select">
            <option value="Columbus" selected>Columbus</option>
            <option value="UK">UK</option>
            <option value="America">America</option>
        </select>
    </div>

</div>
<hr>


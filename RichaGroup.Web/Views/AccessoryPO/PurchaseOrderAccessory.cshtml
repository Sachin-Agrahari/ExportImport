@{
	bool isGeneral = ViewBag.isGeneral;
	bool isSampling = ViewBag.isSampling;
	bool isProduction = ViewBag.isProduction;
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.card-body {
		padding: 5px 22px 11px !important;
	}
</style>

<div class="bd_mainContainer" id="route-po" data-po-type="@ViewBag.PoType">

	<div class="page">

		<section class="card">

			<!-- HEADER -->
			<div class="card-head">

				<div class="d-flex flex-row " style="width: auto;">

					<h2 class="mt-2" id="txtHeaderMain">@(ViewBag.Title)</h2>
				</div>

				<div class="d-flex gap-2">

					<div class="d-flex gap-2">
						<span id="headerMode" class="badge rounded-pill text-bg-warning text-white p-auto m-auto fs-6">
							Edit Mode
						</span>

						<span id="headerStatusBadge" class="badge rounded-pill text-bg-success p-auto m-auto fs-6">
							Fresh
						</span>
						<div class="d-flex gap-2">
							@await Html.PartialAsync("Components/_CheckBoxComponent")
							@await Html.PartialAsync("Components/_UploadAndViewButtons")
						</div>

						<!-- ADD -->
						<button type="button"
								class="btn btn-primary btn-sm "
								title="Add">

							<svg width="17" height="17"
								 viewBox="0 0 24 24"
								 fill="none"
								 stroke="currentColor"
								 stroke-width="2"
								 stroke-linecap="round"
								 stroke-linejoin="round">

								<path d="M12 5v14" />
								<path d="M5 12h14" />

							</svg>

							<span>Add</span>
						</button>


						<!-- EDIT -->
						<button type="button"
								class="btn btn-primary btn-sm"
								title="Edit">

							<svg width="17" height="17"
								 viewBox="0 0 24 24"
								 fill="none"
								 stroke="currentColor"
								 stroke-width="2"
								 stroke-linecap="round"
								 stroke-linejoin="round">

								<path d="M12 20h9" />
								<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />

							</svg>

							<span>Edit</span>
						</button>


						<!-- SAVE -->
						<button type="button"
								class="btn btn-primary btn-sm"
								title="Save">

							<svg width="17" height="17"
								 viewBox="0 0 24 24"
								 fill="none"
								 stroke="currentColor"
								 stroke-width="2"
								 stroke-linecap="round"
								 stroke-linejoin="round">

								<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" />
								<polyline points="17 21 17 13 7 13 7 21" />
								<polyline points="7 3 7 8 15 8" />

							</svg>

							<span>Save</span>
						</button>


						<!-- PRINT -->
						<button type="button"
								class="btn btn-primary btn-sm"
								title="Print">

							<svg width="17" height="17"
								 viewBox="0 0 24 24"
								 fill="none"
								 stroke="currentColor"
								 stroke-width="2"
								 stroke-linecap="round"
								 stroke-linejoin="round">

								<polyline points="6 9 6 2 18 2 18 9" />
								<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
								<rect x="6" y="14" width="12" height="8" />

							</svg>

							<span>Print</span>
						</button>


					

					</div>

				</div>

			</div>
			<div class="card-body">

				<div class="grid cols-6">

					<div class="field">
						<label for="accessoryModeSelect" class="form-label">Acessory</label>
						<select id="accessoryModeSelect" class="form-select">

							@{
								if (isGeneral)
								{
									<option value="General">General</option>
									<option value="Production">Production</option>
								}
								else
								{
									<option value="Grey">Grey</option>
									<option value="process">Process</option>
								}
							}

						</select>
					</div>
					@{
						if (!isGeneral)
						{
							<div class="field">
								<label for="purchaseTypeSelect" class="form-label">Purchase Type:</label>
								<select id="purchaseTypeSelect" class="form-select">
									<option value="imported">Imported</option>
									<option value="local">Local</option>
									@* <option value="indent">Indent</option> *@
								</select>
							</div>
						}
					}

					<div class="field">
						<label for="statusSelect" class="form-label">Status:</label>

						<select id="statusSelect" class="form-select">
							<option value="fresh" selected>Fresh</option>
							<option value="process">Re Processing</option>
						</select>
					</div>

					<div class="field"></div>
					<div class="field"></div>
					<div style="margin-left:auto;display:flex;gap:6px;align-items:right;">
						<button class="btn btn-primary d-flex align-items-center justify-content-start p-2" id="btnImportDetails">
							<img src="~/assets/icon/import.svg" class="white-icon" />
							<span class="mt-0">  Import Details </span>
						</button>
					</div>
				</div>

				<hr class="my-3 mt-3 rounded-4 text-primary">

				<div class="grid cols-6 mt-0">
					<div class="col-12" style="margin-top:-5px">
						<div class="gap-1 d-flex align-items-center justify-content-start">
							<input type="checkbox" id="checkbox-PoNo" />
							<label class="form-label">PO No. <span class="text-danger">*</span></label>
						</div>

						<div class="field">
							<input type="text" id="poNumber" class="form-control" value="PI26-00889" readonly />
						</div>
					</div>

					<div class="field">
						<label for="importPoNumber" class="form-label">Import PO No.</label>
						<input type="text" id="importPoNumber" class="form-control" placeholder="Enter Import PO No...." />
					</div>
					<div class="field">
						<label for="orderDate" class="form-label">
							Order Date
							<span class="text-danger">*</span>
						</label>
						<input type="text" id="orderDate" class="form-control form-Flatdate" placeholder="Select Order Date..." />
					</div>
					<div class="field">
						<label for="vendorSelect" class="form-label">
							Vendor
							<span class="text-danger">*</span>
						</label>
						<select id="vendorSelect" class="form-select">
							<option value="">— Select Vendor —</option>
							<option value="1">SUDARSHAN BOOK DISTRIBUTORS (N)</option>
							<option value="2">ORIENT ACCESSORIES LTD</option>
							<option value="3">METRO GARMENT SUPPLIERS</option>
							<option value="4">NATIONAL TEXTILE CORP</option>
						</select>
					</div>
					<div class="field">
						<label for="ReqSelect" class="form-label">
							Req No
							<span class="text-danger">*</span>
						</label>

						<select id="ReqSelect" class="form-select">
							<option value="">4556</option>
							<option value="1">54345</option>
							<option value="2">2356</option>
							<option value="3">3789</option>
							<option value="4">43647</option>
						</select>
					</div>
					<div class="col-2 addButton">
						@{
							if (!isGeneral)
							{
								<button class="btn btn-primary btn-sm mt-3 pt-1" id="btnQueryExe">
									Execute
								</button>
							}
							// else
							// {
							// 	<div class="card-header-right-group">
							// 		<button class="btn btn-primary  d-flex flex-row align-center justify-content-center mt-4 pt-2" id="btnAddItemInline">
							// 			<img src="~/assets/icon/plus.svg" class="white-icon" />
							// 			Add
							// 		</button>
							// 	</div>
							// }
						}

					</div>
				</div>


				<hr class="my-3 mt-3 rounded-4 text-primary">

				<div class="grid cols-6">
					<div class="field">
						<label for="deliveryDate" class="form-label">Delivery Date <span class="text-danger">*</span></label>
						<input type="text" id="deliveryDate" class="form-control form-Flatdate"
							   placeholder="Select delivery date..." />
					</div>
					<div class="field">
						<label for="endDate" class="form-label">End Date</label>
						<input type="text" id="endDate" class="form-control form-Flatdate"
							   placeholder="Select End date..." />
					</div>
					<div class="field">
						<label for="txtRate" class="form-label">Rate</label>
						<input type="text" id="txtRate" class="form-control"
							   placeholder="Enter Rate...." />
					</div>
					<div class="field">
						<label for="poCoordinatorSelect" class="form-label">PO Coordinator <span class="text-danger">*</span></label>
						<select id="poCoordinatorSelect" class="form-select">
							<option value="kapil">KAPIL</option>
							<option value="rahul">RAHUL</option>
							<option value="priya">PRIYA</option>
							<option value="amit">AMIT</option>
						</select>
					</div>
					<div class="field">
						<label for="deliveryUnitSelect" class="form-label">Delivery At (Unit) <span class="text-danger">*</span></label>
						<select id="deliveryUnitSelect" class="form-select">
							<option value="unit239">UNIT-239</option>
							<option value="unit101">UNIT-101</option>
							<option value="unit145">UNIT-145</option>
							<option value="unit302">UNIT-302</option>
						</select>
					</div>
					<div class="field">
						<label for="ddlconcern_Person" class="form-label">Concern Person<span class="text-danger">*</span></label>
						<select id="ddlconcern_Person" class="form-select">
							<option value="akash">Akash</option>
							<option value="sachine">Sachine</option>
							<option value="nkhil">Nikhil</option>
							<option value="aman">Aman</option>
						</select>
					</div>

				</div>


			</div>

		</section>

		<section class="card">
			<div class="card-head">

				<div>
					<span class="tick"></span>
					<h2 class="mt-2">PO Acessory Details</h2>
				</div>

				<div class="d-flex gap-2">

					@{

						if (isGeneral || isSampling)
						{
							if (!isSampling)
							{
								<button type="button" class="btn btn-primary btn-sm" title="Add">
									<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 5v14" />
										<path d="M5 12h14" />
									</svg>
									<span>Add</span>
								</button>
								
							}
							

							<button type="button" class="btn btn-primary btn-sm" title="@(isGeneral ? "Copy" : "Copy Row")">
								<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 5v14" />
									<path d="M5 12h14" />
								</svg>
								<span>Copy</span>
							</button>

							<button type="button" class="btn btn-primary btn-sm" title="@(isGeneral ? "Delete" : "Delete Row")">
								<span>Delete</span>
							</button>

							<button type="button" class="btn btn-primary btn-sm" title="Refresh">
								@if (isGeneral)
								{
									<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 11a9 9 0 1 1 2.64 6.36" />
										<polyline points="3 3 3 11 11 11" />
									</svg>
								}
								<span>Refresh</span>
							</button>
						}
						else if (isProduction)
						{
							
							<button class="btn btn-primary btn-sm" id="btnBuyerPO">Buyer PO</button>
							<button type="button" class="btn btn-primary btn-sm" id="btnCopySupplier" title="Copy Supplier"><span>Copy Supplier</span></button>
							<button type="button" class="btn btn-primary btn-sm" id="btnCopyZero" title="Copy Zero"><span>Copy Zero</span></button>
							<button class="btn btn-primary btn-sm d-flex flex-row align-center justify-content-center" id="btnInstruction">
								<img src="~/assets/icon/info.svg" alt="info" class="white-icon me-1" />
								<span>Instruction</span>
							</button>
							<button type="button" class="btn btn-primary btn-sm" id="btnCopyQty" title="Copy Qty"><span>Copy Qty</span></button>
							<button type="button" class="btn btn-primary btn-sm" id="btnCopy" title="Copy"><span>Copy</span></button>
						}
					}

					<button type="button" id="btnSummaryChecker" class="btn btn-primary btn-sm" title="View">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 5v14" />
							<path d="M5 12h14" />
						</svg>
						<span>Summary Checker</span>
					</button>
				</div>
			</div>

			<div class="card-body">
				<div class="table-wrap">

					@{
						// Dynamic string variables for Target IDs
						string tableId = isGeneral ? "poTableGeneral" : (isSampling ? "poTableSampling" : "poTableProduction");
						string selectAllId = isGeneral ? "selectAllGeneral" : (isSampling ? "selectAllSampling" : "selectAllProduction");
						string bodyId = isGeneral ? "tableBodyGeneral" : (isSampling ? "tableBodySampling" : "tableBodyProduction");
					}

					<table id="@tableId" class="display table-design" style="width:100%">
						<thead>
							<tr>
								<th class="text-center">
									<input type="checkbox" id="@selectAllId" />
								</th>
								<th>Accessory</th>
								<th>Type</th>
								<th>Size</th>
								<th>Colour</th>

								@if (isGeneral)
								{
									<th class="td-number">Order Qty</th>
									<th class="td-number">Rate</th>
									<th>UOM</th>
									<th>Delivery Date</th>
									<th class="td-number">Current Qty</th>
									<th>Remarks</th>
									<th>Style</th>
									<th>Item Supplier</th>
									<th>Acc Alias</th>
									<th>Type Alias</th>
									<th>Colour Alias</th>
									<th>Key#</th>
								}
								else if (isSampling || isProduction)
								{
									
									<th class="td-number">Total Required Qty</th>
									<th class="td-number">Current Po</th>
									<th>Delivery Date</th>
									<th class="td-number">Rate</th>
									<th class="td-number">Req No</th>
									<th class="td-number">Uom</th>

									@if (isProduction)
									{
										<th>Buyers</th>
									}

									<th>Style</th>

									@if (isProduction)
									{
										<th>Remark</th>
									}

									<th class="">Po Already</th>
									@* <th class="td-number">Po Already</th> *@
									<th class="td-number">Po to be Made</th>
									<th class="td-number">Extra %</th>
									<th class="td-number">Extra Qty</th>
									<th>Process</th>

									@if (isSampling)
									{
										<th>Remarks</th>
									}

									@* <th>Lsize</th>
									<th>Width</th>
									<th>Process</th>
									<th>With Fab Process</th>
									<th>U</th>
									<th>Fabric to issue</th>
									<th>Fabric</th>
									<th>Print</th>
									<th>Colour</th>
									<th>Quality</th>
									<th class="td-number">Qty</th>
									<th class="td-number">Shrink(%)</th>						
									<th>Remarks</th> *@
									<th>Issue Supplier</th>

									@if (isSampling)
									{
										<th>Buyer</th>
									}

									<th>Item Supplier</th>
									<th>Req No.</th>
									<th>Import Accessory</th>
									<th>Import Type</th>
									<th>Import Size</th>
									<th>Import Colour</th>
									<th>PO Desc</th>

									@if (isProduction)
									{
										<th>Supplier Item Code</th>
									}
								}
							</tr>
						</thead>
						<tbody id="@bodyId"></tbody>
					</table>
				</div>
			</div>
		</section>
	</div>
</div>



@if (isGeneral)
{


	<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalTitle" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content modal-box">
				<div class="modal-header">
					<div class="modal-header-text">
						<div class="modal-title" id="addItemModalTitle">
							Add Accessory
						</div>
					</div>

					<div class="app-modal-header-actions">

						<button type="button"
								style="    margin-top: 12px;"
								class="modal-close"
								data-bs-dismiss="modal"
								aria-label="Close">
							<svg viewBox="0 0 24 24">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
						</button>
					</div>
				</div>

				<div class="modal-body p-2">
					<div class="grid cols-4 mt-1">

						<div class="field">
							<label class="form-label">Buyer</label>
							<select id="buyerSelect" class="form-select">
								<option value="">— Select Buyer —</option>
								<option value="1">H&amp;M</option>
								<option value="2">ZARA</option>
								<option value="3">GAP INC</option>
								<option value="4">NEXT RETAIL</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Style</label>
							<select id="styleSelect" class="form-select">
								<option value="">— Select Style —</option>
								<option value="1">ST-2024-001</option>
								<option value="2">ST-2024-002</option>
								<option value="3">ST-2024-003</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Key No.</label>
							<select id="keyNoSelect" class="form-select">
								<option value="">— Select Key No. —</option>
								<option value="1">2024-001</option>
								<option value="2">2024-002</option>
								<option value="3">2024-003</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">E.D.P. No.</label>
							<select id="edpNoSelect" class="form-select">
								<option value="">— Select E.D.P. No. —</option>
								<option value="1">001</option>
								<option value="2">002</option>
								<option value="3">003</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Accessory <span class="req">*</span></label>
							<select id="modalAccessorySelect" class="form-select">
								<option value="">— Select —</option>
								<option value="button">Button</option>
								<option value="zipper">Zipper</option>
								<option value="label">Label</option>
								<option value="thread">Thread</option>
								<option value="elastic">Elastic</option>
								<option value="tape">Tape</option>
								<option value="hook">Hook</option>
								<option value="velcro">Velcro</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Type <span class="req">*</span></label>
							<select id="modalTypeSelect" class="form-select">
								<option value="">— Select —</option>
								<option value="standard">Standard</option>
								<option value="premium">Premium</option>
								<option value="special">Special</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Size</label>
							<select id="modalSizeSelect" class="form-select">
								<option value="">— Select —</option>
								<option value="xs">XS</option>
								<option value="s">S</option>
								<option value="m">M</option>
								<option value="l">L</option>
								<option value="xl">XL</option>
								<option value="18L">18L</option>
								<option value="20MM">20MM</option>
								<option value="25MM">25MM</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Colour</label>
							<select id="modalColourSelect" class="form-select">
								<option value="">— Select —</option>
								<option value="BL9121">BL9121 Blue Heaven</option>
								<option value="GR5547">GR5547 Frosted Grey</option>
								<option value="GR7708">GR7708 Burnished Gold</option>
								<option value="RD1001">RD1001 Cherry Red</option>
								<option value="WH2020">WH2020 Pure White</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Concern Person</label>
							<select id="modalConcernPersonSelect" class="form-select">
								<option value="">— Select Person —</option>
								<option value="kapil">KAPIL</option>
								<option value="rahul">RAHUL</option>
								<option value="priya">PRIYA</option>
								<option value="amit">AMIT</option>
							</select>
						</div>

						<div class="field">
							<label class="form-label">Rate</label>
							<input type="number" id="modalRateInput" class="form-control" min="0" step="1" placeholder="0" />
						</div>

						<div class="field">
							<label class="form-label">Current Quantity</label>
							<input type="number" id="modalCurrentQty" class="form-control" min="0" step="1" placeholder="0" />
						</div>

					</div>
				</div>

				<div class="modal-footer">

					<button type="button"
							class="btn btn-primary btn-sm"
							id="btnSave">

						<svg width="14"
							 height="14"
							 viewBox="0 0 24 24"
							 fill="none"
							 stroke="currentColor"
							 stroke-width="2"
							 stroke-linecap="round"
							 stroke-linejoin="round">

							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
							<polyline points="17 21 17 13 7 13 7 21"></polyline>
							<polyline points="7 3 7 8 15 8"></polyline>

						</svg>

						Save
					</button>

				</div>
			</div>
		</div>
	</div>

}



<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="addimportModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content modal-box">
			<div class="modal-header">
				<div class="modal-header-text">
					<div class="modal-title" id="addimportModal">
						Import Details
					</div>
				</div>

				<div class="app-modal-header-actions">

					<button type="button"
							style="    margin-top: 12px;"
							class="modal-close"
							data-bs-dismiss="modal"
							aria-label="Close">
						<svg viewBox="0 0 24 24">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>

			<div class="modal-body p-2">
				<div class="grid cols-6 mt-1" style="gap:2px">



					<!-- FOB Option -->
					<div class="form-check">
						<input type="radio" class="form-check-input" id="rdoFOB" name="ImportPaytype" value="FOB" />
						<label class="form-check-label" for="rdoFOB"> FOB </label>
					</div>

					<!-- CIF Option -->
					<div class="form-check mt-1">
						<input type="radio" class="form-check-input" id="rdoCIF" name="ImportPaytype" value="CIF" />
						<label class="form-check-label" for="rdoCIF"> CIF </label>
					</div>

					<!-- EXMIL Option (Default Checked) -->
					<div class="form-check mt-1">
						<input type="radio" class="form-check-input" id="rdoEXMIL" name="ImportPaytype" value="EXMIL" checked />
						<label class="form-check-label" for="rdoEXMIL"> EXMIL </label>
					</div>

					<!-- CNF Option -->
					<div class="form-check mt-1">
						<input type="radio" class="form-check-input" id="rdoCNF" name="ImportPaytype" value="CNF" />
						<label class="form-check-label" for="rdoCNF"> CNF </label>
					</div>
				</div>

				<div class="grid cols-2 mt-3" style="gap:10px">
					<div class="field">
						<label class="form-label">Currency</label>
						<select id="ddlCurrency" class="form-select">
							<option value="INR">INR</option>
							<option value="Dollar">$Dollar</option>
							<option value="Euro">Euro</option>
						</select>
					</div>
					<div class="field">
						<label class="form-label">Attention</label>
						<input class="form-control" id="txtAttention" type="text" placeholder="Enter Attention..." />
					</div>
					<div class="field">
						<label class="form-label">From</label>
						<input class="form-control" id="txtFrom" type="text" placeholder="Enter From..." />
					</div>
					<div class="field mt-4">
						<button type="button"
								class="btn btn-primary btn-sm action-btn action-add-row"
								id="btnOk"
								title="OK">

							<svg width="17" height="17"
								 viewBox="0 0 24 24"
								 fill="none"
								 stroke="currentColor"
								 stroke-width="2"
								 stroke-linecap="round"
								 stroke-linejoin="round">

								<path d="M12 5v14" />
								<path d="M5 12h14" />

							</svg>

							<span>OK</span>
						</button>
					</div>

				</div>
			</div>

			<div class="modal-footer">

				<button type="button"
						class="btn btn-primary btn-sm"
						id="btnSave">

					<svg width="14"
						 height="14"
						 viewBox="0 0 24 24"
						 fill="none"
						 stroke="currentColor"
						 stroke-width="2"
						 stroke-linecap="round"
						 stroke-linejoin="round">

						<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
						<polyline points="17 21 17 13 7 13 7 21"></polyline>
						<polyline points="7 3 7 8 15 8"></polyline>

					</svg>

					Save
				</button>

			</div>
		</div>
	</div>
</div>



@{
    ViewData["Title"] = "Buyer Order";
    ViewData["Heading"] = "Buyer Order";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/buyer-order.css" asp-append-version="true">
}

@*
    @section TopbarLeft {

    }
*@

<div class="card boe-tabbar">
    <div class="card-head">
        <div class="screen-switch" role="tablist" aria-label="Views">
            <button type="button" class="on" data-view="new">
                👥 New Buyer Orders
            </button>
            <button type="button" data-view="status">
                📋 Order Status
            </button>
            <button type="button" data-view="booking">
                📑 Booking Reference
            </button>
        </div>
    </div>
</div>

<!-- ════════ VIEW 1 · New buyer orders ════════ -->
<div class="view on" id="view-new">

    <section class="card">
        <div class="card-head">
            <div>
                <span class="tick"></span>
                <h2 class="mt-2" id="txtHeaderMain">Buyer Orders</h2>
            </div>


            <div class="d-flex gap-2">
                @await Html.PartialAsync("Components/_CheckBoxComponent")
                @await Html.PartialAsync("Components/_UploadAndViewButtons")

                <button type="button" class="btn btn-primary btn-sm" id="btnSave" title="Save">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    Save
                </button>

                <button type="button" class="btn btn-cancel-custom" id="btnCancel">
                    ✕ Cancel
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="grid cols-6">
                <div class="field">
                    <label>Mail Date</label>
                    <input type="text" id="txtMaildate" class="form-Flatdate" value="2025-07-27">
                </div>
                <div class="field">
                    <label>Mode</label>
                    <div class="segment">
                        <button class="on" onclick="orderMode(this,'add')">Add  Orders</button>
                        <button onclick="orderMode(this,'upd')">Update Orders</button>
                    </div>
                </div>
                <div class="field">
                    <label>Key Number</label>
                    <input placeholder="—">
                </div>
            </div>

            <!-- Add mode -->
            <section class="mt-2" id="mode-add">
                @* <div class="card-head">
                    <span class="tick"></span>
                    <h2>Orders to Add</h2>
                    <span class="hint">Gims details on the left · assign shipping buyer on the right</span>
                </div> *@

                <div class="table-wrap" style="border:none;border-radius:0">
                    <table id="tblOrdersAdd" class="" style="min-width:1500px">
                        <colgroup>
                            <col style="width:40px">   <!-- # -->
                            <col style="width:90px">   <!-- Key No. -->
                            <col style="width:130px">  <!-- Buyer Name -->
                            <col style="width:150px">  <!-- Style No. -->
                            <col style="width:80px">   <!-- PO No. -->
                            <col style="width:100px">   <!-- Country -->
                            <col style="width:100px">  <!-- Quantity -->
                            <col style="width:70px">   <!-- Rate -->
                            <col style="width:100px">  <!-- Ex-Factory -->
                            <col style="width:100px">  <!-- Ex-Country -->
                            <col style="width:90px">  <!-- Premises-->
                            <col style="width:90px">  <!--  Mode --> 
                            <col style="width:90px">   <!-- Byr Code -->
                            <col style="width:190px">  <!-- Byr Name -->
                            <col style="width:90px">   <!-- B.H. Code -->
                            <col style="width:180px">  <!-- B.H. Name -->
                        </colgroup>

                        <thead>
                            <tr>
                                <th colspan="10" class="gline" style="background: white !important; color: black !important;">
                                    Gims Details
                                </th>
                                <th colspan="9" class="gline" style="background: white !important; color: black !important;">
                                    Shipping Details
                                </th>
                            </tr>
                            <tr>
                                <th class="c">#</th>
                                <th>Update</th>
                                <th>Key No.</th>
                                <th>Buyer Name</th>
                                <th>Style No.</th>
                                <th>PO No.</th>
                                <th>Country</th>
                                <th class="r">Quantity</th>
                                <th class="r">Rate</th>
                                <th>Ex-Factory</th>
                                <th>Ex-Country</th>
                                <th>Premises</th>
                                <th>Mode</th>
                                <th>Fabric</th>
                                <th>Acc</th>
                                <th class="r">Byr Code</th>
                                <th>Byr Name</th>
                                <th class="r">B.H. Code</th>
                                <th>B.H. Name</th>
                            </tr>
                        </thead>
                        <tbody id="tblOrdersAddBody">
                            <!-- populated by JS from JSON (see renderOrdersAddGrid in buyer-order.js) -->
                        </tbody>
                    </table>
                </div>
            </section>


        </div>
    </section>

   

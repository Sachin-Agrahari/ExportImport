<div class="view" id="view-excel">

    <section class="card"> 
        <div class="card-head">
            <div>
                <span class="tick"></span>
                <h1>Excel Import</h1>
            </div>

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave"
                        title="Save">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

                <button type="button"
                        class="btn btn-cancel-custom"
                        id="btnCancel">
                    ✕ Cancel
                </button>

            </div>
        </div>

        <!-- Body -->
        <div class="card-body"> 
            <div class="excel-import-container">
                 
                <div class="excel-upload-box" id="excelDropZone">

                    <div class="excel-upload-icon">
                        <svg width="30"
                             height="30"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>

                            <path d="M8 13h8"></path>
                            <path d="M8 17h5"></path>

                        </svg>
                    </div>

                    <div class="excel-upload-content">

                        <div class="excel-upload-title">
                            <span class="excel-browse" id="btnBrowseExcel">
                                Click to browse
                            </span>

                            <span>
                                or drag &amp; drop an Excel file here
                            </span>
                        </div>

                        <div class="excel-upload-info">
                            Accepted: .xlsx, .xls
                            <span>•</span>
                            Max 10 MB
                        </div>

                        <div class="excel-file-name" id="excelFileName" style="display:none;"> </div>

                    </div> 
                    <input type="file" id="excelFile" accept=".xlsx,.xls" class="d-none" /> 
                </div>
                 
                <div class="excel-actions">

                    <button type="button" class="btn btn-outline" id="btnDownloadTemplate">
                        Download Template
                    </button>

                    <button type="button" class="btn btn-primary" id="btnImportExcel">
                        Import
                    </button>

                </div> 
            </div> 
        </div> 
    </section> 
</div>
 

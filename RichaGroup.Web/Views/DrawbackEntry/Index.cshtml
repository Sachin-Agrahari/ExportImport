@{
    ViewData["Title"] = "Drawback Entry";
    ViewData["Heading"] = "Drawback Entry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/drawback-entry.css" asp-append-version="true">
}
 
<!-- ════════ Tab switcher ════════ -->
<div class="card boe-tabbar">
    <div class="card-head">
        <div class="screen-switch" role="tablist" aria-label="Views">
            <button type="button" class="on" data-view="list">
                Drawback
            </button>
            <button type="button" data-view="partial">
                Partial
            </button>
            <button type="button" data-view="supp">
                Supplementary
            </button>
            <button type="button" data-view="advance">
                Advance Drawback
            </button>
            <button type="button" data-view="excel">
                Excel Import
            </button>
        </div>
    </div>
</div>
 
@* ════════════════════════════════════════════════════════════
   VIEW · Drawback list
   ════════════════════════════════════════════════════════════ *@
<div class="view on" id="view-list">

    <section class="card">
        <div class="card-head">
            <div>
                <span class="tick"></span>
                <h2 class="mt-2" id="txtHeaderMain">Drawback Entry</h2>
            </div>

            <div class="d-flex gap-2">
                @await Html.PartialAsync("Components/_CheckBoxComponent")
                @await Html.PartialAsync("Components/_UploadAndViewButtons")
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave"
                        title="Save">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

                <button class="btn btn-primary btn-sm" onclick="EditDrawback()"
                        id="btnAdd">
                    ＋ Add
                </button>

                <button type="button"
                        class="btn btn-cancel-custom"
                        id="btnCancel">
                    ✕ Cancel
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="grid cols-5">

                <div class="field">
                    <label>Consignee</label>
                    <select>
                        <option selected>Choose one&hellip;</option>
                    </select>
                </div>

                <div class="field">
                    <label>From Date</label>
                    <input type="text" class="form-Flatdate" value="2014-01-03">
                </div>

                <div class="field">
                    <label>To Date</label>
                    <input type="text" class="form-Flatdate" value="2014-03-31">
                </div>

                <div class="checkbox" style="padding-top:26px">
                    <input type="checkbox" id="pend">
                    <label for="pend" style="all:unset;cursor:pointer">Pending only</label>
                </div>

                <div class="field" style="align-self:end">
                   <div class="grid cols-3">
                       <div class="field"></div>
                       <div class="field"></div> 
                       <div class="field">
                            <button class="btn btn-primary" style="width:100%">Search</button>
                       </div>
                   </div>
                </div>

            </div>
        </div>
 
        <div class="table-wrap m-3" style="border:none;border-radius:0">
            <table style="min-width:1250px">
                <thead>
                    <tr>
                        <th class="c">Actions</th>
                        <th>Invoice No</th>
                        <th>GST Invoice No</th>
                        <th>Rel Date</th>
                        <th>Shipping Bill No</th>
                        <th>Shipping Bill Date</th>
                        <th>Mode</th>
                        <th class="r">DBK Rec</th>
                        <th>EP Date</th>
                        <th>DBK Type</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody id="tblbodyDrawbackEntries"></tbody>
            </table>
        </div>

    </section>
 
</div>
 


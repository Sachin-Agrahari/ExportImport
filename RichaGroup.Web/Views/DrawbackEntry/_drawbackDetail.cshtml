<!-- ================= INVOICE HEADER ================= -->
<div class="grid cols-6">

    <!-- 1 -->
    <div class="field">
        <label>Invoice No</label>
        <select id="ddlInvoiceNo">
            <option selected value="">-- Search & Select AEPC Invoice --</option>
        </select>
    </div>

    <!-- 2 -->
    <div class="field">
        <label>Invoice Date</label>
        <input id="txtInvoiceDate" type="text" class="form-Flatdate" placeholder="DD/MM/YYYY" disabled>
    </div>

    <!-- 3 -->
    <div class="field">
        <label>Consignee Name</label>
        <input id="txtConsigneeName" disabled>
    </div>

</div>

<hr />

<!-- ================= INVOICE DETAILS (Auto from Invoice) ================= -->
<div class="grid cols-6">

    <div class="field">
        <label>Exchange</label>
        <input id="txtExchange" class="num" disabled placeholder="0.00">
    </div>

    <div class="field">
        <label>Invoice Value (INR)</label>
        <input id="txtInvoiceValueINR" class="num" placeholder="0.00">
    </div>

    <div class="field">
        <label>Total Qty</label>
        <input id="txtTotalQty" class="num" placeholder="0.00">
    </div>

    <div class="field">
        <label>Shipment Mode</label>
        <input id="txtShipmentMode">
    </div>

    <div class="field">
        <label>HS Code</label>
        <input id="txtHSCode" disabled placeholder="&mdash;">
    </div>

</div>


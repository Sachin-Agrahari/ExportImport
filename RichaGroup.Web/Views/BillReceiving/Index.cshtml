@{
	ViewData["Title"] = "Bill Receiving";
	ViewData["Heading"] = "Bill Reciving";
}

@section Styles {
	<link rel="stylesheet" href="~/css/pages/bill-receiving.css" asp-append-version="true">
}

@* @section TopbarLeft {
	<div class="screen-switch" role="tablist" aria-label="Views">
		<button class="on" data-view="list">1 &middot; Bill Receiving</button>
		<button data-view="expense">2 &middot; Expense</button>
		<button data-view="details">3 &middot; Bill Details</button>
	</div>
} *@

<!-- ════════ VIEW 1 &middot; List ════════ -->
<div class="view on" id="view-list">


	<section class="card">
		<div class="card-head"> 
			<div class="screen-switch" role="tablist" aria-label="Views">
				<button class="on" data-view="list">1 &middot; Bill Receiving</button>
				<button data-view="expense">2 &middot; Expense</button>
				<button data-view="details">3 &middot; Bill Details</button>
			</div>
		
		</div>

		<div class="card-head">
			<div>
				<span class="tick"></span>
				<h2 class="mt-2" id="txtHeaderMain">CHA Bill Receiving</h2>
			</div>


			<div class="d-flex gap-2">
				@await Html.PartialAsync("Components/_CheckBoxComponent")
				@await Html.PartialAsync("Components/_UploadAndViewButtons")
				<button class="btn btn-primary" onclick="show('expense')">+ Add Expense</button>
				@* <button class="btn btn-primary btn-sm" id="btnSave_AdvLicApplication">Save</button> *@
			</div>
		</div>

		@* <div class="card-head"><span class="tick"></span><h2>Search</h2></div> *@
		<div class="card-body">
			<div class="grid cols-5">
				<div class="field"><label>Bill To</label><select><option selected>Choose one&hellip;</option></select></div>
				<div class="field"><label>Bill To (Name)</label><input placeholder="&mdash;"></div>
				<div class="field"><label>From Date</label><input type="text" id="txtFromDate" class="form-Flatdate" value="2014-01-04"></div>
				<div class="field"><label>To Date</label><input type="text" id="txtToDate" class="form-Flatdate" value="2014-01-04"></div>
				<div class="field" style="align-self:end"><button class="btn btn-primary">Filter</button></div>
			</div>
		</div>
	</section>

	<section class="card">
		<div class="card-head"><h2>Received Bills</h2><span class="hint">3 records &middot; headers are filterable</span></div>
		<div class="table-wrap" style="border:none;border-radius:0">
			<table style="min-width:1000px">
				<thead>
					<tr>
						<th class="c" style="width: 50px !important;">Actions</th>
						<th class="c">#</th>
						<th class="r">Entry No. &#8991;</th>
						<th class="r">Bill No &#8991;</th>
						<th>Bill Date</th>
						<th>CHA Forwarder &#8991;</th>
						<th class="r">Amount</th>
						<th>Expense Type &#8991;</th>

					</tr>
				</thead>
				<tbody>
					<tr>
						<td class="c"><button class="row-btn" title="View">&#128269;</button> <button class="row-btn" title="Edit" onclick="show('expense')">&#9998;</button> </td>

						<td class="c">1</td>
						<td class="r num">3</td>
						<td class="r num">3</td>
						<td>12-03-2014</td>
						<td class="mono">3321diad</td>
						<td class="r num">500</td>
						<td><span class="tag">CHA Bill</span></td>
					</tr>
					<tr>
						<td class="c"><button class="row-btn" title="View">&#128269;</button> <button class="row-btn" title="Edit" onclick="show('expense')">&#9998;</button> </td>
						<td class="c">2</td>
						<td class="r num">2</td>
						<td class="r num">1</td>
						<td>11-03-2014</td>
						<td class="mono">CHA0509</td>
						<td class="r num">1,500</td>
						<td><span class="tag">Air Freight INTL</span></td>
					</tr>
					<tr>
						<td class="c"><button class="row-btn" title="View">&#128269;</button> <button class="row-btn" title="Edit" onclick="show('expense')">&#9998;</button> </td>

						<td class="c">3</td>
						<td class="r num">1</td>
						<td class="r num">1</td>
						<td>09-03-2014</td>
						<td class="mono">3321diad</td>
						<td class="r num">40,000</td>
						<td><span class="tag">Air Freight Domestic</span></td>
					</tr>
				</tbody>
			</table>
		</div>
	</section>
</div>

<!-- ════════ VIEW 2 &middot; Expense ════════ -->
<div class="view" id="view-expense">

	<!-- Bill header -->
	<section class="card">

		<div class="card-head">
			<div>
				<span class="tick"></span>
				<h2 class="mt-2">Expense</h2>
			</div>


			<div class="d-flex gap-2">
				<button class="btn btn-outline-danger btn-sm p-1" onclick="show('list')"> Back to List</button>
				<button class="btn btn-outline-danger btn-sm p-1" id="btnMainDeletentry">DeleteMainEntry</button>
			</div>
		</div>

		@*   <div class="card-head"><span class="tick"></span><h2>Bill Header</h2></div> *@
		<div class="card-body">
			<div class="grid cols-4">
				<div class="field"><label>Entry No</label><select><option selected>Choose one&hellip;</option></select></div>
				<div class="field"><label>Code</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Name</label><input placeholder="&mdash;"></div>
				<div class="field"><label>GST No</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Bill No</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Bill Date</label><input type="text" id="txtBillDate" class="form-Flatdate"></div>
				<div class="field"><label>Bill Amount</label><input class="num" placeholder="0.00"></div>
				<div class="field">
					<label>Unit / Expense Type</label>
					<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
						<select><option selected>&mdash;</option></select><input placeholder="&mdash;">
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Tag invoices -->
	<section class="card">
		<div class="card-head">
			<h2>Tag Invoices to Bill</h2>
			<span class="hint">Fill the top row and press + to add</span>
		</div>
		<div class="card-body">
			  <div class="d-flex justify-content-end mt-0 mb-2 me-1">
                <button
                    type="button"
                    class="btn btn-primary btn-sm"
                    id="btnAddTagInvoice">
                    + Add button
                </button>
            </div>
			
			<div class="table-wrap">
			    <table id="tblInvoiceDetails" style="min-width:1100px">
			        <thead>
			            <tr>
			                <th class="c">Action</th>
			                <th class="c">#</th>
			                <th>Invoice No.</th>
			                <th>Invoice Date</th>
			                <th class="r">Cartons</th>
			                <th class="r">Buyer Code</th>
			                <th class="r">Gross Weight</th>
			                <th class="r">CBM</th>
			                <th class="r">Chargeable CBM</th>
			                <th class="r">Buyer</th>
			            </tr>
			        </thead>
			
			        <tbody id="tblbody_InvoiceDetails">
			            <!-- rows bind here -->
			        </tbody>
			    </table>
			</div>

			<div style="display:flex;justify-content:center;gap:10px;margin-top:20px;flex-wrap:wrap">
				<button class="action-btn action-back btn-sm" id="btnBreakup">Break Up</button>
				<button class="btn btn-outline btn-sm" onclick="show('details')">Bill Details</button>
			</div>
		</div>
	</section>
</div>

<!-- ════════ VIEW 3 &middot; Bill Details ════════ -->
<div class="view" id="view-details">
	<div class="page-head">
		<div>
			<div class="crumbs">TRX / CHA Bill Entry / Bill Receiving / <b>Bill Details</b></div>
			<h1>Bill Details <span class="chip">GST &amp; Taxes</span></h1>
		</div>
		<button class="btn btn-ghost" onclick="show('expense')">&larr; Back to Expense</button>
	</div>

	<!-- Bill header (same as expense) -->
	<section class="card">
		<div class="card-head"><span class="subhead"></span><h2>Bill Header</h2></div>
		<div class="card-body">
			<div class="grid cols-4">
				<div class="field"><label>Entry No</label><select><option selected>Choose one&hellip;</option></select></div>
				<div class="field"><label>Code</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Name</label><input placeholder="&mdash;"></div>
				<div class="field"><label>GST No</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Bill No</label><input placeholder="&mdash;"></div>
				<div class="field"><label>Bill Date</label><input type="text" id="txtBillDate" class="form-Flatdate" ></div>
				<div class="field"><label>Bill Amount</label><input class="num" placeholder="0.00"></div>
				<div class="field">
					<label>Unit / Expense Type</label>
					<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
						<select><option selected>&mdash;</option></select><input placeholder="&mdash;">
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Tax breakdown -->
	<section class="card">
		<div class="card-head">
			<span class="tick"></span><h2>GST &amp; Tax Breakdown</h2>
			<span class="hint">Rates on the left &middot; computed amounts on the right</span>
		</div>
		<div class="card-body">
			<div class="tax-grid">
				<div>
					<div class="tax-row"><span class="lbl">SAC Code</span><input value="0.00"></div>
					<div class="tax-row"><span class="lbl">IGST %</span><input value="6.00"></div>
					<div class="tax-row"><span class="lbl">CGST %</span><input value="6.00" disabled></div>
					<div class="tax-row"><span class="lbl">SGST %</span><input value="0.00"></div>
					<div class="tax-row"><span class="lbl">Discount</span><input value="0.00" disabled></div>
					<div class="tax-row"><span class="lbl">S. Tax</span><input value="0.00" disabled></div>
					<div class="tax-row"><span class="lbl">E. Cess</span><input value="0.00"></div>
					<div class="tax-row"><span class="lbl">S. Bharat</span><input value="0.00"></div>
					<div class="tax-row"><span class="lbl">K. Kalyan</span><input value="0.00"></div>
				</div>
				<div>
					<div class="tax-row"><span class="lbl">Basic Amount</span><input value="4,344.00"></div>
					<div class="tax-row"><span class="lbl">IGST Amount</span><input value="0.00" disabled></div>
					<div class="tax-row"><span class="lbl">CGST Amount</span><input value="260.50"></div>
					<div class="tax-row"><span class="lbl">SGST Amount</span><input value="260.50"></div>
					<div class="tax-row"><span class="lbl">Exempt Amount</span><input value="0.00" disabled></div>
					<div class="tax-row"><span class="lbl">Gross Bill Amount</span><input disabled placeholder="&mdash;"></div>
					<div class="tax-row">
						<span class="lbl">Feed Debit Amount</span>
						<select><option selected>N</option><option>Y</option></select>
					</div>
					<div class="tax-row"><span class="lbl">Debit Amount</span><input disabled placeholder="&mdash;"></div>
					<div class="tax-row total"><span class="lbl">Net Bill Amount</span><input disabled placeholder="&mdash;"></div>
				</div>
			</div>
			<div class="field" style="margin-top:18px"><label>Misc. Remarks</label><input placeholder="&mdash;"></div>
		</div>
	</section>
</div>


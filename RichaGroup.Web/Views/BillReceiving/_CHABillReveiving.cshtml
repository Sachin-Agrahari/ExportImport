<div class="card-body">

    <div class="grid cols-4">

        <!-- Invoice No -->
        <div class="field">
            <label class="form-label">
                Invoice No
            </label>

            <input type="text"
                   id="txtInvoiceNo_CHABill"
                   class="form-input"
                   placeholder="Enter Invoice No">
        </div>


        <!-- Invoice Date -->
        <div class="field">
            <label class="form-label">
                Invoice Date
            </label>

            <input type="text"
                   id="txtInvoiceDate_CHABill"

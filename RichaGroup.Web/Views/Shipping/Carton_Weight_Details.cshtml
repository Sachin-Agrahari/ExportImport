@{
	ViewData["Title"] = "Carton Weight and Dimension Details";
	ViewData["Heading"] = "Carton Weight and Dimension Details";
}

<div class="bd_mainContainer">
    <div class="page">

        <section class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Carton Weight Details</h2>
                </div>


                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                    <button type="button"
                            class="btn btn-cancel-custom"
                            id="btnCancel">
                        ✕ Cancel
                    </button>
                     
                </div>
            </div>

            <div class="card-body">

                <div class="grid cols-6">

                    <!-- Invoice # -->
                    <div class="field">
                        <label>Invoice #</label>

                        <input type="text"
                               id="txtInvoiceNo_CartonWeightDetails"
                               placeholder="Enter Invoice No..." />
                    </div>


                    <!-- Buyer Name -->
                    <div class="field span-2">
                        <label>Buyer Name</label>

                        <input type="text"
                               id="txtBuyerName_CartonWeightDetails"
                               placeholder="Enter Buyer Name..." />
                    </div>


                    <!-- ADI -->
                    <div class="field">
                        <label>ADI</label>

                        <input type="text"
                               id="txtAdi_CartonWeightDetails"
                               placeholder="Enter ADI..." />
                    </div>


                    <!-- Quantity -->
                    <div class="field">
                        <label>Quantity</label>

                        <input type="text"
                               id="txtQuantity_CartonWeightDetails"
                               placeholder="Enter Quantity..." />
                    </div>


                    <!-- Invoice Value -->
                    <div class="field">
                        <label>Inv. Value</label>

                        <input type="text"
                               id="txtInvoiceValue_CartonWeightDetails"
                               placeholder="Enter Invoice Value..." />
                    </div>


                    <!-- Currency -->
                    <div class="field">
                        <label>Currency</label>

                        <select id="ddlCurrency_CartonWeightDetails"
                                class="select2-field">

                            <option value="">Select Currency</option>
                            <option value="US$">US$</option>
                            <option value="UK£">UK£</option>
                            <option value="EURO">EURO</option>
                            <option value="DM">DM</option>
                            <option value="N.A.">N.A.</option>

                        </select>
                    </div>


                    <!-- FOB -->
                    <div class="field">
                        <label>FOB</label>

                        <input type="text"
                               id="txtFOB_CartonWeightDetails"
                               placeholder="Enter FOB..." />
                    </div>


                    <!-- Transfer Invoice -->
                    <div class="field">
                        <label>Trfr Inv</label>

                        <select id="ddlTransferInvoice_CartonWeightDetails"
                                class="select2-field">

                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>

                        </select>
                    </div>


                    <!-- Plist -->
                    <div class="field">
                        <label>Plist</label>

                        <select id="ddlPlist_CartonWeightDetails"
                                class="select2-field">

                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>

                        </select>
                    </div>


                    <!-- Total Ctn -->
                    <div class="field">
                        <label>Total Ctn</label>

                        <input type="text"
                               id="txtTotalCtn_CartonWeightDetails"
                               placeholder="Enter Total Ctn..." />
                    </div>


                    <!-- Lot -->
                    <div class="field">
                        <label>Lot</label>

                        <input type="text"
                               id="txtLot_CartonWeightDetails"
                               placeholder="Enter Lot..." />
                    </div>


                    <!-- From -->
                    <div class="field">
                        <label>From</label>

                        <input type="text"
                               id="txtFrom_CartonWeightDetails"
                               placeholder="Enter From..." />
                    </div>


                    <!-- To -->
                    <div class="field">
                        <label>To</label>

                        <input type="text"
                               id="txtTo_CartonWeightDetails"
                               placeholder="Enter To..." />
                    </div>

                    <div class="d-flex justify-content-start mt-2 align-items-end">
                        <button type="button"
                                class="btn btn-primary fs-0 me-1 p-2"
                                id="btnGenerateCtn_CartonWeightDetails">
                            Generate Carton
                        </button>
                        <button type="button"
                                class="btn btn-outline btn-sm fs-6"
                                id="btnFilter_CartonWeightDetails">
                           Filter
                        </button>
                    </div>

                </div>

            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm"
                            id="btnAdd">
                        ＋ Add
                    </button>
                </div>
                <div class="table-wrap">
                    <table id="tblCartonWeightDetails" class="display" style="width:100%">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Carton Type</th>
                                <th class="r num">Length</th>
                                <th class="r num">Width</th>
                                <th class="r num">Height</th>
                                <th >UOM</th>
                                <th class="r num">Ctns</th>
                                <th class="r num">Carton Weight</th>
                                <th class="r num">Gross Weight</th>
                                <th class="r num">Carton Gross Weight</th>
                                <th class="r num">Carton Net Weight</th>
                              

                                
                            </tr>
                        </thead>
                        <tbody id="tblbodyCartonWeightDetails"></tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-3">
                                Volume in CBM : <span>23.790</span>
                            </div>
                            <div class="col-3">
                                Volume Weight : <span>23.790</span>
                            </div>
                            <div class="col-3">
                                Gross Weight : <span>23.790</span>
                            </div>
                            <div class="col-3">
                                Net Weight : <span>23.790</span>
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </section>
         
    </div>
</div>

<script src="~/js/pages/shipping/carton_weight_details.js" asp-append-version="true"></script>

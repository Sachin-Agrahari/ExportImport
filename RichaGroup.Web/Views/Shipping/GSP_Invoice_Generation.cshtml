										   id="txtPortLoading_GSPInvoice"
										   placeholder="Enter Port..." />
								</div>
							</div>
							<div class="col-md-1">
								<div class="field">
									<label>Pre-Carriage by</label>
									<input type="text"
										   id="txtPreCarriage_GSPInvoice"
										   placeholder="Enter Pre-Carriage..." />
								</div>
							</div>


							<div class="col-md-1">
								<div class="field">
									<label>FOB</label>
									<input type="text"
										   id="txtFOBPort_GSPInvoice"
										   placeholder="Enter FOB..." />

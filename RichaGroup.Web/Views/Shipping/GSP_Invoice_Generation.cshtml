										   placeholder="Enter Invoice No..." />
								</div>
							</div>

							<div class=" col-md-1">
								<div class="field">
									<label>Invoice Date</label>
									<input type="text"
										   class="form-Flatdate"
										   id="txtInvoiceDate_GSPInvoice"
										   placeholder="Select Invoice Date..." />
								</div>
							</div>
							<div class="col-md-1">
								<div class="field">
									<label>Buyer Order No.</label>
									<input type="text"
										   id="txtBuyerOrderNo_GSPInvoice"
										   placeholder="Enter Buyer Order No..." />
								</div>
							</div>
							<div class="col-md-1">
								<div class="field">
									<label>Buyer Order Date</label>
									<input type="text"
										   class="form-Flatdate"
										   id="txtBuyerOrderDate_GSPInvoice"
										   placeholder="Select Date..." />

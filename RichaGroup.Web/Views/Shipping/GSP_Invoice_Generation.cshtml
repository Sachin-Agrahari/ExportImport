							</div>

							<div class="col-md-1">
								<div class="field">
									<label>FREIGHT</label>
									<select id="ddlFreight">
										<option>Select</option>
									</select>
								</div>
							</div>

							<div class="col-2">
								<div class="field">
									<label>Address Consignee</label>
									<textarea id="txtConsigneeAddress_GSPInvoice"
											  rows="2"
											  placeholder="Enter Consignee Address ..."></textarea>
								</div>
							</div>

							<!-- Notify Address 1 -->
							<div class="col-2">
								<div class="field">
									<label>Address Notify</label>
									<textarea id="txtNotifyAddress_GSPInvoice"
											  rows="2"
											  placeholder="Enter Notify Address ..."></textarea>
								</div>
							</div>


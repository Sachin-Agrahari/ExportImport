@{
	ViewData["Title"] = "GSP Invoice Generation";
	ViewData["Heading"] = "GSP Invoice Generation";
}

<link href="~/css/pages/aepc-invoice.css" rel="stylesheet" asp-append-version="true" />	
@* <link href="~/css/pages/shipping/gsp_invoice_generation.css" rel="stylesheet" asp-append-version="true" /> *@
<style>
	.table-scroll {
		max-height: 400px;
		overflow-y: auto;
		overflow-x: auto;
	}

		.table-scroll table {
			width: 100%;
			border-collapse: separate;
			border-spacing: 0;
		}
		  
		.table-scroll thead th {
			position: sticky !important;
			top: 0 !important;
			z-index: 10 !important;
		}
</style>
<div class="bd_mainContainer">
	<div class="page gsp-page">


		<!-- INVOICE HEADER -->
		<section class="card">

			<div class="card-head">
				<div>

					<span class="tick"></span>
					<h2 class="mt-2" id="txtHeaderMain">GSP Generation</h2>
				</div>


				<div class="d-flex gap-2">
					@await Html.PartialAsync("Components/_CheckBoxComponent")
					@await Html.PartialAsync("Components/_UploadAndViewButtons")
					<button type="button"
							class="btn btn-primary btn-sm"
							id="btnAdd"
							title="Add">
						+
						Add
					</button>
					<button type="button"
							class="btn btn-primary btn-sm"
							id="btnSave"
							title="Save">

						<svg width="14"
							 height="14"
							 viewBox="0 0 24 24"
							 fill="none"
							 stroke="currentColor"
							 stroke-width="2"
							 stroke-linecap="round"
							 stroke-linejoin="round">

							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
							<polyline points="17 21 17 13 7 13 7 21"></polyline>
							<polyline points="7 3 7 8 15 8"></polyline>

						</svg>
						Save
					</button>

					<button type="button"
							class="btn btn-cancel-custom"
							id="btnCancel">
						✕ Cancel
					</button>

				</div>
			</div>



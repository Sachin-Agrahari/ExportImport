<div class="card-body">

    <div class="grid cols-4">

        <div class="field">
            <label class="form-label">BOE #</label>
            <input type="text"
                   id="txtBOENo_ImportPayment"
                   class="form-input"
                   placeholder="Enter BOE No.">
        </div>

        <div class="field">
            <label class="form-label">BOE DT.</label>
            <input type="text"
                   id="txtBOEDate_ImportPayment"
                   class="form-input form-Flatdate"
                   placeholder="Select BOE Date">
        </div>

        <div class="field">
            <label class="form-label">BOE Amount</label>
            <input type="number"
                   id="txtBOEAmount_ImportPayment"
                   class="form-input"
                   placeholder="Enter BOE Amount">
        </div>

        <div class="field">
            <label class="form-label">Terms</label>
            <input type="text"
                   id="txtTerms_ImportPayment"
                   class="form-input"
                   placeholder="Enter Terms">
        </div>

        <div class="field">
            <label class="form-label">Invoice No</label>
            <input type="text"
                   id="txtInvoiceNo_ImportPayment"
                   class="form-input"
                   placeholder="Enter Invoice No.">
        </div>

        <div class="field">
            <label class="form-label">Invoice Date</label>
            <input type="text"
                   id="txtInvoiceDate_ImportPayment"
                   class="form-input form-Flatdate"
                   placeholder="Select Invoice Date">
        </div>

        <div class="field">
            <label class="form-label">Payment Ref No</label>
            <input type="text"
                   id="txtPaymentRefNo_ImportPayment"
                   class="form-input"
                   placeholder="Enter Payment Ref No.">
        </div>

      

    </div>

</div>
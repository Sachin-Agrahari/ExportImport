@{
    ViewData["Title"] = "Advance License Application";
    ViewData["Heading"] = "Advance License Application";
}
<link href="~/css/pages/importsfabric/advance_license_appliction.css" rel="stylesheet" asp-append-version="true" />

<style>
    .wrap {
        margin: auto;
        background: #fff;
        padding: 14px;
        border: 1px solid #999
    }
    table.xl {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
        background: #fff
    }

        table.xl td {
            border: 1px solid #000;
            padding: 2px 6px;
            height: 25px;
            font-size: 13px;
            overflow: hidden;
            white-space: nowrap
        }

        table.xl .g {
            background: #efefef;
        }

        table.xl .lg {
            background: #d9d9d9
        }

        table.xl .b {
            font-weight: bold
        }

        table.xl .c {
            text-align: left;
            font-weight: 700;
        }

        table.xl .r {
            text-align: right
        }

        table.xl .h {
            background: #d9d9d9;
            font-weight: bold;
            text-align: center
        }

        table.xl .box {
            border: 2px solid #1f3b9c;
            font-weight: bold;
            text-align: center;
            background: #fff
        }

        table.xl td.in {
            padding: 0
        }

            table.xl td.in input {
                width: 100%;
                height: 100%;
                border: 0;
                background: #fff;
                text-align: right;
                font: inherit;
                padding: 2px 6px;
                outline: none
            }

                table.xl td.in input:focus {
                    background: #fff8c6
                }

        table.xl td.pc {
            padding: 0;
            position: relative
        }

            table.xl td.pc input {
                padding-right: 20px
            }

            table.xl td.pc:after {
                content: "%";
                position: absolute;
                right: 6px;
                top: 50%;
                transform: translateY(-50%)
            }

    .chkrow {
        text-align: right;
        border: 0 !important;
        background: none !important
    }

    .chk {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: bold;
        cursor: pointer;
        padding: 3px 8px;
        border: 2px solid #d22
    }

        .chk input {
            width: 17px;
            height: 17px;
            margin: 0
        }



    @@media(max - width:700px) {
        .top {
            grid-template-columns: 1fr 1fr
        }

        .wrap {
            overflow-x: auto
        }

        table.xl {
            min-width: 640px
        }
    }

    #t-DutyVsStructer .dvd-page {
        max-width: 794px;
        margin: auto;
        background: #fff;
        padding: 24px 40px 36px;
        border: 1px solid #999;
        font-family: Arial,Helvetica,sans-serif;
        color: #000
    }

    #t-DutyVsStructer .dvd-tools {
        text-align: right;
        margin-bottom: 6px
    }

        #t-DutyVsStructer .dvd-tools button {
            padding: 5px 14px;
            border: 1px solid #333;
            background: #fff;
            cursor: pointer;
            font-size: 13px
        }

    /* ---------- INFO: equal columns, equal row height ---------- */
    #t-DutyVsStructer table.dvd-info {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed
    }

        #t-DutyVsStructer table.dvd-info td {
            border: 0;
            padding: 0 6px 0 0;
            height: 32px;
            vertical-align: bottom
        }

        #t-DutyVsStructer table.dvd-info .lbl {
            font-size: 10.5px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: .3px;
            white-space: nowrap;
            padding-bottom: 4px
        }

            #t-DutyVsStructer table.dvd-info .lbl.r {
                text-align: right;
                padding-right: 8px
            }

        #t-DutyVsStructer table.dvd-info td.ln {
            padding-right: 0
        }

    #t-DutyVsStructer .fld {
        width: 100%;
        min-width: 0;
        border: 0;
        border-bottom: 1px solid #000;
        border-radius: 0;
        box-shadow: none;
        background: transparent;
        font: bold 10.5px Arial,sans-serif;
        text-transform: uppercase;
        padding: 2px 3px;
        outline: none;
        text-align: left
    }

        #t-DutyVsStructer .fld.r {
            text-align: right
        }

        #t-DutyVsStructer .fld.hl {
            background: #d9d9d9
        }

        #t-DutyVsStructer .fld:focus {
            background: #fff8c6
        }

    /* ---------- SUMMARY: 6 equal columns, equal row height ---------- */
    #t-DutyVsStructer table.dvd-sum {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin-top: 26px;
        border: 1.5px solid #000
    }

        #t-DutyVsStructer table.dvd-sum tr.sp td {
            width: 16.666%;
            height: 0;
            padding: 0;
            border: 0
        }

        #t-DutyVsStructer table.dvd-sum td {
            border: 1px solid #000;
            padding: 0 8px;
            height: 36px;
            font-size: 10.5px;
            font-weight: bold;
            text-transform: uppercase;
            overflow: hidden;
            white-space: nowrap
        }

            #t-DutyVsStructer table.dvd-sum td.hd {
                text-align: center
            }

            #t-DutyVsStructer table.dvd-sum td.v {
                padding: 0
            }

                #t-DutyVsStructer table.dvd-sum td.v.bx {
                    padding: 3px 6px
                }

                #t-DutyVsStructer table.dvd-sum td.v input {
                    display: block;
                    width: 100%;
                    height: 100%;
                    min-width: 0;
                    border: 0;
                    border-radius: 0;
                    box-shadow: none;
                    background: transparent;
                    text-align: right;
                    font: bold 11px Arial,sans-serif;
                    padding: 0 8px;
                    outline: none
                }

                #t-DutyVsStructer table.dvd-sum td.v.bx input {
                    border: 2px solid #000;
                    border-radius: 2px
                }

                #t-DutyVsStructer table.dvd-sum td.v input:focus {
                    background: #fff8c6
                }

        #t-DutyVsStructer table.dvd-sum tr.sigrow td.sig {
            height: 92px;
            vertical-align: top;
            padding-top: 6px
        }

    @@media print {
        body *

    {
        visibility: hidden
    }

    #t-DutyVsStructer .dvd-page, #t-DutyVsStructer .dvd-page * {
        visibility: visible
    }

    #t-DutyVsStructer .dvd-page {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: 0
    }

    #t-DutyVsStructer .dvd-tools {
        display: none
    }

    }
</style>




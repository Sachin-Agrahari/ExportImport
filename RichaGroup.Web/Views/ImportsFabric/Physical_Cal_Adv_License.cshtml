@{
    ViewData["Title"] = "Physical Calculation Dav License";
    ViewData["Heading"] = "Physical Calculation Dav License";
}

<div class="bd_mainContainer">

    <div class="page">
        <!-- BASIC DETAILS -->
        <section class="card">
            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Calculation Dav License</h2>
                </div>

                <div class="screen-switch">

                    <button type="button"
                            class="on"
                            data-target="#physicalCalculationSection">
                        1 · Physical Calculation Dav License
                    </button>

                    <button type="button"
                            data-target="#licenseEntrySection">
                        2 · Physical Dav Lic
                    </button>

                    <button type="button"
                            data-target="#licenseDetailsSection">
                        3 · Advance License Details
                    </button>

                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave_PhysicalCalculationAdvLicense"
                            title="Save">

                        <svg width="14"
                             height="14"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>

                        </svg>

                        Save
                    </button>

                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            id="btnRefresh_PhysicalCalculationAdvLicense">
                        ↻ Refresh
                    </button>
                </div>
            </div>

        </section>


        <!-- FABRIC DETAILS TABLE -->
        <div id="physicalCalculationSection">
            <section class="card">
                <div class="card-body">

                    <div class="grid cols-6">

                        <div class="field">
                            <label>Unit</label>
                            <input type="text"
                                   id="txtUnit_PhysicalCalculationAdvLicense"
                                   placeholder="Enter Company..." />
                        </div>

                        <div class="field">
                            <label>Buyer</label>
                            <input type="text"
                                   id="txtBuyer_PhysicalCalculationAdvLicense"
                                   placeholder="Enter Buyer..." />
                        </div>

                        <div class="field">
                            <label>Merchant</label>
                            <input type="text"
                                   id="txtMerchant_PhysicalCalculationAdvLicense"
                                   placeholder="Enter Merchant..." />
                        </div>

                        <div class="field">
                            <label>Garments</label>
                            <input type="text"
                                   id="txtGarment_PhysicalCalculationAdvLicense"
                                   placeholder="Enter Garments..." />
                        </div>

                        <div class="field">
                            <label>Norms</label>
                            <div class="pair">
                                <input type="text"
                                       id="txtnorms1_PhysicalCalculationAdvLicense"
                                       placeholder="Enter Norms 1..." />
                                <input type="text"
                                       id="txtnorms2_PhysicalCalculationAdvLicense"
                                       placeholder="Enter Norms 2..." />
                            </div>
                        </div>

                        <div class="field span-2">
                            <label>Fabric Description</label>
                            <input type="text"
                                   id="txtFabricDesc_PhysicalCalculationDavLicense"
                                   placeholder="Enter Fabric Description..." />
                        </div>

                        <div class="field">
                            <label>GSM</label>
                            <input type="text"
                                   id="txtGSM_PhysicalCalculationDavLicense"
                                   placeholder="Enter GSM..." />
                        </div>

                        <div class="field">
                            <label>Width</label>
                            <input type="text"
                                   id="txtWidth_PhysicalCalculationDavLicense"
                                   placeholder="Enter Width..." />
                        </div>

                        <div class="field">
                            <label>IMP ITCHS</label>
                            <input type="text"
                                   id="txtImpItchs_PhysicalCalculationDavLicense"
                                   placeholder="Enter IMP ITCHS..." />
                        </div>

                        <div class="field">
                            <label>Mode</label>
                            <input type="text"
                                   id="txtMode_PhysicalCalculationDavLicense"
                                   placeholder="Enter Mode..." />
                        </div>

                        <div class="field">
                            <label>Port</label>
                            <input type="text"
                                   id="txtPort_PhysicalCalculationDavLicense"
                                   placeholder="Enter Port..." />
                        </div>

                        <div class="field">
                            <label>Export ITCHS Code No.</label>
                            <input type="text"
                                   id="txtExportItchsCode_PhysicalCalculationDavLicense"
                                   placeholder="Enter Export ITCHS Code..." />
                        </div>

                        <div class="field">
                            <label>IMP No.</label>
                            <input type="text"
                                   id="txtImpNo_PhysicalCalculationAdvLicense"
                                   placeholder="Enter IMP No..." />
                        </div>

                        <div class="field">
                            <label>EXP No.</label>
                            <input type="text"
                                   id="txtExpNo_PhysicalCalculationAdvLicense"
                                   placeholder="Enter EXP No..." />
                        </div>

                    </div>

                </div>
            </section>

            <section class="card gsp-table-card">

                <div class="card-head d-flex justify-content-end">

                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnAddItem_PhysicalCalculationAdvLicense">

                        <i class="fa-solid fa-plus me-1"></i>
                        Add Row

                    </button>

                </div>

                <div class="card-body px-2">

                    <div class="gsp-table-scroll">

                        <table id="tblPhysicalCalculationAdvLicense"
                               class="display"
                               style="width:100%">

                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Sr No</th>
                                    <th>Style</th>
                                    <th>GMT Desc</th>
                                    <th>Fab Qty MTS</th>
                                    <th>Fab Qty SQM</th>
                                    <th>Extra %</th>
                                    <th>Qty With Extra %</th>
                                    <th>GMT Qty</th>
                                    <th>Final GMT Qty</th>
                                    <th>Avg. SQM</th>
                                    <th>Final Avg.SQM</th>
                                    <th>Final Fab Qty SQM</th>
                                    <th>Exp Rate $ / Per Pc</th>
                                    <th>Export FOB</th>
                                    <th>Import CIF</th>
                                </tr>
                            </thead>

                            <tbody id="tblbodyPhysicalCalculationAdvLicense">
                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

            <div class="d-flex justify-content-end mb-2">
                <button type="button"
                        class="btn btn-primary btn-sm d-flex justify-content-end"
                        id="btnStyleCalculationDetails">
                    <i class="fa-solid fa-calculator me-1 mt-1"></i>
                    Style Calculation Details
                </button>
            </div>


            <!-- SECOND TABLE -->
            <section class="card gsp-table-card d-none" id="styleCalculationDetailsSection">

                <div class="card-head d-flex justify-content-between">
                    <div>
                        <h6 class="mb-0">
                            Style Calculation Details
                        </h6>
                    </div>
                    <div></div>
                </div>

                <div class="card-body p-0">

                    <div class="gsp-table-scroll">

                        <table id="tblCalculation_AdvLicApplication" class="display" style="width:100%">

                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Style Number</th>
                                    <th>Process</th>
                                    <th>Segment</th>
                                    <th>GMT Desc</th>
                                    <th>Fab Qty (MTR)</th>
                                    <th>Fab Qty (SQM)</th>
                                    <th>Extra %</th>
                                    <th>Extra Qty</th>
                                    <th>Qty + Extra</th>
                                    <th>GMT Qty</th>
                                    <th>F. GMT Qty</th>
                                    <th>Norms</th>
                                </tr>
                            </thead>

                            <tbody id="tblbodyCalculation_AdvLicApplication">
                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </div>
    </div>


    @* second tab *@
    <div id="licenseEntrySection" class="d-none">
        @await Html.PartialAsync("/Views/ImportsFabric/_Advance_License_Application.cshtml")
    </div>

    @* third tab *@
    <div id="licenseDetailsSection" class="d-none">
        @await Html.PartialAsync("/Views/ImportsFabric/_Advance_Licensce_Details.cshtml")
    </div>
</div>


<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="modalPhysicalCalc" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">

            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="pcModalTitle">Add Physical Calculation</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <input type="hidden" id="pc_editIndex" value="-1">

                <div class="grid cols-4 mt-1">

                    <div class="field">
                        <label class="form-label">Style <span class="req">*</span></label>
                        <select id="pc_style" class="form-select">
                            <option value="">— Select Style —</option>
                            <option value="ST-2024-001">ST-2024-001</option>
                            <option value="ST-2024-002">ST-2024-002</option>
                            <option value="ST-2024-003">ST-2024-003</option>
                        </select>
                    </div>

                    <div class="field">
                        <label class="form-label">GMT Desc <span class="req">*</span></label>
                        <input type="text" id="pc_gmtDesc" class="form-control" placeholder="Garment description" />
                    </div>

                    <div class="field">
                        <label class="form-label">Fab Qty MTS</label>
                        <input type="text" id="pc_fabMts" class="r num form-control" min="0" step="0.01" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Fab Qty SQM</label>
                        <input type="text" id="pc_fabSqm" class="r num form-control pc-calc" min="0" step="0.01" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Extra %</label>
                        <input type="text" id="pc_extraPct" class="r num form-control pc-calc" min="0" step="0.01" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Qty With Extra %</label>
                        <input type="text" id="pc_qtyExtra" class="r num form-control" readonly />
                    </div>

                    <div class="field">
                        <label class="form-label">GMT Qty</label>
                        <input type="text" id="pc_gmtQty" class="r num form-control pc-calc" min="0" step="1" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Final GMT Qty</label>
                        <input type="text" id="pc_finalGmtQty" class="r num form-control pc-calc2" min="0" step="1" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Avg. SQM</label>
                        <input type="text" id="pc_avgSqm" class="r num form-control" readonly />
                    </div>

                    <div class="field">
                        <label class="form-label">Final Avg. SQM</label>
                        <input type="text" id="pc_finalAvgSqm" class="r num form-control pc-calc2" min="0" step="0.0001" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Final Fab Qty SQM</label>
                        <input type="text" id="pc_finalFabSqm" class="r num form-control" readonly />
                    </div>

                    <div class="field">
                        <label class="form-label">Exp Rate $ / Per Pc</label>
                        <input type="text" id="pc_expRate" class="r num form-control pc-calc2" min="0" step="0.01" placeholder="0" />
                    </div>

                    <div class="field">
                        <label class="form-label">Export FOB</label>
                        <input type="text" id="pc_exportFob" class="r num form-control" readonly />
                    </div>

                    <div class="field">
                        <label class="form-label">Import CIF</label>
                        <input type="text" id="pc_importCif" class="r num form-control" min="0" step="0.01" placeholder="0" />
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSavePhysicalCalc">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    <span id="pcSaveText">Save</span>
                </button>
            </div>

        </div>
    </div>
</div>


<script src="~/js/pages/importsfabric/physical_cal_adv_license.js" asp-append-version="true"></script>

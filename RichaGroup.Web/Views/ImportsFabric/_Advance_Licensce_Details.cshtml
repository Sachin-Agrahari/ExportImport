@* import modal open for the button click of import   *@
<div class="modal fade"
     id="addMenuModalImport"
     tabindex="-1"
     aria-labelledby="addMenuModalLabelImport"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xxl">

        <div class="modal-content modal-box">

            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabelImport">
                        Import Table Details
                    </div>
                </div>

                <button type="button"
                        class="modal-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <svg viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="modal-body px-2">

                <div class="card-body">

                    <div class="table-wrap">

                        <table id="tblImportDetailModal_AdvLicDetails"
                               class="w-100">

                            <thead>
                                <tr>
                                    <th>Buyer</th>
                                    <th>Style</th>
                                    <th>Wash Care Content</th>
                                    <th>Tag Content</th>
                                    <th>GSM</th>
                                    <th>Key No</th>
                                    <th>Itchs</th>
                                    <th>Grmt Qty</th>
                                    <th>UOM</th>
                                    <th>Fabric Qty</th>
                                    <th>CIF Inr</th>
                                    <th>CIF Curr</th>
                                    <th>Supplier</th>
                                    <th>Imp Sl</th>
                                    <th>Norms Fix</th>
                                    <th>Norms Fix Dt</th>
                                    <th>Import Grup</th>
                                    <th>Suppl dt</th>
                                    <th>Norms App</th>
                                    <th>Norms App Dt</th>
                                    <th>Norms Amt</th>
                                    <th>Norms Amt Dt</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody id="tblbodyImportDetal_AdvLicDetails">
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSaveImportDetail">
                    Save
                </button>

            </div>

        </div>

    </div>

</div>


@{
    ViewData["Title"] = "Add Advance License Detail";
    ViewData["Heading"] = "Add Advance License Detail";
}

<div class="bd_mainContainer">

    <div class="page">
        <!--ADVANCE LICENSE MASTER DETAILS -->

        <section class="card">
            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Add Advance License Detail</h2>
                </div>


                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            id="btnRefresh_AddAdvLicDetails">
                        ↻ Refresh
                    </button>
                    <button class="btn btn-primary btn-sm" id="btnSave_AddAdvLicDetails">Save</button>
                    <button type="button"
                            class="btn btn-outline btn-sm"
                            id="btnBack_AddAdvLicDetails">
                        Back
                    </button>
                </div>
            </div>

            <div class="card-body">

                <div class="grid cols-6">

                    <!-- Entry Number -->
                    <div class="field">
                        <label>Entry Number</label>
                        <input type="text"
                               id="txtEntryNo_AddAdvLicDetails"
                               placeholder="Enter Entry Number..." />
                    </div>

                    <!-- Company Code -->
                    <div class="field">
                        <label>Company Code</label>
                        <input type="text"
                               id="txtCompanyCode_AddAdvLicDetails"
                               placeholder="Enter Company Code..." />
                    </div>

                    <!-- Diary Serial -->
                    <div class="field">
                        <label>Diary Serial No.</label>
                        <input type="text"
                               id="txtDiarySerialNo_AddAdvLicDetails"
                               placeholder="Enter Diary Serial No..." />
                    </div>

                    <!-- License Number -->
                    <div class="field span-2">
                        <label>License Number</label>
                        <input type="text"
                               id="txtLicenseNo_AddAdvLicDetails"
                               placeholder="Enter License Number..." />
                    </div>

                    <!-- IGST -->
                    <div class="field">
                        <label>IGST</label>
                        <select id="ddlIGST_AddAdvLicDetails">
                            <option value="">Select</option>
                            <option value="Y">Y</option>
                            <option value="N">N</option>
                        </select>
                    </div>

                    <!-- License Date -->
                    <div class="field">
                        <label>License Date</label>
                        <input type="text"
                               id="txtLicenseDate_AddAdvLicDetails"
                               placeholder="Select license date..." />
                    </div>

                    <!-- License Type -->
                    <div class="field">
                        <label>License Type</label>
                        <input type="text"
                               id="txtLicenseType_AddAdvLicDetails"
                               value="SPL.ADV.LIC."
                               placeholder="Enter License Type..." />
                    </div>

                    <!-- CLA File Number -->
                    <div class="field span-2">
                        <label>CLA File Number</label>
                        <input type="text"
                               id="txtCLAFileNo_AddAdvLicDetails"
                               placeholder="Enter CLA File Number..." />
                    </div>

                    <!-- CLA File Date -->
                    <div class="field">
                        <label>CLA File Date</label>
                        <input type="text"
                               id="txtCLAFileDate_AddAdvLicDetails"
                               placeholder="Select CLA file date..." />
                    </div>

                    <!-- Port -->
                    <div class="field">
                        <label>Port of Regn.</label>
                        <input type="text"
                               id="txtPort_AddAdvLicDetails"
                               placeholder="Enter Port..." />

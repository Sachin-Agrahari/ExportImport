<div class="row g-3">

    <!-- PARTY -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Party
                <span class="text-danger">*</span>
                <button id="btnPartyHelp" class="help-link">Help</button>
            </label>

            <select id="ddlParty_DutyBillEntry"
                    class="form-select">
                <option value="">Select Party</option>
                <option value="P001">P001</option>
                <option value="P002">P002</option>
                <option value="P003">P003</option>
            </select>
        </div>
    </div>


    <!-- PARTY NAME -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Party Name
            </label>

            <input type="text"
                   id="txtPartyName_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter Party Name">
        </div>
    </div>
    <!-- PARTY NAME -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Buyer Name
            </label>

            <input type="text"
                   id="txtBuyerName_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter Buyer Name">
        </div>
    </div>


    <!-- BILL NO -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Bill No
                <span class="text-danger">*</span>
            </label>

            <input type="text"
                   id="txtBillNo_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter Bill No">
        </div>
    </div>


    <!-- BILL DATE -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Bill Date
            </label>

            <input type="text"
                   id="txtBillDate_DutyBillEntry"
                   class="form-input"
                   placeholder="Select Bill Date">
        </div>
    </div>


    <!-- BILL AMOUNT -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Bill Amount
            </label>

            <input type="text"
                   id="txtBillAmount_DutyBillEntry"
                   class="form-input text-end"
                   placeholder="0.00">
        </div>
    </div>


    <!-- ASS VALUE -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Ass Value
            </label>

            <input type="text"
                   id="txtAssValue_DutyBillEntry"
                   class="form-input text-end"
                   placeholder="0.00">
        </div>
    </div>


    <!-- DEBIT AMOUNT -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Debit Amount
            </label>

            <input type="text"
                   id="txtDebitAmount_DutyBillEntry"
                   class="form-input text-end"
                   placeholder="0.00">
        </div>
    </div>


    <!-- NET AMOUNT -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Net Amount
            </label>

            <input type="text"
                   id="txtNetAmount_DutyBillEntry"
                   class="form-input text-end"
                   placeholder="0.00">
        </div>
    </div>


    <!-- BILL TYPE -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Bill Type
                <span class="text-danger">*</span>
            </label>

            <select id="ddlBillType_DutyBillEntry"
                    class="form-select">
                <option value="">Select Bill Type</option>
                <option value="Import">Import</option>
                <option value="Export">Export</option>
                <option value="Service">Service</option>
            </select>
        </div>
    </div>


    <!-- BE NO -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                BE No
            </label>

            <input type="text"
                   id="txtBeNo_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter BE No">
        </div>
    </div>


    <!-- LICENSE NO -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Licence No
            </label>

            <input type="text"
                   id="txtLicenceNo_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter Licence No">
        </div>
    </div>


    <!-- RECEIVE DATE -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                Receive Date
            </label>

            <input type="text"
                   id="txtReceiveDate_DutyBillEntry"
                   class="form-input"
                   placeholder="Select Receive Date">
        </div>
    </div>


    <!-- GRN NO -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                GRN No
            </label>

            <input type="text"
                   id="txtGrnNo_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter GRN No">
        </div>
    </div>


    <!-- GRN DATE -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                GRN Dt
            </label>

            <input type="text"
                   id="txtGrnDt_DutyBillEntry"
                   class="form-input"
                   placeholder="Select GRN Date">
        </div>
    </div>


    <!-- GRN UNIT -->
    <div class="col-md-3">
        <div class="field">
            <label class="form-label">
                GRN Unit
            </label>

            <input type="text"
                   id="txtGrnUnit_DutyBillEntry"
                   class="form-input"
                   placeholder="Enter GRN Unit">
        </div>
    </div>

</div>


<div class="modal fade" id="PartyModal" tabindex="-1" aria-labelledby="addPartyModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addPartyModal">
                        Party Help
                    </div>
                </div>

                <div class="app-modal-header-actions">

                    <button type="button"
                            style="    margin-top: 12px;"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                <table id="tblEntryHelp" class="display" style="width:100%">

                    <thead>
                        <tr>
                            <th>Party Name</th>
                            <th>Party Type</th>
                            @* <th>Service Charges</th>
                            <th>Courier Charges</th>
                            <th>Air Fried</th> *@
                        </tr>
                    </thead>
                    <tbody id="tblEntryHelp">
                        <tr>
                            <td>AEO</td>
                            <td>AE</td>
                            @* <td class="r num">100</td>
                            <td class="r num">100</td>
                            <td class="r num">100</td> *@
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="modal-footer">
                @* 
				<button type="button"
						class="btn btn-primary btn-sm"
						id="btnSave">

					<svg width="14"

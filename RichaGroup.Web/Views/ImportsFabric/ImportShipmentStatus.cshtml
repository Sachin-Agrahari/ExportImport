@section Scripts {
	<script>
		$(function () {

			// ---------- DUMMY DATA ----------
			const dummyHeader = {
				entryNo: "225",
				entryDate: "15-05-2025",
				piNo: "JD25040701",
				styleNo: "WJT331651,WJT331651W,WJT331652,WJT331653",
				piQty: "3150",
				unit: "RC225",
				company: "RICHACO EXPORTS PRIVATE LIMITED",
				merchant: "MANJU/AJEET KUMAR SINGH",
				buyer: "J-JILL INC., LTD.",
				supplier: "SHAOXING KEQIAO JIEDA IMPORT AND EXPORT CO.",
				garmentDesc: "JACKET"
			};

			const base = {
				pino: "JD2504070", po: "PI25-4", supplier: "SHAOXING KEQIAO JIEDA",
				buyer: "JACKET", desc: "100% BCI COTTON", gsm: 220, gsmTo: 0, wid: 54, fw: 56,
				process: "DYED", segment: "Woven", shpdQty: 0, piFm: "", mode: "SEA",
				exMill: "15-05-2025", etdRemarks: "", etd: "", terms: "FOB",
				pmt: "90 DAYS FROM BOE", licStatus: "HOLD", licNo: "",
				docsStatus: "", finalStatus: "SAMPLE RCVD", finalDt: "", goodsInHouse: "", remarks: ""
			};

			const dummyRows = [
				{ ...base, invoice: "INV-1001", style: "WJT331651",  apldQty: 3150, cha: "LINKERS", fwd: "NA" },
				{ ...base, invoice: "INV-1002", style: "WJT331651",  apldQty: 1432, cha: "L", fwd: "CONTINENTAL" },
				{ ...base, invoice: "INV-1003", style: "WJT331651W", apldQty: 674,  cha: "LINKERS", fwd: "NA" },
				{ ...base, invoice: "INV-1004", style: "WJT331652",  apldQty: 710,  cha: "L", fwd: "CONTINENTAL" },
				{ ...base, invoice: "INV-1005", style: "WJT331653",  apldQty: 334,  cha: "L", fwd: "CONTINENTAL" }
			];

			// ---------- COLUMNS ----------
			const cols = [
				{ key: "pino" }, { key: "po" }, { key: "supplier" }, { key: "invoice" },
				{ key: "buyer" }, { key: "style" }, { key: "desc" },
				{ key: "gsm", num: true }, { key: "gsmTo", num: true },
				{ key: "wid", num: true }, { key: "fw", num: true },
				{ key: "process" }, { key: "segment" },
				{ key: "apldQty", num: true }, { key: "shpdQty", num: true },
				{ key: "piFm" }, { key: "mode" }, { key: "exMill" },
				{ key: "etdRemarks" }, { key: "etd" }, { key: "terms" },
				{ key: "pmt" }, { key: "licStatus" }, { key: "licNo" },
				{ key: "cha" }, { key: "fwd" }, { key: "docsStatus" },
				{ key: "finalStatus" }, { key: "finalDt" },
				{ key: "goodsInHouse" }, { key: "remarks" }
			];

			const FIRST_DATA_COL = 2; // 0 = Action, 1 = Sr No
			const EditBtn = `<button type="button" class="row-btn edit-btn btnEditRow" title="Edit">✎</button>`;

			// modal input id: "#txt" + key.toLowerCase()  (txtgsmTo -> txtgsmto bhi chalega kyunki id exact match chahiye, isliye map banaya)
			const modalIds = {
				pino: "txtpino", po: "txtpo", supplier: "txtsupplier", invoice: "txtinvoice",
				buyer: "txtbuyer", style: "txtstyle", desc: "txtdesc", gsm: "txtgsm",
				gsmTo: "txtgsmTo", wid: "txtwid", fw: "txtfw", process: "txtprocess",
				segment: "txtsegment", apldQty: "txtapldQty", shpdQty: "txtshpdQty",
				piFm: "txtpiFm", mode: "txtmode", exMill: "txtexMill",
				etdRemarks: "txtetdRemarks", etd: "txtetd", terms: "txtterms",
				pmt: "txtpmt", licStatus: "txtlicStatus", licNo: "txtlicNo",
				cha: "txtcha", fwd: "txtfwd", docsStatus: "txtdocsStatus",
				finalStatus: "txtfinalStatus", finalDt: "txtfinalDt",
				goodsInHouse: "txtgoodsInHouse", remarks: "txtremarks"
			};

			let editTr = null; // null => Add mode, otherwise Edit mode

			// ---------- HELPERS ----------
			function cell(c, r) {
				const v = r[c.key] ?? "";
				const cls = `c-${c.key}` + (c.num ? " r num" : "");
				return `<span class="${cls}">${v}</span>`;
			}

			function rowToCells(r) {
				return [EditBtn, ""].concat(cols.map(c => cell(c, r)));
			}

			function readModal() {
				const row = {};
				cols.forEach(c => row[c.key] = $("#" + modalIds[c.key]).val());
				return row;
			}

			function fillModal(row) {
				cols.forEach(c => $("#" + modalIds[c.key]).val(row[c.key] ?? ""));
			}

			function readRow($tr) {
				const row = {};
				cols.forEach(c => row[c.key] = $tr.find(".c-" + c.key).text());
				return row;
			}

			// ---------- HEADER ----------
			function bindHeader(h) {
				$("#txtEntry").val(h.entryNo);
				$("#txtentryDt").val(h.entryDate);
				$("#txtPiNo").val(h.piNo);
				$("#txtStyleNo").val(h.styleNo);
				$("#txtPiQty").val(h.piQty);
				$("#txtUnit").val(h.unit);
				$("#txtCompany").val(h.company);
				$("#txtMerchant").val(h.merchant);
				$("#txtBuyer").val(h.buyer);
				$("#txtSupplier").val(h.supplier);
				$("#txtGarmentDesc").val(h.garmentDesc);
			}

			// ---------- DATATABLE ----------
			const numTargets = cols
				.map((c, i) => c.num ? i + FIRST_DATA_COL : -1)
				.filter(i => i >= 0);

			const dt = $("#tblDutyBillEntry").DataTable({
				paging: false,
				searching: false,
				info: false,
				ordering: false,
				scrollX: true,
				autoWidth: false,
				columnDefs: [{ targets: numTargets, className: "r num" }]
			});

			function renumber() {
				dt.rows().every(function (i) {
					$(this.node()).find("td:nth-child(2)").text(i + 1);
				});
			}

			function bindRows(rows) {
				dt.clear();
				rows.forEach(r => dt.row.add(rowToCells(r)));
				dt.draw();
				renumber();
			}

			// ---------- MODAL ----------
			const editModalEl = document.getElementById("modalBoeEdit");
			const editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);

			// ---------- FUNCTIONS (button handlers) ----------
			function openAddRow() {
				editTr = null;
				fillModal({});
				$("#modalBoeEditLabel").text("Add Import Bill Entry");
				editModal.show();
			}

			function openEditRow($btn) {
				editTr = $btn.closest("tr");
				fillModal(readRow(editTr));
				$("#modalBoeEditLabel").text("Edit Import Bill Entry");
				editModal.show();
			}

			function saveModalRow() {
				const row = readModal();

				if (editTr) {
					// EDIT
					cols.forEach(c => editTr.find(".c-" + c.key).text(row[c.key]));
				} else {
					// ADD
					dt.row.add(rowToCells(row)).draw(false);
					renumber();
				}

				editModal.hide();
				editTr = null;
			}

			function saveAll() {
				const data = [];
				dt.rows().every(function () {
					data.push(readRow($(this.node())));
				});
				console.log("Save payload:", data);
			}

			function refreshAll() {
				bindHeader(dummyHeader);
				bindRows(dummyRows);
			}

			function openDispatch() {
				$("#DispatchModal").modal("show");
			}

			function openEntryHelp() {
				$("#EntryNoModal").modal("show");
			}

			// ---------- EVENTS ----------
			$("#btnAddrow").on("click", openAddRow);

			$("#tblDutyBillEntry tbody").on("click", ".btnEditRow", function () {
				openEditRow($(this));
			});

			$("#btnOkBoeEdit").on("click", saveModalRow);
			$("#btnSave_BOEAgainstFabric").on("click", saveAll);
			$("#btnRefresh_BOEAgainstFabric").on("click", refreshAll);
			$("#btnDispatch").on("click", openDispatch);
			$("#btnEntryHelp").on("click", openEntryHelp);

			editModalEl.addEventListener("hidden.bs.modal", function () {
				editTr = null;
			});

			// ---------- INITIAL LOAD ----------
			refreshAll();
		});
	</script>
}
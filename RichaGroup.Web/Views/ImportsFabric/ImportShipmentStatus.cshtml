<div class="bd_mainContainer">

	<div class="page">

		<section class="card">
			<div class="card-head">
				<div>
					<span class="tick"></span>
					<h2 class="mt-2" id="txtHeaderMain">Import Shipment Status</h2>
				</div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnSave_BOEAgainstFabric"
                            title="Save">

						<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
							 stroke="currentColor" stroke-width="2"
							 stroke-linecap="round" stroke-linejoin="round">
							<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
							<polyline points="17 21 17 13 7 13 7 21"></polyline>
							<polyline points="7 3 7 8 15 8"></polyline>
						</svg>
						Save
					</button>
					<button type="button"
							class="btn btn-outline-danger btn-sm"
							id="btnRefresh_BOEAgainstFabric">
						↻ Refresh
					</button>
				</div>
			</div>

			<div class="card-body">

				<div class="grid cols-6">
					<div class="field">
						<label id="lb_Parties_location">
							Entry No
							<button id="btnEntryHelp" class="help-link">Help</button>
						</label>
						<input type="text" id="txtEntry" placeholder="Enter Entry Number.." />
					</div>
					
					<div class="field">
						<label>Entry Date</label>
						<input type="text" id="txtentryDt" class="form-Flatdate" placeholder="Select date.." />
					</div>
					<div class="field">
						<label>PI No</label>
						<input type="text" id="txtPiNo" placeholder="PI No" disabled />
					</div>
					<div class="field">
						<label>Style No</label>
						<input type="text" id="txtStyleNo" placeholder="Style No" disabled />
					</div>
					<div class="field">
						<label>PI Qty</label>
						<input type="text" id="txtPiQty" placeholder="PI Qty" class="r num" disabled />
					</div>
					<div class="field">
						<label>Unit</label>
						<input type="text" id="txtUnit" placeholder="Unit" disabled />
					</div>
					<div class="field">
						<label>Company</label>
						<input type="text" id="txtCompany" placeholder="Company" disabled />
					</div>
					<div class="field">
						<label>Merchant</label>
						<input type="text" id="txtMerchant" placeholder="Merchant" disabled />
					</div>
					<div class="field">

        <section class="card">
            <div class="card-head">

                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2">Commerical Invoice Details</h2>
                </div>
                 <div class="d-flex gap-2">
                    <span class="form-label mx-2" style="color: var(--clr-danger)">
                        Total Qty : <b id="ciTotalQtyDisplay">4025</b>&nbsp;&nbsp;
                        Total Amount : <b id="ciTotalAmtDisplay">6295.0000</b>
                    </span>

                    <button class="btn btn-primary btn-sm" id="btnExecute">
                        Execute
                    </button>

                    @{
                        if (isFabric)
                        {
                            <button class="btn btn-outline btn-sm" id="btnQtyAllocate">
                                Qty Allocate
                            </button>
                        }
                    }

                    <button class="btn btn-outline-danger btn-sm px-3" id="btnRefresh">
                        Refresh
                    </button>

                    </div>


            </div>
            <div class="card-body">
                <div class="table-wrap">
                    <table id="tblCommericalInv" class="table-component">
                        <thead>
                            <tr>
                                <th class="td-check">
                                    <input type="checkbox" id="selectAll">
                                </th>

                                <th>PI No</th>
                                <th>PO No</th>
                                <th>Item</th>
                                <th>ItemDesc</th>
                                @{
                                    if (isFabric)
                                    {
                                        <th>Quality</th>
                                    }
                                    else
                                    {
                                        <th>Size</th>
                                    }
                                }
                                <th>Colour</th>
                                <th class="td-number">Qty</th>
                                <th class="td-number">Rate</th>
                                <th>PI/UOM</th>
                                <th>CI/UOM</th>
                                <th>Amount</th>
                                <th>Curr</th> 
                                <th class="td-number">RtType</th>
                                <th>Req No</th>
                                <th>Buyer</th>
                                <th>Style</th> 
                                <th>ItSuplr</th> 
                                <th>Curr</th>
                                <th class="td-number">Amount</th>
                                <th class="td-number">Others</th> 
                                <th>CIUOM</th>
                                <th>CONV</th>
                                <th>ACQTY</th> 
                                <th>S_ITEMCODE</th>
                                <th>Process</th>
                                <th>Width</th>
                                <th>Fin Width</th>
                                <th>GSM From</th>
                                <th>GSM To</th>
                            </tr>
                        </thead>
                        <tbody id="tblBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-head">
                <div class="d-flex flex-row " style="width: 163px;">

                    <h2 class="mt-2" id="txtHeaderMain">Total And Changes</h2>
                </div>

                <div class="d-flex gap-2">

                    <button class="btn btn-secondary btn-sm" id="bthOtherCharges">Other Charges</button>
                </div>
            </div>
            <div class="card-body">
                <div class="grid cols-10">
                    <div class="field">
                        <label class="form-label">Total Amount</label>
                        <input type="text" id="ciTotalAmount" class="form-control" value="5796.0000" readonly />

                    </div>
                    <div class="field">
                        <label class="form-label">Net Amount</label>
                        <input type="text" id="ciNetAmount" class="form-input" value="5796.00" readonly />

                    </div>
                    <div class="field">
                        <label class="form-label">Currency</label>
                            <select id="ciCurrency" class="form-select">
                                <option value="US$" selected>US$</option>
                                <option value="INR">INR</option>
                                <option value="EUR">EUR</option>
                            </select>
                    </div>
                    <div class="field">
                            <label class="form-label">Calculation(+/-)</label>
                            <select id="ciPlusMinus" class="form-select">
                                <option value="+" selected>+</option>
                                <option value="-">-</option>
                            </select>
                    </div>
                    <div class="field">
                        <label class="form-label">Amount (+/-)</label>
                        <input type="text" id="ciPlusMinusAmt" class="form-control" value="0.0000" />
                    </div>
                    <div class="field">
                        <label class="form-label">Oth. Charges</label>
                        <input type="text" id="ciOthCharges" class="form-input" value="6.8000" />
                    </div>
                    <div class="field">
                        <label class="form-label">Ded.</label>
                        <input type="text" id="ciDeduction" class="form-control" value="0.0000" />
                    </div>
                    <div class="field">
                        <label class="form-label">Disc. (if any)</label>
                        <input type="text" id="ciDiscount" class="form-control" value="0.0000" />
                    </div>
                    <div class="field">
                        <label class="form-label">Amt to be Paid</label>
                        <input type="text" id="ciAmountToBePaid" class="form-control" value="5802.80" readonly />
                    </div>
                    <div class="field">
                        <label class="form-label">Currency</label>
                        <select id="ciCurrency2" class="form-select">
                            <option value="US$" selected>US$</option>
                            <option value="INR">INR</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                 </div>
             </div>
        </section>
    

    </div>
</div>


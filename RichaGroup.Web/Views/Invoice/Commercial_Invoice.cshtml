                        {
                            @* HOUSE: HAWB / HBL / AWB *@
                            <div class="field">
                                <label class="form-label lblHouse" data-index="@i">HAWB-@i</label>
                                <input type="text" id="txtHouse@(i)" class="form-control" value="" />
                            </div>
                            <div class="field">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1 ms-1">
                                    <label class="form-label mb-0 pe-3 ms-2">Dt</label>
                                    <input type="checkbox" id="chkHouse@(i)Dt" />
                                </div>
                                <input type="text" id="txtHouse@(i)Dt" class="form-input form-Flatdate" placeholder="07-Jul-2025" />
                            </div>

                            @* MASTER: MAWB / MBL *@
                            <div class="field">
                                <label class="form-label lblMaster" data-index="@i">MAWB-@i</label>
                                <input type="text" id="txtMaster@(i)" class="form-control" value="" />
                            </div>
                            <div class="field">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1 ms-1">
                                    <label class="form-label mb-0 pe-3 ms-2">Dt</label>
                                    <input type="checkbox" id="chkMaster@(i)Dt" />
                                </div>
                                <input type="text" id="txtMaster@(i)Dt" class="form-input form-Flatdate" placeholder="07-Jul-2025" />
                            </div>
                        }

                    </div>
                </div>
            </section>

            <section class="card w-100">
                <div class="card-head">

                    <div>
                        <span class="tick"></span>
                        <h2 class="mt-2">Shipment Reference</h2>
                    </div>
                </div>
                <div class="card-body">
                    <div class="grid cols-5">
                        <div class="field">
                            <label class="form-label">Bond / Duty</label>
                            <select onchange="ManageShipmentReference()" id="ddlBond_Duty" class="form-select">
                                <option value="BOND">BOND</option>
                                <option value="DUTY">DUTY</option>
                            </select>
                        </div>


                        <div class="field">
                            <label class="form-label">Certificate#</label>
                            <input type="text" id="ciCertificateNo" class="form-control manageShipment" value="06AALCR4331D1ZM2526004" />
                        </div>
                        <div class="field">
                            <label class="form-label">BOE #</label>
                            <input type="text" id="ciBoeNo" class="form-control manageShipment" value="3135664" />
                        </div>
                        <div class="field">
                            <div class="col-2">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1 ms-1">

                                    <label class="form-label mb-0 pe-3 ms-2">
                                        Dt
                                    </label>
                                    <input type="checkbox" id="ciCheckboxBoeDt" class="manageShipment" />

                                </div>
                            </div>
                            <input type="text" id="ciBoeDt" class="form-input form-Flatdate manageShipment" placeholder="07-Jul-2025" />
                        </div>

                        <div class="field">
                            <label class="form-label">Bond Value in (INR)</label>
                            <input type="text" id="ciBondValue" class="form-control manageShipment" value="147546" />
                        </div>
                        <div class="field">
                            <label class="form-label">Port of Loading</label>
                            <select id="ciPortOfLoading" class="form-select manageShipment">
                                <option value="HONG KONG" selected>HONG KONG</option>
                            </select>
                        </div>
                       
                        <div class="field">
                            <label class="form-label">Bond #</label>
                            <input type="text" id="ciBondNo" class="form-control manageShipment" value="2002444129" />
                        </div>
                        <div class="field">
                            <div class="col-2">
                                <div class="d-flex align-items-center justify-content-center gap-1 mb-1 ms-1">

                                    <label class="form-label mb-0 pe-3 ms-2">
                                        Dt
                                    </label>
                                    <input type="checkbox" id="ciCheckboxBondDt" class="manageShipment" />

                                </div>
                            </div>
                            <input type="text" id="ciBondDt" class="form-input form-Flatdate manageShipment" placeholder="07-Jul-2025" />
                        </div>
                        <div class="field">
                            <label class="form-label">Assessable Value</label>
                            <input type="text" id="ciAssessableValue" class="form-control manageShipment" value="638726" />
                        </div>
                        <div class="field">
                            <label class="form-label">Port of Destination</label>
                            <select id="ciPortOfDestination" class="form-select manageShipment">
                                <option value="NEW DELHI" selected>NEW DELHI</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="form-label">Custom STN : Port</label>
                            <select id="ciCustomStnPort" class="form-select manageShipment">
                                <option value="INDEL4" selected>INDEL4</option>
                            </select>
                        </div>
                        <div class="field">

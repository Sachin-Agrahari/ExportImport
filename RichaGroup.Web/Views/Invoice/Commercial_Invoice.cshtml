                        </select>
                    </div>
                    <div class="field">
                        <div class="col-2">
                            <div class="d-flex align-items-center justify-content-center gap-1 mb-1 ms-3">

                                <label class="form-label mb-0 pe-4">
                                   Size <span class="text-danger" style="color:red !important;">*</span>
                                </label>
                                <input type="checkbox" id="chkSize" class="" />

                            </div>
                        </div>
                        <select id="ddlSize" class="form-select">
                            <option value="EX WORKS" selected>EX WOI</option>
                            <option value="FOB">FOB</option>

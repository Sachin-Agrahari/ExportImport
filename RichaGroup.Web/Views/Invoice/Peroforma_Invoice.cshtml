                                        <select id="ddlChargesCurrency" class="table-input performance-currency-select">
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td>1</td>
                                    <td>
                                        <select id="ddlCharges" class="table-input performance-currency-select">
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                            <option value="">select</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" id="txtCharges"/>
                                    </td>
                                    <td>
                                        <select id="ddlChargesCurrency" class="table-input performance-currency-select">
                                            <option value="">select</option>

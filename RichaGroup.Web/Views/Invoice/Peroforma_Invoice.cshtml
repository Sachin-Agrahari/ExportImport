                <div class="modal-header-text">
                    <div class="modal-title" id="otherChargesModalLabel">
                        Other Charges
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">

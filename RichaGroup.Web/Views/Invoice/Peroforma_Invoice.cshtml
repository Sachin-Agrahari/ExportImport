                                        </select>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>
 
<div class="modal fade" id="confirmChecklistModal" tabindex="-1" aria-labelledby="confirmChecklistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="confirmChecklistModalLabel">
                        Confirm Checklist
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-bordered mb-0" id="tblPIChecklist">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Checklist</th> 
                                <th>Responsible Person</th>
                                <th>Target Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="tblPIChecklistBody">
                            <!-- Rows injected by JavaScript -->
                        </tbody>

                    </table>
                     
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"

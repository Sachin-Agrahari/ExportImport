                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>
 
<div class="modal fade" id="confirmFabricContentModal" tabindex="-1" aria-labelledby="confirmFabricContentModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="confirmFabricContentModal">
                        Fabric Content
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button" class="btn btn-outline" id="btnFabricAddRow">
                        Add Row
                    </button>
                    <button type="button" class="btn btn-outline" id="btnFabricRemoveRow">
                        Remove
                    </button>

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
               
                <div class="table-responsive"> 
                    <table id="tblPiAttachment" class="table table-bordered table-sm align-middle mb-0">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Fabric Content</th>
                                <th>Process</th>
                                <th class="r num">Width</th>
                                <th class="r num">Final Width</th>
                                <th class="r num">GSM Start</th>
                                <th class="r num">GSM End</th>
                                <th class="r num">Qty</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                            </tr>
                        </thead>

                        <tbody id="fabricTbody"> </tbody>

                    </table> 
                </div> 

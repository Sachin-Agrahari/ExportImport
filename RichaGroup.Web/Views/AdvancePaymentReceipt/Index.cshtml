          <button class="modal-close" onclick="closeModal('m-adv')" aria-label="Close">&#10005;</button></div>
        <div class="modal-body">
          <div class="table-wrap">
            <table style="min-width:780px">
              <thead><tr><th class="r">Adv</th><th>Date</th><th>Buyer Code</th><th>Buyer Name</th><th>Cur.</th><th class="r">Cnv. Rate</th><th class="r">Amount</th></tr></thead>
              <tbody>
                <tr><td class="r num">6733</td><td>09-09-2025</td><td class="mono">2058</td><td>J.Crew Group, LLC</td><td>US$</td><td class="r num">88.04000</td><td class="r num">7,606.68</td></tr>
                <tr><td class="r num">6734</td><td>09-09-2025</td><td class="mono">ANN</td><td>Abfico Netherlands Distribution B.V.</td><td>US$</td><td class="r num">88.04000</td><td class="r num">4,88,763.05</td></tr>
                <tr><td class="r num">6735</td><td>10-09-2025</td><td class="mono">MACY</td><td>Abercrombie &amp; Fitch Trading</td><td>US$</td><td class="r num">88.04000</td><td class="r num">5,60,646.88</td></tr>
                <tr><td class="r num">6736</td><td>10-09-2025</td><td class="mono">ANF</td><td>Abercrombie &amp; Fitch Trading</td><td>US$</td><td class="r num">88.04000</td><td class="r num">26,986.88</td></tr>
                <tr><td class="r num">6737</td><td>10-09-2025</td><td class="mono">ANF</td><td>Abercrombie &amp; Fitch Trading</td><td>US$</td><td class="r num">88.04000</td><td class="r num">3,17,957.78</td></tr>
                <tr><td class="r num">6738</td><td>15-09-2025</td><td class="mono">6048</td><td>Abercrombie &amp; Fitch Trading</td><td>US$</td><td class="r num">88.04000</td><td class="r num">267.62</td></tr>

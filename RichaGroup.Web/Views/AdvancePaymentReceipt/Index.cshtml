@{
    ViewData["Title"] = "Advance Payment Receipt";
    ViewData["Heading"] = "Advance Payment Receipt"; 
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/advance-payment-receipt.css" asp-append-version="true">
}


<!-- ════════ Receipt details / filters ════════ -->
<section class="card">
    <div class="card-head">
        <div>
            <span class="tick"></span>
            <h2 class="mt-2" id="txtHeaderMain">Advance Payment</h2>
        </div>


        <div class="d-flex gap-2">
            <div class="d-flex gap-2">
                @await Html.PartialAsync("Components/_CheckBoxComponent")
                @await Html.PartialAsync("Components/_UploadAndViewButtons")
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave"
                        title="Save">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>

                <button type="button"
                        class="btn btn-cancel-custom"
                        id="btnCancel">
                    ✕ Cancel
                </button>
 
            </div>
        </div>
    </div>
  <div class="card-body">
    <div class="grid cols-6">
      <div class="field"><label>Advance <button class="help-link" onclick="openModal('m-adv')">Help</button></label><input placeholder="&mdash;"></div>
      <div class="field"><label>Date</label><input type="text" class="form-Flatdate"></div>
      <div class="field"><label>Buyer</label><input placeholder="&mdash;"></div>
      <div class="field"><label>Amount</label><input class="num" placeholder="0.00"></div>
      <div class="field"><label>IRM Number</label><input placeholder="&mdash;"></div>
      <div class="field"><label>IRM Date</label><input type="text" class="form-Flatdate"></div>

      <div class="field"><label>Currency <button class="help-link" onclick="openModal('m-pending')">Bookings</button></label><input placeholder="&mdash;"></div>
      <div class="field"><label>Credit Advice No</label><input placeholder="&mdash;"></div>
      <div class="field"><label>Advice Date</label><input type="text" class="form-Flatdate"></div>
      <div class="field"><label>Avg. Rate</label><input class="num" placeholder="0.00000"></div>
      <div class="field"><label>Payment Against Export</label><select><option selected>Complete</option><option>Partial</option></select></div>
      <div class="field"><label>Option</label><select><option selected>Choose&hellip;</option></select></div>

      <div class="field"><label>Amount INR</label><input class="num" placeholder="0.00"></div>
      <div class="field"><label>Invoice Dtl <button class="help-link" onclick="openModal('m-tagged')">Help</button></label><input placeholder="&mdash;"></div>
      <div class="field"><label>BOE Adjust</label><input class="num" placeholder="0.00"></div>
      <div class="field"><label>Balance Amount</label><input class="num" placeholder="0.00"></div>
      <div class="field"><label>Bank</label><select><option selected>Complete</option></select></div>
			<div class="field" style="align-self:end"><button class="btn btn-primary btn-sm">Filter</button></div>
    </div>
  </div>
</section>

<!-- ════════ Receipt lines ════════ -->
<section class="card">
  <div class="card-head"><span class="tick"></span><h2>Receipt Lines</h2><span class="hint">TT-wise conversion &amp; adjustments</span></div>
  <div class="card-body">
    <div class="table-wrap">
      <table style="min-width:1250px">
        <thead>
          <tr class="groups">
            <th colspan="8"></th>
            <th colspan="2" class="gline">Received</th>
            <th colspan="2" class="gline">Manual Adjustment</th>
            <th colspan="2" class="gline">Extra Adjustment</th>
          </tr>
          <tr>
            <th class="c">#</th><th class="r">Cnv. Rate</th><th class="r">Amount</th><th>TT Number</th>
            <th class="c">Y</th><th class="c">FW</th><th class="r">TRW</th><th></th>
            <th class="r">Amount</th><th>Date</th>
            <th>Date</th><th class="r">Amount</th>
            <th>Date</th><th class="r">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="c">1</td><td><input class="num" value="0.00000"></td><td><input class="num" value="0.00"></td><td><input placeholder="&mdash;"></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td><input class="num" value="0"></td><td></td>
            <td><input class="num" value="0.00"></td><td><input type="text" class="form-Flatdate"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
          </tr>
          <tr>
            <td class="c">2</td><td><input class="num" value="0.00000"></td><td><input class="num" value="0.00"></td><td><input placeholder="&mdash;"></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td><input class="num" value="0"></td><td></td>
            <td><input class="num" value="0.00"></td><td><input type="text" class="form-Flatdate"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
          </tr>
          <tr>
            <td class="c">3</td><td><input class="num" value="0.00000"></td><td><input class="num" value="0.00"></td><td><input placeholder="&mdash;"></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td><input class="num" value="0"></td><td></td>
            <td><input class="num" value="0.00"></td><td><input type="text" class="form-Flatdate"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
          </tr>
          <tr>
            <td class="c">4</td><td><input class="num" value="0.00000"></td><td><input class="num" value="0.00"></td><td><input placeholder="&mdash;"></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td class="c"><div class="yn" data-flag><button class="on-y">Y</button><button>N</button></div></td>
            <td><input class="num" value="0"></td><td></td>
            <td><input class="num" value="0.00"></td><td><input type="text" class="form-Flatdate"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
            <td><input type="text" class="form-Flatdate"></td><td><input class="num" value="0.00"></td>
          </tr>
        </tbody>
      </table>
    </div>  

    <div class="summary">
      <div class="sum-tile"><div class="lbl">Advance Received</div><b>0.00</b></div>
      <div class="sum-tile"><div class="lbl">Tagged Invoice</div><b>0.00</b></div>
      <div class="sum-tile accent"><div class="lbl">Extra Amount</div><b>0.00</b></div>
    </div>
  </div>
</section>
 
@section Modals {
    <!-- ══════════ MODAL &middot; Advance Received Help ══════════ -->

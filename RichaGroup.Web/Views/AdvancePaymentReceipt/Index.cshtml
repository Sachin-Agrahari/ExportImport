                <tr><td class="c">3</td><td>&mdash;</td><td class="r num">0.00</td></tr>
                <tr><td class="c">4</td><td>&mdash;</td><td class="r num">0.00</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-foot"><button class="btn btn-primary" onclick="closeModal('m-tagged')">Done</button></div>
      </div>
    </div>
}

@section Scripts {
    <script src="~/js/pages/advance-payment-receipt.js" asp-append-version="true"></script>
}

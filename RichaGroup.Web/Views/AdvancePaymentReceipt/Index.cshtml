    <!-- ══════════ MODAL &middot; Tagged Invoices ══════════ -->
    <div class="overlay" id="m-tagged" role="dialog" aria-modal="true" aria-label="Tagged invoices">
      <div class="modal sm">
        <div class="modal-head"><span class="tick"></span><h3>Tagged Invoices</h3>
          <button class="modal-close" onclick="closeModal('m-tagged')" aria-label="Close">&#10005;</button></div>
        <div class="modal-body">
          <div class="table-wrap">

@{
    ViewData["Title"] = "Party Master";
    ViewData["Heading"] = "Party Master";
}

<link href="~/css/pages/masternew/partymaster.css" rel="stylesheet" />

<div class="bd_mainContainer">
    <div class="page">
        
        <div class="card boe-tabbar">
            <div class="card-head">
                <div class="screen-switch" role="tablist" aria-label="Views">
                     
                    <button type="button" class="party-type-btn on" data-view="Buyer">
                        <input type="checkbox" checked value="Buyer" />
                        Buyer
                    </button>
 
                    <button type="button" class="party-type-btn" data-view="Consignee">
                        <input type="checkbox" value="Consignee" />
                        Consignee
                    </button>

                    <button type="button" class="party-type-btn" data-view="Forworder">
                        <input type="checkbox" value="Forworder" />
                        Forworder
                    </button>

                    <button type="button" class="party-type-btn" data-view="CHA">
                        <input type="checkbox" value="CHA" />
                        CHA
                    </button>

                    <button type="button" class="party-type-btn" data-view="Notify">
                        <input type="checkbox" value="Notify" />
                        Notify
                    </button>

                    <button type="button" class="party-type-btn" data-view="Transporter">
                        <input type="checkbox" value="Transporter" />
                        Transporter
                    </button>

                    <button type="button" class="party-type-btn" data-view="Supplier">
                        <input type="checkbox" value="Supplier" />
                        Supplier
                    </button>

                </div>
            </div>
        </div>

        <div class="card">

            <div class="card-head">
                <div>
                    <span class="tick"></span>
                    <h2 class="mt-2" id="txtHeaderMain">Party Master</h2>
                </div>

                <div class="d-flex gap-2">
                    @await Html.PartialAsync("Components/_CheckBoxComponent")
                    @await Html.PartialAsync("Components/_UploadAndViewButtons")
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            id="btnAdd">
                        ＋ Add
                    </button>
                </div>
            </div>
             

            <div class="card-body">
               
                <div class="table-responsive mt-3">

                    <table class="table table-hover align-middle table-bordered mb-0" id="tblPartyMaster">

                        <thead class="table-light">
                            <tr>
                                <th style="width:80px;">Action</th>
                                <th style="width:70px;">Code</th>
                                <th>Buyer Name</th>
                                <th>Notify Name</th>
                                <th>City</th>
                                <th>State</th>
                                <th>Country</th>
                                <th>Email</th>
                                <th>Port</th>  
                            </tr>
                        </thead>

                        <tbody id="tblPartyMasterBody">
                            <!-- Rows generated by JavaScript -->
                        </tbody>

                    </table>

                    <div id="noRecordsFound" class="text-center text-muted py-4 d-none">
                        No matching records found.
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

<!-- ================================
     Add Menu Modal
================================ -->

<div class="modal fade" id="addMenuModal" tabindex="-1" aria-labelledby="addMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xxl">
        <div class="modal-content modal-box">
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="addMenuModalLabel">
                        Party Master
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body p-2">
                @await Html.PartialAsync("_PartyMaster")
            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-primary btn-sm" id="btnExpenssSetup">
                    Expenss Setup
                </button> 

                <button type="button" class="btn btn-primary btn-sm d-none" id="btnAddWhareHouse">
                    + Add Wharehouse
                </button>

                <button type="button" class="btn btn-primary btn-sm d-none" id="btnDiscountDtls">
                     Discount Details
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSave">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>

@await Html.PartialAsync("_DiscountDetail")
@await Html.PartialAsync("_ExpenssSetup")
@await Html.PartialAsync("_WareHouse")

<script src="~/js/pages/MastersJs/PartyMaster.js" asp-append-version="true"></script>
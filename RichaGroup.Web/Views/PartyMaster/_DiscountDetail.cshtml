<div class="modal fade" id="DiscountDetailModal" tabindex="-1" aria-labelledby="DiscountDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content modal-box">
           
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="DiscountDetailModalLabel">
                        Discount Details
                    </div>
                </div>
                <div class="d-flex gap-2">

                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="modal-body px-2">
                <div class="grid cols-2">
                             
                    <div class="field">
                        <label for="txtDiscountPercent" class="form-label">Discount %</label>
                        <input type="text" id="txtDiscountPercent" placeholder="Enter Discount %" />
                    </div>
                     
                    <div class="field">
                        <label for="txtNoOfDays" class="form-label">No. Of Days</label>
                        <input type="number" id="txtNoOfDays" placeholder="Enter No. Of Days" />
                    </div>
                     
                    <div class="field">
                        <label for="txtCompanyCode" class="form-label">Company Code</label>
                        <input type="text" id="txtCompanyCode" placeholder="Enter Company Code" />
                    </div>
                     
                    <div class="field">
                        <label for="txtDiscountFrom" class="form-label">Discount From</label>
                        <input type="text" id="txtDiscountFrom" class="form-Flatdate" />
                    </div>
                     
                    <div class="field">
                        <label for="txtDiscountTo" class="form-label">Discount To</label>
                        <input type="text" id="txtDiscountTo" class="form-Flatdate" />
                    </div>
                     
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveDiscount">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>

                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>
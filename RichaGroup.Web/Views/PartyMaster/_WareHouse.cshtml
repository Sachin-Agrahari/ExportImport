 
<div class="modal fade" id="AddWarehouseModal" tabindex="-1" aria-labelledby="AddWarehouseModalLabel" aria-hidden="true"> 
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content modal-box">

            <!-- Modal Header -->
            <div class="modal-header">
                <div class="modal-header-text">
                    <div class="modal-title" id="AddWarehouseModalLabel">
                        Add Warehouse
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                        <svg viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body px-3">
                <div class="grid cols-1">

                    <!-- Code -->
                    <div class="field">
                        <label for="txtWarehouseCode"
                               class="form-label">
                            Code
                        </label>
                        <input type="text" id="txtWarehouseCode" placeholder="Enter Warehouse Code" />
                    </div>

                    <!-- Name -->
                    <div class="field">
                        <label for="txtWarehouseName"
                               class="form-label">
                            Name
                        </label>
                        <input type="text" id="txtWarehouseName" placeholder="Enter Warehouse Name" />
                    </div>

                    <!-- Party Dropdown -->
                    <div class="field">
                        <label for="ddlWarehouseParty"
                               class="form-label">
                            Party
                        </label>
                        <select id="ddlWarehouseParty"
                                class="form-select">
                            <option value="">Select Party</option>
                        </select>
                    </div>

                    <!-- Address -->
                    <div class="field">
                        <label for="txtWarehouseAddress"
                               class="form-label">
                            Address
                        </label>
                        <textarea id="txtWarehouseAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter Address"></textarea>
                    </div>

                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnSaveWarehouse">

                    <svg width="14"
                         height="14"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>

                    Save
                </button>
            </div>

        </div>
    </div>
</div>
 